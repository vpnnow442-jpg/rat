      <Item class="ModuleScript" referent="RBXF8163373C32545428BC11BC516C6C174">
        <Properties><string name="Name">LobbyService</string><ProtectedString name="Source"><![CDATA[-- Menus, parties and who's actually playing.
--
-- Public server : you open the menu, press PLAY, and join the next round.
--                 Roblox's own server filling keeps public servers topped up.
-- Party server  : a private (reserved) server with a 5-letter room code.
--                 Friends join with the code or an in-game invite.
--                 The host presses START; after a match everyone returns
--                 to the party screen for a rematch.
--
-- Teleports and private servers only work in a PUBLISHED game.
-- In Studio these return a friendly error instead of failing silently.

local MemoryStoreService = game:GetService("MemoryStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage.Shared
local Characters = require(Shared.Characters)
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local PlayerService = require(script.Parent.PlayerService)

local LobbyState = Net.event("LobbyState")
local LobbyFn = Net.func("Lobby")

local LobbyService = {}

LobbyService.mode = "public" -- "public" | "party"
LobbyService.code = nil :: string?
LobbyService.hostId = nil :: number?
LobbyService.inMatch = false

-- Set by MatchService so the lobby knows who is mid-race
LobbyService.isRacing = function(_player: Player): boolean
	return false
end

local queued = {} :: { [Player]: boolean }
local partyStarted = false
local joinOrder = {} :: { Player }
local lastAction = {} :: { [Player]: number }

local CODE_CHARS = "ABCDEFGHJKMNPQRSTUVWXYZ23456789" -- no 0/O, 1/I/L
local CODE_TTL = 6 * 60 * 60

local codes: MemoryStoreSortedMap? = nil
pcall(function()
	codes = MemoryStoreService:GetSortedMap("PartyCodes")
end)

local function isReservedServer(): boolean
	return game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
end

--------------------------------------------------------------------------
-- State
--------------------------------------------------------------------------

function LobbyService.participants(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if LobbyService.mode == "party" or queued[p] then
			table.insert(list, p)
		end
	end
	return list
end

function LobbyService.ready(): boolean
	if LobbyService.mode == "party" then
		return partyStarted and #Players:GetPlayers() >= 1
	end
	return #LobbyService.participants() >= Config.Match.MinPlayers
end

function LobbyService.broadcast()
	local members = {}
	for _, p in joinOrder do
		if p.Parent then
			table.insert(members, {
				userId = p.UserId,
				name = p.DisplayName,
				species = PlayerService.species[p],
				queued = queued[p] == true,
			})
		end
	end
	LobbyState:FireAllClients({
		mode = LobbyService.mode,
		code = LobbyService.code,
		hostId = LobbyService.hostId,
		inMatch = LobbyService.inMatch,
		members = members,
	})
end

function LobbyService.matchStarted()
	LobbyService.inMatch = true
	LobbyService.broadcast()
end

function LobbyService.matchEnded()
	LobbyService.inMatch = false
	if LobbyService.mode == "party" then
		partyStarted = false
	end
	LobbyService.broadcast()
end

--------------------------------------------------------------------------
-- Teleports
--------------------------------------------------------------------------

local function newCode(): string
	local chars = {}
	for i = 1, 5 do
		local n = math.random(1, #CODE_CHARS)
		chars[i] = CODE_CHARS:sub(n, n)
	end
	return table.concat(chars)
end

local function teleportTo(player: Player, access: string, code: string, host: number?)
	local options = Instance.new("TeleportOptions")
	options.ReservedServerAccessCode = access
	options:SetTeleportData({ code = code, host = host })
	TeleportService:TeleportAsync(game.PlaceId, { player }, options)
end

local NOT_PUBLISHED = "Parties work once the game is published (not in Studio)."

local function createParty(player: Player)
	if RunService:IsStudio() or game.PlaceId == 0 or not codes then
		return { ok = false, err = NOT_PUBLISHED }
	end
	local ok, err = pcall(function()
		local store = codes :: MemoryStoreSortedMap
		local code = newCode()
		for _ = 1, 5 do
			if store:GetAsync(code) == nil then
				break
			end
			code = newCode()
		end
		local access = TeleportService:ReserveServer(game.PlaceId)
		store:SetAsync(code, access, CODE_TTL)
		teleportTo(player, access, code, player.UserId)
	end)
	if not ok then
		warn("[Lobby] create failed:", err)
		return { ok = false, err = "Couldn't create a party. Try again in a moment." }
	end
	return { ok = true }
end

local function joinParty(player: Player, code: any)
	if typeof(code) ~= "string" then
		return { ok = false, err = "Enter a 5-letter code" }
	end
	code = code:upper():gsub("[^%w]", "")
	if #code ~= 5 then
		return { ok = false, err = "Codes are 5 letters" }
	end
	if code == LobbyService.code then
		return { ok = false, err = "You're already in this party" }
	end
	if RunService:IsStudio() or game.PlaceId == 0 or not codes then
		return { ok = false, err = NOT_PUBLISHED }
	end
	local access: string? = nil
	local ok = pcall(function()
		access = (codes :: MemoryStoreSortedMap):GetAsync(code)
	end)
	if not ok then
		return { ok = false, err = "Couldn't look up that code. Try again." }
	end
	if not access then
		return { ok = false, err = "No party with that code" }
	end
	local tok, terr = pcall(teleportTo, player, access :: string, code, nil)
	if not tok then
		warn("[Lobby] join failed:", terr)
		return { ok = false, err = "Couldn't join. Try again." }
	end
	return { ok = true }
end

local function leaveParty(player: Player)
	if LobbyService.mode ~= "party" then
		return { ok = false, err = "You're not in a party" }
	end
	local ok = pcall(function()
		TeleportService:TeleportAsync(game.PlaceId, { player })
	end)
	return if ok then { ok = true } else { ok = false, err = "Couldn't leave right now" }
end

--------------------------------------------------------------------------
-- Actions from the menu
--------------------------------------------------------------------------

local function onInvoke(player: Player, action: any, arg: any)
	local now = os.clock()
	if now - (lastAction[player] or 0) < 0.4 then
		return { ok = false, err = "Slow down" }
	end
	lastAction[player] = now

	if action == "play" then
		if LobbyService.mode ~= "public" then
			return { ok = false, err = "Waiting for the host to start" }
		end
		queued[player] = true
		LobbyService.broadcast()
		return { ok = true }
	elseif action == "menu" then
		if LobbyService.isRacing(player) then
			return { ok = false, err = "Finish the round first" }
		end
		queued[player] = nil
		LobbyService.broadcast()
		return { ok = true }
	elseif action == "create" then
		if LobbyService.mode == "party" then
			return { ok = false, err = "You're already in a party" }
		end
		return createParty(player)
	elseif action == "join" then
		return joinParty(player, arg)
	elseif action == "leave" then
		return leaveParty(player)
	elseif action == "start" then
		if LobbyService.mode ~= "party" or player.UserId ~= LobbyService.hostId then
			return { ok = false, err = "Only the host can start" }
		end
		if LobbyService.inMatch then
			return { ok = false, err = "A match is already running" }
		end
		partyStarted = true
		LobbyService.broadcast()
		return { ok = true }
	elseif action == "species" then
		if typeof(arg) ~= "string" or not Characters.ById[arg] then
			return { ok = false, err = "Unknown animal" }
		end
		if LobbyService.isRacing(player) then
			return { ok = false, err = "Change after this race" }
		end
		PlayerService.setSpecies(player, arg)
		LobbyService.broadcast()
		return { ok = true }
	end
	return { ok = false, err = "Unknown action" }
end

--------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	table.insert(joinOrder, player)
	local data = player:GetJoinData()
	local tp = data and data.TeleportData
	if LobbyService.mode == "party" then
		if typeof(tp) == "table" then
			if not LobbyService.code and typeof(tp.code) == "string" then
				LobbyService.code = tp.code
			end
			if tp.host == player.UserId then
				LobbyService.hostId = player.UserId
			end
		end
		if not LobbyService.hostId then
			LobbyService.hostId = player.UserId
		end
	else
		-- Accepted an in-game invite to a party? Its code rides along as launch data.
		local launch = data and data.LaunchData
		if typeof(launch) == "string" and #launch == 5 then
			task.delay(2, function()
				if player.Parent then
					joinParty(player, launch)
				end
			end)
		end
	end
	task.defer(LobbyService.broadcast)
end

local function onPlayerRemoving(player: Player)
	queued[player] = nil
	lastAction[player] = nil
	local i = table.find(joinOrder, player)
	if i then
		table.remove(joinOrder, i)
	end
	if player.UserId == LobbyService.hostId then
		-- hand the crown to whoever's been here longest
		local nextHost = joinOrder[1]
		LobbyService.hostId = nextHost and nextHost.UserId
	end
	LobbyService.broadcast()
end

function LobbyService.init()
	if isReservedServer() then
		LobbyService.mode = "party"
	end
	LobbyFn.OnServerInvoke = onInvoke
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)
end

return LobbyService
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX80935D30492B4FDA8CA5BEAAA667D53F">
        <Properties><string name="Name">MatchService</string><ProtectedString name="Source"><![CDATA[-- The whole match: pick a level, play rounds until someone crosses
-- PointsToWin (or MaxRounds runs out, last round double), crown a winner.
-- With bigger maps a round is ~1.5-2 minutes, so a match lands around 10-15.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local PlayerService = require(script.Parent.PlayerService)
local LevelService = require(script.Parent.LevelService)
local BuildService = require(script.Parent.BuildService)
local RoundService = require(script.Parent.RoundService)
local ScoringService = require(script.Parent.ScoringService)
local LobbyService = require(script.Parent.LobbyService)

local RoundResults = Net.event("RoundResults")

local MatchService = {}

local function leaders(): { any }
	local standings = ScoringService.standings()
	local best = standings[1] and standings[1].total or 0
	local list = {}
	for _, row in standings do
		if row.total == best and best > 0 then
			table.insert(list, row)
		end
	end
	return list
end

local function playMatch()
	local M = Config.Match
	BuildService.clearObjects()
	ScoringService.reset()
	for _, p in LobbyService.participants() do
		ScoringService.ensure(p)
		PlayerService.park(p)
	end
	ScoringService.broadcast()
	LobbyService.matchStarted()

	local ctx = RoundService.context
	ctx.level = LevelService.layout and LevelService.layout.name or ""
	ctx.round = 0
	ctx.final = false
	RoundService.setPhase("Intro", M.IntroTime, { target = M.PointsToWin })
	task.wait(M.IntroTime)

	for round = 1, M.MaxRounds do
		local players = LobbyService.participants()
		if #players == 0 then
			break
		end
		for _, p in players do
			ScoringService.ensure(p) -- late joiners slot straight in
		end

		ctx.round = round
		ctx.final = round == M.MaxRounds
		RoundService.build(players)
		local info = RoundService.run(LobbyService.participants())

		local mult = if ctx.final then M.LastRoundMultiplier else 1
		local results = ScoringService.score(info, mult)
		RoundResults:FireAllClients(results)
		ScoringService.broadcast()
		RoundService.setPhase("Results", M.ResultsTime)
		task.wait(M.ResultsTime)

		local top = ScoringService.standings()[1]
		if top and top.total >= M.PointsToWin then
			break
		end
	end

	local winners = leaders()
	for i, row in winners do
		local p = Players:GetPlayerByUserId(row.userId)
		if p and p.Character then
			local spot = LevelService.flag + Vector3.new(-2 - i * 1.8, 0, 0)
			PlayerService.toStart(p, spot, 1)
			p.Character:SetAttribute("VictoryAt", workspace:GetServerTimeNow())
		end
	end
	RoundService.setPhase("Winner", M.WinnerTime, {
		winners = winners,
		standings = ScoringService.standings(),
		target = M.PointsToWin,
	})
	task.wait(M.WinnerTime)
	for _, p in Players:GetPlayers() do
		PlayerService.park(p)
	end
	LobbyService.matchEnded()
end

function MatchService.start()
	LobbyService.isRacing = RoundService.isRacing
	task.spawn(function()
		local last: string? = nil
		while true do
			-- Fresh level between matches so the menu has something to look at
			local layout = LevelService.pick(last)
			last = layout.name
			BuildService.clearObjects()
			LevelService.build(layout)
			RoundService.context.level = layout.name
			RoundService.context.round = 0
			RoundService.setPhase("Waiting", 0)

			repeat
				task.wait(0.5)
			until LobbyService.ready()
			task.wait(1)

			local ok, err = pcall(playMatch)
			if not ok then
				warn("[Match] crashed, restarting:", err)
				LobbyService.matchEnded()
				task.wait(2)
			end
		end
	end)
end

return MatchService
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX1FB61B8F3F3B453DA37C3EF00848CEE2">
        <Properties><string name="Name">PlayerService</string><ProtectedString name="Source"><![CDATA[-- Owns characters: which animal you are, where your body is, whether you can move.
-- Nobody ever "dies" in the Roblox sense; we park and release characters instead,
-- which means no respawn delays and no default death screen.

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Characters = require(Shared.Characters)
local Config = require(Shared.Config)
local Style = require(Shared.Style)

local PlayerService = {}

PlayerService.species = {} :: { [Player]: string }

local function pickSpecies(): string
	local used = {}
	for _, id in PlayerService.species do
		used[id] = (used[id] or 0) + 1
	end
	local best, bestCount = Characters.List[1].id, math.huge
	for _, s in Characters.List do
		local n = used[s.id] or 0
		-- least-used first, random tiebreak so it isn't always the fox
		if n < bestCount or (n == bestCount and math.random() < 0.5) then
			best, bestCount = s.id, n
		end
	end
	return best
end

local function nameTag(model: Model, player: Player)
	local head = model:FindFirstChild("Head") :: BasePart
	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(160, 22)
	gui.StudsOffset = Vector3.new(0, 2.7, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Adornee = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.FontFace = Style.Font.Title
	label.TextSize = 15
	label.TextColor3 = Style.UI.Paper
	label.Text = player.DisplayName
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.6
	stroke.Color = Style.UI.Ink
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = head
end

function PlayerService.root(player: Player): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function PlayerService.spawn(player: Player)
	if player.Character then
		player.Character:Destroy()
	end
	local species = PlayerService.species[player] or pickSpecies()
	PlayerService.species[player] = species

	local model = Characters.build(species)
	model.Name = player.Name
	nameTag(model, player)
	local root = model.PrimaryPart :: BasePart
	root.Anchored = true
	model:PivotTo(CFrame.new(Config.World.Hold))
	model.Parent = workspace
	player.Character = model

	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.Died:Connect(function()
		-- Shouldn't happen, but never leave someone without a body
		task.wait(0.5)
		if player.Parent then
			PlayerService.spawn(player)
		end
	end)
end

local function setState(player: Player, cf: CFrame, anchored: boolean)
	local char = player.Character
	local root = PlayerService.root(player)
	if not char or not root then
		return
	end
	root.Anchored = true
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	char:PivotTo(cf)
	if not anchored then
		root.Anchored = false
		root:SetNetworkOwner(player)
	end
end

function PlayerService.park(player: Player)
	setState(player, CFrame.new(Config.World.Hold), true)
	local char = player.Character
	if char then
		char:SetAttribute("FailAt", nil)
		char:SetAttribute("VictoryAt", nil)
	end
end

-- Line up at the start, facing the flag, frozen until release()
function PlayerService.toStart(player: Player, spawn: Vector3, slot: number)
	local pos = spawn + Vector3.new(-((slot - 1) % 4) * 1.6, 2.3, 0)
	setState(player, CFrame.lookAt(pos, pos + Vector3.xAxis), true)
	local char = player.Character
	if char then
		char:SetAttribute("FailAt", nil)
		char:SetAttribute("VictoryAt", nil)
	end
end

function PlayerService.release(player: Player)
	local root = PlayerService.root(player)
	if root then
		root.Anchored = false
		root:SetNetworkOwner(player)
	end
end

function PlayerService.freeze(player: Player)
	local root = PlayerService.root(player)
	if root then
		root.Anchored = true
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

-- Swap animal. Only called when the player isn't mid-race.
function PlayerService.setSpecies(player: Player, speciesId: string)
	if PlayerService.species[player] == speciesId then
		return
	end
	PlayerService.species[player] = speciesId
	local root = PlayerService.root(player)
	local cf = if root then root.CFrame else CFrame.new(Config.World.Hold)
	local anchored = if root then root.Anchored else true
	PlayerService.spawn(player)
	-- keep them exactly where they were (on the flag after a win, etc.)
	local newRoot = PlayerService.root(player)
	if newRoot and player.Character then
		player.Character:PivotTo(cf)
		newRoot.Anchored = anchored
	end
end

function PlayerService.init()
	Players.CharacterAutoLoads = false
	PhysicsService:RegisterCollisionGroup("Players")
	PhysicsService:CollisionGroupSetCollidable("Players", "Players", false)

	local function added(player: Player)
		PlayerService.spawn(player)
	end
	Players.PlayerAdded:Connect(added)
	for _, p in Players:GetPlayers() do
		task.spawn(added, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		PlayerService.species[player] = nil
	end)
end

return PlayerService
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXCB7F143C82454970A401FD964DACDE02">
        <Properties><string name="Name">RoundService</string><ProtectedString name="Source"><![CDATA[-- One round = pick from the box -> build -> run. Also owns the phase
-- broadcast, since every phase change goes through here.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local PlayerService = require(script.Parent.PlayerService)
local LevelService = require(script.Parent.LevelService)
local BuildService = require(script.Parent.BuildService)
local HazardService = require(script.Parent.HazardService)
local ScoringService = require(script.Parent.ScoringService)

local MatchState = Net.event("MatchState")
local FailEvent = Net.event("Fail")
local FinishEvent = Net.event("Finish")

local RoundService = {}

RoundService.phase = "Waiting"
RoundService.context = { round = 0, rounds = Config.Match.MaxRounds, final = false, level = "" }

local status = {} :: { [Player]: string } -- running | done | dead
local runners = {} :: { Player }

function RoundService.setPhase(phase: string, duration: number, extra: { [string]: any }?)
	RoundService.phase = phase
	local ids = {}
	for _, p in runners do
		table.insert(ids, p.UserId)
	end
	MatchState:FireAllClients({
		phase = phase,
		endsAt = workspace:GetServerTimeNow() + duration,
		round = RoundService.context.round,
		rounds = RoundService.context.rounds,
		final = RoundService.context.final,
		level = RoundService.context.level,
		runners = ids,
		extra = extra or {},
	})
end

-- Late joiners get the current phase immediately instead of a blank screen
function RoundService.resend(player: Player)
	local ids = {}
	for _, p in runners do
		table.insert(ids, p.UserId)
	end
	MatchState:FireClient(player, {
		phase = RoundService.phase,
		endsAt = workspace:GetServerTimeNow(),
		round = RoundService.context.round,
		rounds = RoundService.context.rounds,
		final = RoundService.context.final,
		level = RoundService.context.level,
		runners = ids,
		extra = {},
	})
end

local function waitUntil(duration: number, done: () -> boolean)
	local elapsed = 0
	while elapsed < duration and not done() do
		elapsed += task.wait(0.1)
	end
end

--------------------------------------------------------------------------
-- Pick + build
--------------------------------------------------------------------------

function RoundService.build(players: { Player })
	table.clear(runners)
	for _, p in players do
		PlayerService.park(p)
	end

	BuildService.openPick(players, RoundService.context.round)
	RoundService.setPhase("Pick", Config.Match.PickTime)
	waitUntil(Config.Match.PickTime, BuildService.everyonePicked)
	BuildService.closePick()
	task.wait(1) -- a beat to see who got what

	BuildService.openBuild(players)
	RoundService.setPhase("Build", Config.Match.BuildTime)
	waitUntil(Config.Match.BuildTime, function()
		return BuildService.everyonePlaced(players)
	end)
	BuildService.closeBuild()
	task.wait(0.6) -- let the last "pop" land before the camera moves
end

function RoundService.isRacing(player: Player): boolean
	local s = status[player]
	return (RoundService.phase == "Countdown" or RoundService.phase == "Run") and (s == "ready" or s == "running")
end

--------------------------------------------------------------------------
-- Run
--------------------------------------------------------------------------

local runStarted = 0
local finishers = {} :: { ScoringService.Finish }
local kills = {} :: { [number]: number }

local function isRunning(player: Player): boolean
	return RoundService.phase == "Run" and status[player] == "running"
end

local function fail(player: Player, cause: string, killerId: number?)
	if not isRunning(player) then
		return
	end
	status[player] = "dead"
	if killerId and killerId ~= player.UserId then
		kills[killerId] = (kills[killerId] or 0) + 1
	end
	local char = player.Character
	if char then
		char:SetAttribute("FailAt", workspace:GetServerTimeNow())
	end
	FailEvent:FireAllClients(player.UserId, cause, killerId)
	task.delay(1.4, function()
		if status[player] == "dead" then
			PlayerService.park(player)
		end
	end)
end

local function finish(player: Player)
	if not isRunning(player) then
		return
	end
	local elapsed = os.clock() - runStarted
	if elapsed < Config.World.GoalMinTime then
		return -- nobody legit gets here this fast
	end
	status[player] = "done"
	table.insert(finishers, { player = player, timeLeft = Config.Match.RunTime - elapsed })
	local char = player.Character
	if char then
		char:SetAttribute("VictoryAt", workspace:GetServerTimeNow())
	end
	FinishEvent:FireAllClients(player.UserId, #finishers)
	task.delay(0.25, function()
		if status[player] == "done" then
			PlayerService.freeze(player)
		end
	end)
end

function RoundService.run(players: { Player }): ScoringService.RunInfo
	table.clear(status)
	table.clear(finishers)
	table.clear(kills)
	table.clear(runners)
	HazardService.resetRound()

	for i, p in players do
		if p.Parent then
			table.insert(runners, p)
			status[p] = "ready"
			PlayerService.toStart(p, LevelService.spawn, i)
		end
	end

	RoundService.setPhase("Countdown", Config.Match.CountdownTime)
	task.wait(Config.Match.CountdownTime)

	runStarted = os.clock()
	for _, p in runners do
		status[p] = "running"
	end
	RoundService.setPhase("Run", Config.Match.RunTime)
	for _, p in runners do
		PlayerService.release(p)
	end

	local goalConn: RBXScriptConnection? = nil
	if LevelService.goalZone then
		goalConn = LevelService.goalZone.Touched:Connect(function(hit)
			if hit.Name == "HumanoidRootPart" then
				local p = Players:GetPlayerFromCharacter(hit.Parent)
				if p then
					finish(p)
				end
			end
		end)
	end

	waitUntil(Config.Match.RunTime, function()
		-- cheap 10Hz checks instead of a Heartbeat loop
		local alive = {}
		for _, p in runners do
			if status[p] == "running" then
				table.insert(alive, p)
			end
		end
		HazardService.tick(alive)
		for _, p in runners do
			if status[p] == "running" then
				local root = PlayerService.root(p)
				if not root or not p.Parent then
					status[p] = "dead"
				elseif root.Position.Y < Config.World.KillY then
					fail(p, "fall")
				end
			end
		end
		for _, p in runners do
			if status[p] == "running" then
				return false
			end
		end
		return true
	end)

	for _, p in runners do
		if status[p] == "running" then
			fail(p, "time")
		end
	end
	if goalConn then
		goalConn:Disconnect()
	end
	RoundService.phase = "RunOver"
	task.wait(1.5) -- let the last tumble finish on screen

	return {
		runners = table.clone(runners),
		finishers = table.clone(finishers),
		kills = table.clone(kills),
	}
end

function RoundService.init()
	HazardService.isRunning = isRunning
	HazardService.onDeadly = function(player, model)
		fail(player, model:GetAttribute("Id") :: string, model:GetAttribute("Owner") :: number)
	end
	Players.PlayerAdded:Connect(function(p)
		task.wait(1)
		RoundService.resend(p)
		ScoringService.broadcast()
	end)
end

return RoundService
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXB17279C295964FC8BFB1291D26CEBE8B">
        <Properties><string name="Name">ScoringService</string><ProtectedString name="Source"><![CDATA[-- Turns what happened in a run into points.
--
-- The rules, in one breath:
--   first to Config.Match.PointsToWin wins the match
--   finish 1st/2nd/3rd/4th+ -> 100/75/50/25
--   take someone out with your object -> +25 each (max 75 a round)
--   small bonuses: clutch finish, finishing via a route you built
--   BUT if everyone finishes, it was TOO EASY: nobody scores
--   and if nobody finishes, it was TOO HARD: trap points don't count
-- So the best level is one that's deadly but beatable. That's the game.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local PlayerService = require(script.Parent.PlayerService)
local HazardService = require(script.Parent.HazardService)

local ScoresEvent = Net.event("Scores")

local ScoringService = {}

ScoringService.totals = {} :: { [Player]: number }

export type Finish = { player: Player, timeLeft: number }
export type RunInfo = {
	runners: { Player },
	finishers: { Finish },
	kills: { [number]: number }, -- killer UserId -> opponents taken out
}

local ORDINAL = { "1st", "2nd", "3rd" }

local function ordinal(n: number): string
	return ORDINAL[n] or (tostring(n) .. "th")
end

function ScoringService.reset()
	table.clear(ScoringService.totals)
end

function ScoringService.ensure(player: Player)
	if ScoringService.totals[player] == nil then
		ScoringService.totals[player] = 0
	end
end

function ScoringService.standings()
	local list = {}
	for player, total in ScoringService.totals do
		if player.Parent then
			table.insert(list, {
				userId = player.UserId,
				name = player.DisplayName,
				species = PlayerService.species[player],
				total = total,
			})
		end
	end
	table.sort(list, function(a, b)
		return a.total > b.total
	end)
	return list
end

function ScoringService.broadcast()
	ScoresEvent:FireAllClients(ScoringService.standings())
end

function ScoringService.score(info: RunInfo, multiplier: number)
	local S = Config.Scoring
	local n, f = #info.runners, #info.finishers
	local verdict: string? = nil
	if n >= 2 and f == n then
		verdict = "TOO_EASY"
	elseif f == 0 then
		verdict = "TOO_HARD"
	end

	local rows = {}
	for _, player in info.runners do
		if not player.Parent then
			continue
		end
		ScoringService.ensure(player)
		local items = {}
		local function add(cat: string, label: string, pts: number)
			table.insert(items, { cat = cat, label = label, points = pts * multiplier })
		end

		local place: number? = nil
		for i, fin in info.finishers do
			if fin.player == player then
				place = i
				if verdict == nil then
					add("finish", ordinal(i), S.Place[math.min(i, #S.Place)])
					if fin.timeLeft <= S.ClutchWindow then
						add("clutch", "Clutch", S.Clutch)
					end
					if HazardService.usedOwnRoute(player) then
						add("route", "Own route", S.OwnRoute)
					end
				end
			end
		end

		local kills = info.kills[player.UserId] or 0
		if kills > 0 and verdict == nil then
			add("trap", if kills == 1 then "Trap" else ("Trap x" .. kills), math.min(kills * S.Trap, S.TrapCap))
		end

		local gained = 0
		for _, it in items do
			gained += it.points
		end
		local before = ScoringService.totals[player]
		ScoringService.totals[player] += gained

		table.insert(rows, {
			before = before,
			userId = player.UserId,
			name = player.DisplayName,
			species = PlayerService.species[player],
			finished = place ~= nil,
			items = items,
			gained = gained,
			total = ScoringService.totals[player],
		})
	end

	-- Sorted by the match standing, so the chart reads like a race
	table.sort(rows, function(a, b)
		if a.total ~= b.total then
			return a.total > b.total
		end
		return a.gained > b.gained
	end)

	return { verdict = verdict, multiplier = multiplier, rows = rows, target = Config.Match.PointsToWin }
end

return ScoringService
]]></ProtectedString></Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="RBXB816D1BD2DDF40E980B23E21259D0D2E">
    <Properties><string name="Name">ServerStorage</string></Properties>
  </Item>
  <Item class="StarterGui" referent="RBX8D820480C5E54EEB9E4F3032CB6AC035">
    <Properties><string name="Name">StarterGui</string></Properties>
  </Item>
  <Item class="StarterPack" referent="RBXF620764B46E54B22A51DFD7CD84FADB9">
    <Properties><string name="Name">StarterPack</string></Properties>
  </Item>
  <Item class="StarterPlayer" referent="RBX5959112854B549C7825DB7EF203E581E">
    <Properties><string name="Name">StarterPlayer</string></Properties>
    <Item class="StarterPlayerScripts" referent="RBX29BF89A3CC014383A7453B7501237C23">
      <Properties><string name="Name">StarterPlayerScripts</string></Properties>
      <Item class="LocalScript" referent="RBX4D0D54FA9E224A94A4CD04671D6A605C">
        <Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Client entry point. Controllers are plain modules; order matters only here.

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Controllers = script.Parent:WaitForChild("Controllers")

local State = require(Controllers.State)
local Sound = require(Controllers.SoundController)
local Fx = require(Controllers.FxController)
local Hud = require(Controllers.HudController)
local Camera = require(Controllers.CameraController)
local Movement = require(Controllers.MovementController)
local Objects = require(Controllers.ObjectController)
local Pick = require(Controllers.PickController)
local Build = require(Controllers.BuildController)
local Animator = require(Controllers.CharacterAnimator)
local Menu = require(Controllers.MenuController)

State.init() -- first: everyone else reads State
Sound.init()
Fx.init()
Hud.init()
Camera.init()
Movement.init()
Objects.init()
Pick.init()
Build.init()
Animator.init()
task.spawn(Menu.init) -- waits for the loading screen to finish
]]></ProtectedString></Properties>
      </Item>
      <Item class="Folder" referent="RBX410A4393B25644F59656B1B51CA00CE8">
        <Properties><string name="Name">Controllers</string></Properties>
        <Item class="ModuleScript" referent="RBX962CC1EFBADE46169A02F683230348CA">
          <Properties><string name="Name">BuildController</string><ProtectedString name="Source"><![CDATA[-- Building should take seconds:
--   pick a card -> a ghost follows your pointer, snapped to the grid,
--   green if it fits / red if not -> click to drop it. R rotates, right-click goes back.
-- You also see other builders' ghosts live, which is half the fun
-- (watching someone hover spikes over the shortcut you were planning to use).

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local Objects = require(Shared.Objects)
local Style = require(Shared.Style)

local Camera = require(script.Parent.CameraController)
local Hud = require(script.Parent.HudController)
local Sound = require(script.Parent.SoundController)
local State = require(script.Parent.State)

local PlaceEvent = Net.event("Place")
local PlaceResult = Net.event("PlaceResult")
local Cursor = Net.unreliable("Cursor")

local Build = {}

local hand: { string }? = nil
local selected: string? = nil
local rot = 0
local ghost: Model? = nil
local highlight: Highlight? = nil
local valid = false
local reason: string? = nil
local gx, gy = 0, 0
local waiting = false
local pointer: Vector2? = nil
local stick = Vector2.zero
local lastSend = 0
local ghostFolder: Folder

type Other = { model: Model, id: string, target: CFrame }
local others = {} :: { [number]: Other }

local function makeGhost(id: string, transparency: number): Model
	local m = Objects.build(id)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
			if d.Transparency < 1 then
				d.Transparency = math.max(d.Transparency, transparency)
			end
		end
	end
	m.Parent = ghostFolder
	return m
end

local function clearGhost()
	if ghost then
		ghost:Destroy()
	end
	ghost = nil
	highlight = nil
	Camera.building = false
	Camera.pan = Vector2.zero
end

local function sendCursor(id: string)
	Cursor:FireServer(id, gx, gy, rot)
end

--------------------------------------------------------------------------
-- Actions
--------------------------------------------------------------------------

function Build.select(id: string)
	if waiting or not hand or not table.find(hand, id) then
		return
	end
	clearGhost()
	selected = id
	rot = 0
	ghost = makeGhost(id, 0.25)
	local h = Instance.new("Highlight")
	h.FillTransparency = 0.7
	h.OutlineTransparency = 0.1
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = ghost
	highlight = h
	if not pointer then
		local cam = workspace.CurrentCamera
		pointer = cam.ViewportSize / 2
	end
	GuiService.SelectedObject = nil
	Camera.building = true
	Hud.setTray(false)
	Hud.setPlacing(true)
	Sound.play("pick")
end

function Build.back()
	if not selected or waiting then
		return
	end
	clearGhost()
	selected = nil
	sendCursor("")
	Hud.setPlacing(false)
	Hud.setTray(true)
	Sound.play("pick")
end

function Build.rotate()
	if not selected or waiting then
		return
	end
	rot = (rot + 90) % 360
	Sound.play("pick")
end

function Build.place()
	if not selected or waiting then
		return
	end
	if not valid then
		Sound.play("error")
		Hud.toast(reason or "Can't place there", Style.UI.Bad)
		return
	end
	waiting = true
	PlaceEvent:FireServer(selected, gx, gy, rot)
end

local function reset()
	clearGhost()
	hand = nil
	selected = nil
	waiting = false
	Hud.showHand(nil)
	Hud.setPlacing(false)
end

--------------------------------------------------------------------------
-- Pointer -> world
--------------------------------------------------------------------------

local function worldPoint(screen: Vector2): Vector3?
	local cam = workspace.CurrentCamera
	local ray = cam:ViewportPointToRay(screen.X, screen.Y)
	if math.abs(ray.Direction.Z) < 1e-4 then
		return nil
	end
	local t = -ray.Origin.Z / ray.Direction.Z
	if t <= 0 then
		return nil
	end
	return ray.Origin + ray.Direction * t
end

local function update(dt: number)
	-- Smooth other builders' ghosts toward their latest reported spot
	local a = 1 - math.exp(-dt * 14)
	for _, o in others do
		o.model:PivotTo(o.model:GetPivot():Lerp(o.target, a))
	end

	if not selected or not ghost then
		return
	end
	if stick.Magnitude > 0.2 and pointer then
		local vp = workspace.CurrentCamera.ViewportSize
		local p = pointer + Vector2.new(stick.X, -stick.Y) * 900 * dt
		pointer = Vector2.new(math.clamp(p.X, 0, vp.X), math.clamp(p.Y, 0, vp.Y))
	end
	if UserInputService:GetLastInputType() == Enum.UserInputType.MouseMovement then
		pointer = UserInputService:GetMouseLocation()
	end
	if not pointer then
		return
	end

	-- Cursor resting near a screen edge pans the build camera that way
	local vp = workspace.CurrentCamera.ViewportSize
	local EDGE = 0.1
	local function edge(n: number): number
		if n < EDGE then
			return -(EDGE - n) / EDGE
		elseif n > 1 - EDGE then
			return (n - (1 - EDGE)) / EDGE
		end
		return 0
	end
	Camera.pan = Vector2.new(edge(pointer.X / vp.X), -edge(pointer.Y / vp.Y))

	local world = worldPoint(pointer)
	if not world then
		return
	end

	local def = Objects.ById[selected]
	gx, gy = Objects.snap(def, world.X, world.Y, rot)
	ghost:PivotTo(Objects.cframe(gx, gy, rot))
	valid, reason = Objects.check(def, gx, gy, rot)
	if highlight then
		local c = if valid then Style.UI.Good else Style.UI.Bad
		highlight.FillColor = c
		highlight.OutlineColor = c
	end

	local now = os.clock()
	if now - lastSend > 0.1 then
		lastSend = now
		sendCursor(selected)
	end
end

--------------------------------------------------------------------------
-- Other builders
--------------------------------------------------------------------------

local function nameTag(model: Model, userId: number)
	local p = Players:GetPlayerByUserId(userId)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(140, 20)
	gui.StudsOffset = Vector3.new(0, 2.5, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.FontFace = Style.Font.Bold
	label.TextSize = 14
	label.TextColor3 = Style.UI.Paper
	label.Text = if p then p.DisplayName else "?"
	local stroke = Instance.new("UIStroke")
	stroke.Color = Style.UI.Ink
	stroke.Thickness = 1.5
	stroke.Parent = label
	label.Parent = gui
	gui.Adornee = model:FindFirstChildWhichIsA("BasePart")
	gui.Parent = model
end

local function onCursor(userId: number, id: string, x: number, y: number, r: number)
	if userId == 0 then
		for _, o in others do
			o.model:Destroy()
		end
		table.clear(others)
		return
	end
	local o = others[userId]
	if id == "" then
		if o then
			o.model:Destroy()
			others[userId] = nil
		end
		return
	end
	if not Objects.ById[id] then
		return
	end
	local target = Objects.cframe(x, y, r)
	if not o or o.id ~= id then
		if o then
			o.model:Destroy()
		end
		local m = makeGhost(id, 0.55)
		m:PivotTo(target)
		nameTag(m, userId)
		o = { model = m, id = id, target = target }
		others[userId] = o
	end
	(o :: Other).target = target
end

--------------------------------------------------------------------------

function Build.init()
	ghostFolder = Instance.new("Folder")
	ghostFolder.Name = "Ghosts"
	ghostFolder.Parent = workspace

	Hud.actions.pick = Build.select
	Hud.actions.back = Build.back
	Hud.actions.rotate = Build.rotate
	Hud.actions.place = Build.place

	Net.event("Hand").OnClientEvent:Connect(function(newHand: { string }?)
		if newHand then
			reset()
			hand = newHand
			Hud.showHand(newHand)
			Hud.setStatus(nil)
			-- one piece from the box: go straight to placing it
			if #newHand == 1 then
				task.delay(0.35, function()
					if hand == newHand and not selected then
						Build.select(newHand[1])
					end
				end)
			end
		else
			local hadHand = hand ~= nil
			reset()
			if hadHand and State.phase == "Build" then
				Hud.setStatus("Placed! Waiting for the others...")
			end
		end
	end)

	PlaceResult.OnClientEvent:Connect(function(ok: boolean, why: string?)
		waiting = false
		if ok then
			clearGhost()
			selected = nil
			Hud.setPlacing(false)
		else
			Sound.play("error")
			Hud.toast(why or "Can't place there", Style.UI.Bad)
		end
	end)

	Cursor.OnClientEvent:Connect(onCursor)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not selected then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch then
			if not processed then
				pointer = Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
			end
			return
		end
		if processed then
			return
		end
		local k = input.KeyCode
		if t == Enum.UserInputType.MouseButton1 or k == Enum.KeyCode.ButtonA then
			Build.place()
		elseif t == Enum.UserInputType.MouseButton2 or k == Enum.KeyCode.Q or k == Enum.KeyCode.Backspace or k == Enum.KeyCode.ButtonB then
			Build.back()
		elseif k == Enum.KeyCode.R or k == Enum.KeyCode.ButtonX then
			Build.rotate()
		end
	end)

	UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.Touch and selected and not processed then
			pointer = Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
		elseif input.KeyCode == Enum.KeyCode.Thumbstick1 then
			stick = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)

	RunService.RenderStepped:Connect(update)
end

return Build
]]></ProtectedString></Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXC68E2F79C7364DAC8D63F21430A78925">
          <Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[-- Side-on camera for a 2.5D game.
--   menu     : the level drifts slowly by behind the menu
--   overview : whole level in frame (intro, pick, results)
--   build    : zoomed in; push the cursor to a screen edge to pan, wheel/pinch to zoom
--   follow   : you, with a little look-ahead in the direction you're moving
--   spectate : once you're out, whoever is still running and furthest along
-- Everything eases toward its goal, so mode changes read as one smooth move.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local State = require(script.Parent.State)

local Camera = {}

-- Set by BuildController while you're placing
Camera.building = false
Camera.pan = Vector2.zero -- -1..1 per axis, from the cursor sitting at a screen edge
Camera.menuOpen = false

local FOV = 40
local FOLLOW_DIST = 46
local BUILD_MIN, BUILD_DEFAULT = 34, 72

local cam = workspace.CurrentCamera
local focus = Vector3.new(100, 20, 0)
local dist = 120
local lookAhead = 0
local shakeAmp = 0
local spectating: Player? = nil
local failHoldUntil = 0
local buildFocus: Vector3? = nil
local buildDist = BUILD_DEFAULT

function Camera.shake(amount: number)
	shakeAmp = math.max(shakeAmp, amount)
end

local function bounds(): (Vector3?, Vector3?)
	local level = workspace:FindFirstChild("Level")
	if not level then
		return nil, nil
	end
	return level:GetAttribute("BuildMin") :: Vector3?, level:GetAttribute("BuildMax") :: Vector3?
end

local function levelFrame(): (Vector3?, number?)
	local bmin, bmax = bounds()
	if not bmin or not bmax then
		return nil, nil
	end
	local center = (bmin + bmax) / 2
	local w = bmax.X - bmin.X + 8
	local h = bmax.Y - bmin.Y + 8
	local vp = cam.ViewportSize
	local aspect = vp.X / math.max(vp.Y, 1)
	local t = math.tan(math.rad(FOV / 2))
	local d = math.max((h / 2) / t, (w / 2) / (t * aspect))
	return Vector3.new(center.X, center.Y, 0), d
end

local function rootOf(p: Player): BasePart?
	local c = p.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function pickSpectate(): Player?
	local best, bestX = nil, -math.huge
	for _, id in State.runners do
		local p = Players:GetPlayerByUserId(id)
		local r = p and rootOf(p)
		if p and r and p ~= Players.LocalPlayer and not r.Anchored and r.Position.Y > -50 then
			local fail = p.Character and p.Character:GetAttribute("FailAt")
			if not fail and r.Position.X > bestX then
				best, bestX = p, r.Position.X
			end
		end
	end
	return best
end

local function update(dt: number)
	if cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CameraType = Enum.CameraType.Scriptable
	end
	cam.FieldOfView = FOV

	local goalFocus, goalDist = focus, dist
	local sharp = 4

	local ovFocus, ovDist = levelFrame()
	local me = rootOf(Players.LocalPlayer)
	local phase = State.phase

	if (phase == "Countdown" or phase == "Run") and me and (State.me == "running" or os.clock() < failHoldUntil) then
		local vx = me.AssemblyLinearVelocity.X
		lookAhead += (math.clamp(vx * 0.3, -7, 7) - lookAhead) * math.min(1, dt * 2)
		goalFocus = me.Position + Vector3.new(lookAhead, 3, 0)
		goalDist = FOLLOW_DIST
		sharp = if phase == "Countdown" then 3 else 9
	elseif phase == "Run" then
		if not spectating or not spectating.Parent or (spectating.Character and spectating.Character:GetAttribute("FailAt")) then
			spectating = pickSpectate()
		end
		local r = spectating and rootOf(spectating)
		if r and not r.Anchored then
			goalFocus = r.Position + Vector3.new(0, 3, 0)
			goalDist = FOLLOW_DIST + 8
			sharp = 5
		elseif ovFocus then
			goalFocus, goalDist = ovFocus, ovDist :: number
		end
	elseif phase == "Build" and Camera.building and ovFocus then
		local bmin, bmax = bounds()
		local bf = buildFocus or focus
		bf += Vector3.new(Camera.pan.X, Camera.pan.Y, 0) * (40 + buildDist * 0.6) * dt
		if bmin and bmax then
			bf = Vector3.new(math.clamp(bf.X, bmin.X, bmax.X), math.clamp(bf.Y, bmin.Y + 8, bmax.Y - 8), 0)
		end
		buildFocus = bf
		buildDist = math.clamp(buildDist, BUILD_MIN, ovDist :: number)
		goalFocus, goalDist = bf, buildDist
		sharp = 10
	elseif phase == "Winner" then
		local level = workspace:FindFirstChild("Level")
		local flag = level and level:GetAttribute("Flag") :: Vector3?
		if flag then
			goalFocus = flag + Vector3.new(-3, 4, 0)
			goalDist = 34
			sharp = 3
		end
	elseif (phase == "Waiting" or Camera.menuOpen) and ovFocus then
		-- slow drift across the level behind the menu
		local bmin, bmax = bounds()
		local span = if bmin and bmax then (bmax.X - bmin.X) * 0.3 else 40
		goalFocus = (ovFocus :: Vector3) + Vector3.new(math.sin(os.clock() * 0.07) * span, -4, 0)
		goalDist = (ovDist :: number) * 0.5
		sharp = 1.5
	elseif ovFocus then
		goalFocus, goalDist = ovFocus, ovDist :: number
		sharp = 3
	end

	local a = 1 - math.exp(-dt * sharp)
	focus = focus:Lerp(goalFocus, a)
	dist += (goalDist - dist) * a

	local shake = Vector3.zero
	if shakeAmp > 0.01 then
		shake = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * shakeAmp
		shakeAmp *= math.exp(-dt * 14)
	end

	local eye = focus + Vector3.new(0, dist * 0.06, dist)
	cam.CFrame = CFrame.lookAt(eye + shake, focus + shake)
end

function Camera.init()
	RunService:BindToRenderStep("ChaosCamera", Enum.RenderPriority.Camera.Value + 1, update)
	State.meChanged:Connect(function(me)
		if me == "dead" then
			failHoldUntil = os.clock() + 1.1 -- watch your own tumble for a beat
			Camera.shake(0.8)
		end
		spectating = nil
	end)
	State.phaseChanged:Connect(function(phase)
		if phase == "Build" then
			buildDist = BUILD_DEFAULT
			-- start building near the start line, where the action begins
			local level = workspace:FindFirstChild("Level")
			local spawn = level and level:GetAttribute("Spawn") :: Vector3?
			buildFocus = if spawn then spawn + Vector3.new(30, 8, 0) else nil
		end
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		if processed or State.phase ~= "Build" then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			buildDist *= if input.Position.Z > 0 then 0.88 else 1.14
		end
	end)
	UserInputService.TouchPinch:Connect(function(_, scale, _, _, processed)
		if not processed and State.phase == "Build" then
			buildDist /= math.clamp(scale, 0.95, 1.05)
		end
	end)
end

return Camera
]]></ProtectedString></Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0AAF95383F3C44908E8C0B5AA9CBB242">
          <Properties><string name="Name">CharacterAnimator</string><ProtectedString name="Source"><![CDATA[-- Procedural animation for every character on screen, run locally on each
-- client from replicated velocity. No animation assets, no network cost.
--
--   idle     : gentle breathing, slow tail wag
--   walk/run : waddle bob, forward lean, feet swing, fast tail
--   jump     : stretch on take-off, squash on landing (spring-driven, so it wobbles)
--   flap     : quick front flip on the air jump
--   fail     : big squash + head shake (the tumble itself is real physics)
--   victory  : happy hops

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Fx = require(script.Parent.FxController)
local Sound = require(script.Parent.SoundController)

local Animator = {}

type Rig = {
	model: Model,
	root: BasePart,
	bodyJoint: Motor6D?,
	neck: Motor6D?,
	hipL: Motor6D?,
	hipR: Motor6D?,
	tail: Motor6D?,
	flipL: Motor6D?,
	flipR: Motor6D?,
	mesh: SpecialMesh?,
	-- state
	squash: number,
	squashVel: number,
	walkPhase: number,
	grounded: boolean,
	lastVY: number,
	flip: number,
	isLocal: boolean,
}

local rigs = {} :: { [Model]: Rig }
local rayParams = RaycastParams.new()
rayParams.CollisionGroup = "Players"

local function find(model: Model, jointName: string): Motor6D?
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and d.Name == jointName then
			return d
		end
	end
	return nil
end

local function track(model: Model, isLocal: boolean)
	local root = model:WaitForChild("HumanoidRootPart", 5) :: BasePart?
	if not root then
		return
	end
	local body = model:FindFirstChild("Body")
	rigs[model] = {
		model = model,
		root = root,
		bodyJoint = find(model, "BodyJoint"),
		neck = find(model, "Neck"),
		hipL = find(model, "HipL"),
		hipR = find(model, "HipR"),
		tail = find(model, "TailJoint"),
		flipL = find(model, "FlipL"),
		flipR = find(model, "FlipR"),
		mesh = body and body:FindFirstChildOfClass("SpecialMesh"),
		squash = 0,
		squashVel = 0,
		walkPhase = 0,
		grounded = true,
		lastVY = 0,
		flip = 0,
		isLocal = isLocal,
	}
	model.Destroying:Connect(function()
		rigs[model] = nil
	end)
end

local function step(dt: number)
	local t = os.clock()
	for model, r in rigs do
		if not model.Parent then
			rigs[model] = nil
			continue
		end
		local v = r.root.AssemblyLinearVelocity
		local speed = math.abs(v.X)
		local anchored = r.root.Anchored

		-- grounded: short ray down (works for remote characters too)
		local hit = if anchored then nil else workspace:Raycast(r.root.Position, Vector3.new(0, -2.6, 0), rayParams)
		local grounded = anchored or (hit ~= nil and v.Y < 8)

		-- events
		local feet = r.root.Position - Vector3.new(0, 2.2, 0)
		if r.grounded and not grounded and v.Y > 10 then
			r.squashVel += 9 -- take-off stretch
			Fx.puff(feet, 2, 0.7)
		elseif not r.grounded and grounded and r.lastVY < -20 then
			r.squashVel -= math.clamp(-r.lastVY / 8, 4, 12) -- landing squash
			if r.lastVY < -45 then
				Fx.puff(feet, 4, math.clamp(-r.lastVY / 60, 0.8, 1.6))
			end
			if not r.isLocal then
				Sound.playAt("land", r.root, 0.2)
			end
		elseif not grounded and v.Y - r.lastVY > 30 and r.lastVY < 20 then
			r.flip = 1 -- air jump: front flip
			r.squashVel += 6
			if not r.isLocal then
				Sound.playAt("airJump", r.root, 0.1)
			end
		end
		r.grounded = grounded
		r.lastVY = v.Y

		-- squash spring (wobbles back to 0)
		r.squashVel += (-220 * r.squash - 16 * r.squashVel) * dt
		r.squash = math.clamp(r.squash + r.squashVel * dt, -0.6, 0.6)

		local failAt = model:GetAttribute("FailAt")
		local winAt = model:GetAttribute("VictoryAt")
		local breathe = math.sin(t * 2.2) * 0.025

		local s = r.squash
		if r.mesh then
			r.mesh.Scale = Vector3.new(1 - s * 0.35 - breathe * 0.5, 1 + s * 0.45 + breathe, 1 - s * 0.35 - breathe * 0.5)
		end

		-- walk cycle
		local moving = grounded and speed > 1.5 and not anchored
		if moving then
			r.walkPhase += dt * (6 + speed * 0.45)
		end
		local sw = if moving then math.sin(r.walkPhase) else 0
		local bob = if moving then math.abs(math.sin(r.walkPhase)) * 0.22 * math.min(1, speed / 12) else 0
		local lean = if moving then -math.rad(10) * math.min(1, speed / 22) else 0

		-- flip on air jump
		local flipAngle = 0
		if r.flip > 0 then
			r.flip = math.max(0, r.flip - dt * 3.2)
			flipAngle = -(1 - r.flip) * math.pi * 2
			if r.flip == 0 then
				flipAngle = 0
			end
		end

		local hop = 0
		local spin = 0
		if winAt then
			hop = math.abs(math.sin(t * 7)) * 1.1
			spin = math.sin(t * 3.5) * 0.4
		end

		local headShake = 0
		if failAt then
			headShake = math.sin(t * 40) * 0.25
			lean = math.rad(15)
		end

		local airLean = if not grounded then math.clamp(v.Y / 60, -1, 1) * math.rad(-8) else 0

		if r.bodyJoint then
			-- the mesh scales around its centre, so shift it to keep the feet planted
			r.bodyJoint.Transform = CFrame.new(0, s * 0.5 + bob + hop, 0) * CFrame.Angles(lean + airLean + flipAngle, spin, 0)
		end
		if r.neck then
			r.neck.Transform = CFrame.Angles(math.clamp(v.Y / 70, -1, 1) * math.rad(12) - bob * 0.3, headShake, 0)
		end
		if r.hipL and r.hipR then
			local tuck = if grounded then 0 else 0.25
			local plant = -(s * 0.5 + bob) -- undo the body's bob so feet stay on the ground
			r.hipL.Transform = CFrame.new(0, plant + math.max(0, sw) * 0.3 + tuck, -sw * 0.4 - tuck)
			r.hipR.Transform = CFrame.new(0, plant + math.max(0, -sw) * 0.3 + tuck, sw * 0.4 - tuck)
		end
		if r.tail then
			local rate = if moving then 14 else 3
			local amp = if moving then 0.45 else 0.22
			r.tail.Transform = CFrame.Angles(if grounded then 0 else 0.4, math.sin(t * rate) * amp, 0)
		end
		if r.flipL and r.flipR then
			local flap = if not grounded or winAt then math.sin(t * 28) * 0.6 else sw * 0.3
			r.flipL.Transform = CFrame.Angles(0, 0, -flap)
			r.flipR.Transform = CFrame.Angles(0, 0, flap)
		end
	end
end

function Animator.init()
	local localPlayer = Players.LocalPlayer
	local function hook(p: Player)
		if p.Character then
			task.spawn(track, p.Character, p == localPlayer)
		end
		p.CharacterAdded:Connect(function(c)
			track(c, p == localPlayer)
		end)
	end
	for _, p in Players:GetPlayers() do
		hook(p)
	end
	Players.PlayerAdded:Connect(hook)
	RunService.RenderStepped:Connect(step)
end

return Animator
]]></ProtectedString></Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX56EAF1B5461649A181B4D48D36CADE2E">
          <Properties><string name="Name">FxController</string><ProtectedString name="Source"><![CDATA[-- Small, short-lived effects. Pooled parts, one update loop, nothing glows.
--   puff     : dust when you jump or land hard
--   confetti : someone reached the flag
--   ring     : a flat ring that expands and fades (bumper hits, bomb poof)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Style = require(ReplicatedStorage.Shared.Style)

local Fx = {}

type Particle = {
	part: Part,
	vel: Vector3,
	gravity: number,
	life: number,
	age: number,
	spin: number,
	from: Vector3,
	to: Vector3,
	alpha: number,
}

local active = {} :: { Particle }
local pool = {} :: { Part }
local folder: Folder

local CONFETTI = { Style.UI.Accent, Style.UI.Gold, Style.UI.Good, Style.UI.Cool, Style.UI.Paper }
local FACE_CAMERA = CFrame.Angles(0, math.pi / 2, 0)

local function get(shape: Enum.PartType): Part
	local p = table.remove(pool) or Instance.new("Part")
	p.Shape = shape
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Parent = folder
	return p
end

local function spawn(p: Part, cf: CFrame, vel: Vector3, gravity: number, life: number, from: Vector3, to: Vector3, alpha: number, spin: number?)
	p.CFrame = cf
	p.Size = from
	p.Transparency = alpha
	table.insert(active, {
		part = p,
		vel = vel,
		gravity = gravity,
		life = life,
		age = 0,
		spin = spin or 0,
		from = from,
		to = to,
		alpha = alpha,
	})
end

function Fx.puff(pos: Vector3, count: number?, strength: number?)
	local s = strength or 1
	for i = 1, count or 3 do
		local p = get(Enum.PartType.Ball)
		p.Color = Style.UI.Paper
		local side = if i % 2 == 0 then 1 else -1
		local vel = Vector3.new(side * (2 + math.random() * 3) * s, (1 + math.random() * 2) * s, 0)
		spawn(p, CFrame.new(pos + Vector3.new(side * 0.4, 0.2, 0.6)), vel, 0, 0.35 + math.random() * 0.1, Vector3.one * 0.6, Vector3.one * (1.4 + math.random() * 0.6) * s, 0.25)
	end
end

function Fx.confetti(pos: Vector3)
	for i = 1, 18 do
		local p = get(Enum.PartType.Block)
		p.Color = CONFETTI[(i % #CONFETTI) + 1]
		local vel = Vector3.new((math.random() - 0.5) * 26, 20 + math.random() * 16, 0)
		local size = Vector3.new(0.35, 0.35, 0.08)
		local cf = CFrame.new(pos + Vector3.new(0, 1.5, 1)) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		spawn(p, cf, vel, 60, 1.4 + math.random() * 0.5, size, size, 0, (math.random() - 0.5) * 16)
	end
end

function Fx.ring(pos: Vector3, color: Color3, size: number)
	local p = get(Enum.PartType.Cylinder)
	p.Color = color
	spawn(p, CFrame.new(pos + Vector3.new(0, 0, 1.2)) * FACE_CAMERA, Vector3.zero, 0, 0.3, Vector3.new(0.1, 1, 1), Vector3.new(0.1, size, size), 0.3)
end

local function step(dt: number)
	for i = #active, 1, -1 do
		local a = active[i]
		a.age += dt
		local t = a.age / a.life
		if t >= 1 then
			a.part.Parent = nil
			table.insert(pool, a.part)
			table.remove(active, i)
			continue
		end
		a.vel -= Vector3.new(0, a.gravity * dt, 0)
		local ease = 1 - (1 - t) * (1 - t)
		a.part.Size = a.from:Lerp(a.to, ease)
		a.part.CFrame = (a.part.CFrame + a.vel * dt) * CFrame.Angles(a.spin * dt, a.spin * dt * 0.7, 0)
		-- fade over the last 40% of life
		a.part.Transparency = a.alpha + (1 - a.alpha) * math.clamp((t - 0.6) / 0.4, 0, 1)
	end
end

function Fx.init()
	folder = Instance.new("Folder")
	folder.Name = "Fx"
	folder.Parent = workspace
	RunService.RenderStepped:Connect(step)
end

return Fx
]]></ProtectedString></Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXB86F4B8E2AF74E94BDA89F78CDE7D0F9">
          <Properties><string name="Name">HudController</string><ProtectedString name="Source"><![CDATA[-- Everything on screen. Rule of thumb: during a run, only the timer and a
-- small score list are visible. Big moments get a short centred banner,
-- then get out of the way.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Characters = require(Shared.Characters)
local Net = require(Shared.Net)
local Objects = require(Shared.Objects)
local Style = require(Shared.Style)

local Fx = require(script.Parent.FxController)
local ResultsUI = require(script.Parent.ResultsUI)
local State = require(script.Parent.State)
local Sound = require(script.Parent.SoundController)
local UI = require(script.Parent.UI)

local U = Style.UI
local F = Style.Font
local player = Players.LocalPlayer

local Hud = {}

-- Wired up by BuildController
Hud.actions = {
	pick = function(_id: string) end,
	rotate = function() end,
	back = function() end,
	place = function() end,
}

local PHASES = {
	Waiting = { "WAITING", U.Muted },
	Intro = { "GET READY", U.InkSoft },
	Pick = { "PICK", U.Gold },
	Build = { "BUILD", U.Accent },
	Countdown = { "READY", U.Gold },
	Run = { "RUN", U.Good },
	Results = { "RESULTS", U.InkSoft },
	Winner = { "WINNER", U.Gold },
}

local KIND = {
	route = { "ROUTE", U.Good },
	trap = { "TRAP", U.Bad },
	tool = { "TOOL", U.Gold },
}

local CAUSE = {
	spikes = "got spiked by",
	saw = "got sawed by",
	fall = "fell in the river",
	time = "ran out of time",
}

local gui: ScreenGui
local uiScale: UIScale
local roundLabel: TextLabel
local phaseChip: Frame
local phaseText: TextLabel
local timerLabel: TextLabel
local scoresFrame: Frame
local feedFrame: Frame
local centerLabel: TextLabel
local subLabel: TextLabel
local tray: Frame
local hint: TextLabel
local touchBar: Frame
local statusLabel: TextLabel
local toastFrame: Frame
local toastLabel: TextLabel

local bannerToken = 0
local lastTick = -1

local function speciesColor(species: string?): Color3
	local s = species and Characters.ById[species]
	return if s then s.body else U.Muted
end

local function nameOf(userId: number): string
	local p = Players:GetPlayerByUserId(userId)
	return if p then p.DisplayName else "Someone"
end

--------------------------------------------------------------------------
-- Banners & toasts
--------------------------------------------------------------------------

local function banner(text: string, sub: string?, hold: number, size: number?)
	bannerToken += 1
	local token = bannerToken
	centerLabel.Text = text
	centerLabel.TextSize = size or 54
	subLabel.Text = sub or ""
	centerLabel.TextTransparency = 0
	subLabel.TextTransparency = 0
	local stroke = centerLabel:FindFirstChildOfClass("UIStroke") :: UIStroke
	stroke.Transparency = 0
	local s = centerLabel:FindFirstChildOfClass("UIScale") :: UIScale
	s.Scale = 0.6
	UI.tween(s, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(hold, function()
		if token ~= bannerToken then
			return
		end
		UI.tween(centerLabel, 0.25, { TextTransparency = 1 })
		UI.tween(subLabel, 0.25, { TextTransparency = 1 })
		UI.tween(stroke, 0.25, { Transparency = 1 })
	end)
end

function Hud.toast(text: string, color: Color3?)
	toastLabel.Text = text
	toastFrame.BackgroundColor3 = color or U.Ink
	toastFrame.Visible = true
	toastFrame.BackgroundTransparency = 0
	toastLabel.TextTransparency = 0
	local token = os.clock()
	toastFrame:SetAttribute("Token", token)
	task.delay(2, function()
		if toastFrame:GetAttribute("Token") == token then
			UI.tween(toastFrame, 0.3, { BackgroundTransparency = 1 })
			UI.tween(toastLabel, 0.3, { TextTransparency = 1 })
		end
	end)
end

local function feed(text: string, color: Color3)
	local row = UI.new("Frame", {
		BackgroundColor3 = U.Paper,
		BackgroundTransparency = 0.05,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(),
		Parent = feedFrame,
	}, { UI.corner(8), UI.pad(10, 5) })
	UI.new("Frame", {
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(4, 16),
		Position = UDim2.fromOffset(-6, 0),
		Parent = row,
	}, { UI.corner(2) })
	UI.label({ Text = text, TextSize = 14, FontFace = F.Bold, Parent = row })
	local rows = {}
	for _, c in feedFrame:GetChildren() do
		if c:IsA("Frame") then
			table.insert(rows, c)
		end
	end
	if #rows > 4 then
		rows[1]:Destroy()
	end
	task.delay(4.5, function()
		if row.Parent then
			row:Destroy()
		end
	end)
end

--------------------------------------------------------------------------
-- Scores (top-left)
--------------------------------------------------------------------------

local function renderScores()
	for _, c in scoresFrame:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	for i, row in State.standings do
		local mine = row.userId == player.UserId
		local f = UI.new("Frame", {
			BackgroundColor3 = U.Paper,
			BackgroundTransparency = 0.05,
			Size = UDim2.fromOffset(196, 28),
			LayoutOrder = i,
			Parent = scoresFrame,
		}, { UI.corner(8) })
		if mine then
			UI.new("UIStroke", { Color = U.Accent, Thickness = 2, Parent = f })
		end
		UI.new("Frame", {
			BackgroundColor3 = speciesColor(row.species),
			Size = UDim2.fromOffset(12, 12),
			Position = UDim2.fromOffset(10, 8),
			Parent = f,
		}, { UI.corner(6) })
		UI.label({
			Text = row.name,
			TextSize = 14,
			FontFace = F.Bold,
			AutomaticSize = Enum.AutomaticSize.None,
			Size = UDim2.fromOffset(120, 28),
			Position = UDim2.fromOffset(30, 0),
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = f,
		})
		UI.label({
			Text = tostring(row.total),
			TextSize = 15,
			FontFace = F.Title,
			TextXAlignment = Enum.TextXAlignment.Right,
			AutomaticSize = Enum.AutomaticSize.None,
			Size = UDim2.fromOffset(50, 28),
			Position = UDim2.new(1, -60, 0, 0),
			Parent = f,
		})
	end
end

--------------------------------------------------------------------------
-- Cards
--------------------------------------------------------------------------

local function fitViewport(vp: ViewportFrame, model: Model)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	cam.Parent = vp
	vp.CurrentCamera = cam
	local cf, size = model:GetBoundingBox()
	local extent = math.max(size.X, size.Y * 1.3)
	local d = extent / 2 / math.tan(math.rad(15)) * 1.1 + size.Z / 2
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, size.Y * 0.15, d), cf.Position)
end

local function makeCard(id: string, order: number): TextButton
	local def = Objects.ById[id]
	local button = UI.new("TextButton", {
		Name = id,
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(156, 196),
		LayoutOrder = order,
		Selectable = true,
	})
	local holder, face = UI.card({ Size = UDim2.fromScale(1, 1), Parent = button }, 14)

	local vp = UI.new("ViewportFrame", {
		BackgroundColor3 = U.PaperShade,
		Size = UDim2.new(1, -16, 0, 100),
		Position = UDim2.fromOffset(8, 8),
		Ambient = Color3.fromRGB(170, 166, 160),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.4, -1, -0.6),
		ZIndex = 2,
		Parent = face,
	}, { UI.corner(10) })
	local model = Objects.build(id)
	model.Parent = vp
	fitViewport(vp, model)

	local kind = KIND[def.kind]
	local tag = UI.pill(kind[1], kind[2], U.Paper, 11)
	tag.Position = UDim2.fromOffset(14, 14)
	tag.ZIndex = 3
	tag.Parent = face

	UI.label({
		Text = def.name,
		FontFace = F.Title,
		TextSize = 19,
		Position = UDim2.fromOffset(12, 114),
		ZIndex = 2,
		Parent = face,
	})
	UI.label({
		Text = def.blurb,
		TextSize = 13,
		TextColor3 = U.InkSoft,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.None,
		Size = UDim2.new(1, -24, 0, 44),
		Position = UDim2.fromOffset(12, 140),
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 2,
		Parent = face,
	})

	local stroke = UI.new("UIStroke", { Color = U.Accent, Thickness = 0, Parent = face })
	button.MouseEnter:Connect(function()
		UI.tween(holder, 0.12, { Position = UDim2.fromOffset(0, -6) })
		UI.tween(stroke, 0.12, { Thickness = 3 })
	end)
	button.MouseLeave:Connect(function()
		UI.tween(holder, 0.12, { Position = UDim2.fromOffset(0, 0) })
		UI.tween(stroke, 0.12, { Thickness = 0 })
	end)
	button.SelectionGained:Connect(function()
		UI.tween(stroke, 0.12, { Thickness = 3 })
	end)
	button.SelectionLost:Connect(function()
		UI.tween(stroke, 0.12, { Thickness = 0 })
	end)
	button.Activated:Connect(function()
		Hud.actions.pick(id)
	end)
	return button
end

function Hud.showHand(hand: { string }?)
	for _, c in tray:GetChildren() do
		if c:IsA("GuiButton") then
			c:Destroy()
		end
	end
	if not hand then
		tray.Visible = false
		return
	end
	local first: TextButton? = nil
	for i, id in hand do
		local card = makeCard(id, i)
		card.Parent = tray
		first = first or card
	end
	Hud.setTray(true)
	if UserInputService.GamepadEnabled and first then
		GuiService.SelectedObject = first
	end
end

function Hud.setTray(visible: boolean)
	if visible then
		tray.Visible = true
		tray.Position = UDim2.new(0.5, 0, 1, 220)
		UI.tween(tray, 0.3, { Position = UDim2.new(0.5, 0, 1, -18) }, Enum.EasingStyle.Back)
	else
		UI.tween(tray, 0.2, { Position = UDim2.new(0.5, 0, 1, 220) }).Completed:Once(function()
			if tray.Position.Y.Offset > 100 then
				tray.Visible = false
			end
		end)
	end
end

function Hud.setPlacing(on: boolean)
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local pad = UserInputService:GetLastInputType().Name:find("Gamepad") ~= nil
	hint.Text = if pad
		then "A  place     X  rotate     B  back"
		else "Click  place     R  rotate     Right-click  back"
	hint.Visible = on and not touch
	touchBar.Visible = on and touch
end

function Hud.setStatus(text: string?)
	statusLabel.Text = text or ""
	statusLabel.Visible = text ~= nil
end

--------------------------------------------------------------------------
-- Results / winner: the score table (see ResultsUI)
--------------------------------------------------------------------------

local function showResults(results)
	local verdict = results.verdict
	ResultsUI.show(gui, results.rows, {
		title = if verdict then "Round " .. State.round else "Round " .. State.round .. " results",
		subtitle = if verdict == "TOO_EASY" then "Everyone made it, so nobody scores. Build meaner."
			elseif verdict == "TOO_HARD" then "Nobody made it, so trap points don't count."
			elseif results.multiplier > 1 then "Last round: double points"
			else "First to " .. results.target .. " wins",
		verdict = verdict,
		target = results.target,
	})
end

local function showWinner(extra)
	local standings = extra.standings or {}
	local winners = extra.winners or {}
	local ids = {}
	for _, w in winners do
		table.insert(ids, w.userId)
	end
	local rows = {}
	for _, r in standings do
		table.insert(rows, { userId = r.userId, name = r.name, species = r.species, before = r.total, total = r.total, items = {} })
	end
	local title = if #winners == 0 then "Nobody scored. Rematch?"
		elseif #winners == 1 then winners[1].name .. " wins!"
		else "It's a tie!"
	ResultsUI.show(gui, rows, { title = title, subtitle = "Final standings", target = extra.target or 600, winners = ids })
	Sound.play("victory")
	for _, w in winners do
		local p = Players:GetPlayerByUserId(w.userId)
		local root = p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			Fx.confetti(root.Position)
		end
	end
end

--------------------------------------------------------------------------
-- Phase handling
--------------------------------------------------------------------------

local function onPhase(phase: string)
	local p = PHASES[phase] or PHASES.Waiting
	phaseText.Text = p[1]
	phaseChip.BackgroundColor3 = p[2]
	roundLabel.Text = if State.round > 0 then ("ROUND " .. State.round .. "/" .. State.rounds) else State.level:upper()
	lastTick = -1

	if phase ~= "Results" and phase ~= "Winner" then
		ResultsUI.close()
	end
	if phase ~= "Build" then
		Hud.setStatus(nil)
	end

	if phase == "Intro" then
		local target = State.extra.target or 600
		banner(State.level, "First to " .. target .. " wins. Build it mean, keep it beatable.", 3.8, 46)
	elseif phase == "Build" then
		banner(if State.final then "Last build" else "Build", if State.final then "Double points this round" else "Drop your piece in", 1.4, 44)
	elseif phase == "Run" then
		if State.isRunner(player.UserId) then
			banner("GO!", nil, 0.6, 64)
			Sound.play("go")
		end
	elseif phase == "Winner" then
		showWinner(State.extra)
	end
end

local function tick()
	local phase = State.phase
	local left = State.timeLeft()
	local timed = phase == "Pick" or phase == "Build" or phase == "Run"
	timerLabel.Visible = timed
	if timed then
		local secs = math.ceil(left)
		timerLabel.Text = string.format("%d:%02d", secs // 60, secs % 60)
		local urgent = secs <= 5 and secs > 0
		timerLabel.TextColor3 = if urgent then U.Bad else U.Ink
		if urgent and secs ~= lastTick then
			lastTick = secs
			Sound.play("tick")
		end
	elseif phase == "Countdown" then
		local n = math.ceil(left)
		if n ~= lastTick and n > 0 then
			lastTick = n
			banner(tostring(n), nil, 0.7, 64)
			Sound.play("tick")
		end
	end
end

--------------------------------------------------------------------------

local function buildGui()
	gui = UI.new("ScreenGui", {
		Name = "Hud",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	uiScale = UI.new("UIScale", { Parent = gui })
	local function rescale()
		local h = workspace.CurrentCamera.ViewportSize.Y
		uiScale.Scale = math.clamp(h / 900, 0.62, 1.15)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	-- Top pill: ROUND 3/8 | BUILD | 0:14
	local _, top = UI.card({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(300, 40),
		Parent = gui,
	}, 20)
	UI.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center).Parent = top
	roundLabel = UI.label({ Text = "", FontFace = F.Bold, TextSize = 14, TextColor3 = U.Muted, LayoutOrder = 1, Parent = top })
	phaseChip = UI.new("Frame", {
		BackgroundColor3 = U.Muted,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(),
		LayoutOrder = 2,
		Parent = top,
	}, { UI.corner(99), UI.pad(10, 3) })
	phaseText = UI.label({ Text = "", FontFace = F.Title, TextSize = 15, TextColor3 = U.Paper, Parent = phaseChip })
	timerLabel = UI.label({ Text = "", FontFace = F.Title, TextSize = 20, LayoutOrder = 3, Parent = top })

	local menuButton = UI.new("TextButton", {
		Text = "Menu",
		FontFace = F.Bold,
		TextSize = 14,
		TextColor3 = U.Ink,
		BackgroundColor3 = U.Paper,
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		Size = UDim2.fromOffset(72, 30),
		Parent = gui,
	}, { UI.corner(99) })
	UI.pressable(menuButton, function()
		local ok, res = pcall(function()
			return Net.func("Lobby"):InvokeServer("menu")
		end)
		if ok and typeof(res) == "table" and not res.ok then
			Hud.toast(res.err or "Not right now", U.Bad)
		end
	end)
	State.lobbyChanged:Connect(function()
		menuButton.Visible = State.lobby.mode == "public"
	end)

	scoresFrame = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.fromOffset(196, 300),
		Parent = gui,
	}, { UI.list(Enum.FillDirection.Vertical, 4) })

	feedFrame = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.fromOffset(360, 200),
		Parent = gui,
	}, { UI.list(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Right) })

	centerLabel = UI.label({
		Text = "",
		FontFace = F.Title,
		TextSize = 54,
		TextColor3 = U.Paper,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Parent = gui,
	})
	UI.new("UIStroke", { Color = U.Ink, Thickness = 3, Parent = centerLabel })
	UI.new("UIScale", { Parent = centerLabel })
	subLabel = UI.label({
		Text = "",
		FontFace = F.Bold,
		TextSize = 18,
		TextColor3 = U.Paper,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.36, 40),
		Parent = gui,
	})
	UI.new("UIStroke", { Color = U.Ink, Thickness = 2, Parent = subLabel })

	tray = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 220),
		Size = UDim2.fromOffset(156 * 3 + 14 * 2, 196),
		Visible = false,
		Parent = gui,
	}, { UI.list(Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom) })

	hint = UI.label({
		Text = "",
		FontFace = F.Bold,
		TextSize = 15,
		TextColor3 = U.Paper,
		BackgroundColor3 = U.Ink,
		BackgroundTransparency = 0.1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Visible = false,
		Parent = gui,
	})
	UI.corner(99).Parent = hint
	UI.pad(16, 8).Parent = hint

	touchBar = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.fromOffset(330, 52),
		Visible = false,
		Parent = gui,
	}, { UI.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center) })
	for i, spec in { { "Back", U.InkSoft, "back" }, { "Rotate", U.InkSoft, "rotate" }, { "Place", U.Accent, "place" } } do
		local b = UI.new("TextButton", {
			Text = spec[1],
			FontFace = F.Title,
			TextSize = 18,
			TextColor3 = U.Paper,
			BackgroundColor3 = spec[2],
			AutoButtonColor = false,
			Size = UDim2.fromOffset(100, 52),
			LayoutOrder = i,
			Parent = touchBar,
		}, { UI.corner(14) })
		UI.pressable(b, function()
			(Hud.actions :: any)[spec[3]]()
		end)
	end

	statusLabel = UI.label({
		Text = "",
		FontFace = F.Bold,
		TextSize = 16,
		TextColor3 = U.Paper,
		BackgroundColor3 = U.Ink,
		BackgroundTransparency = 0.1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Visible = false,
		Parent = gui,
	})
	UI.corner(99).Parent = statusLabel
	UI.pad(16, 8).Parent = statusLabel

	toastFrame = UI.new("Frame", {
		BackgroundColor3 = U.Ink,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -240),
		Visible = false,
		Parent = gui,
	}, { UI.corner(99), UI.pad(14, 6) })
	toastLabel = UI.label({ Text = "", FontFace = F.Bold, TextSize = 15, TextColor3 = U.Paper, Parent = toastFrame })
end

function Hud.setVisible(visible: boolean)
	gui.Enabled = visible
end

function Hud.init()
	buildGui()
	pcall(function()
		local StarterGui = game:GetService("StarterGui")
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)

	State.phaseChanged:Connect(onPhase)
	RunService.Heartbeat:Connect(tick)

	Net.event("Scores").OnClientEvent:Connect(function()
		task.defer(renderScores) -- State updates first
	end)
	Net.event("RoundResults").OnClientEvent:Connect(showResults)
	Net.event("Notify").OnClientEvent:Connect(function(text)
		Hud.toast(text)
	end)

	Net.event("Fail").OnClientEvent:Connect(function(userId: number, cause: string, killerId: number?)
		local who = nameOf(userId)
		local text
		local def = Objects.ById[cause]
		if def and killerId then
			if killerId == userId then
				text = who .. " fell for their own " .. def.name
			else
				local verb = CAUSE[cause] or "got wrecked by"
				text = who .. " " .. verb .. " " .. nameOf(killerId) .. "'s " .. def.name
			end
		else
			text = who .. " " .. (CAUSE[cause] or "got taken out")
		end
		feed(text, U.Bad)
		if cause == "fall" then
			Sound.play("splash", 0.1)
		end
		if userId == player.UserId then
			Sound.play("fail", 0.1)
		end
	end)

	Net.event("Finish").OnClientEvent:Connect(function(userId: number, place: number)
		local suffix = ({ "1st", "2nd", "3rd" })[place] or (place .. "th")
		feed(nameOf(userId) .. " reached the flag (" .. suffix .. ")", U.Good)
		local who = Players:GetPlayerByUserId(userId)
		local root = who and who.Character and who.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			Fx.confetti(root.Position)
		end
		if userId == player.UserId then
			banner("Made it!", suffix, 1.2, 48)
			Sound.play("victory")
		else
			Sound.play("goal", 0.1)
		end
	end)

	onPhase(State.phase)
end

return Hud
]]></ProtectedString></Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX21F777849FDD4929B5F87CCD8D19B392">
          <Properties><string name="Name">MenuController</string><ProtectedString name="Source"><![CDATA[-- Main menu + party screen. Shown over the live level drifting by behind it.
--
-- Public server: PLAY joins the next round. CREATE PARTY makes a private room
-- with a 5-letter code. JOIN WITH CODE hops into a friend's room.
-- Party server : the code, who's here, INVITE, and START (host only).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Shared = ReplicatedStorage.Shared
local Characters = require(Shared.Characters)
local Net = require(Shared.Net)
local Style = require(Shared.Style)

local Camera = require(script.Parent.CameraController)
local Hud = require(script.Parent.HudController)
local Sound = require(script.Parent.SoundController)
local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local U = Style.UI
local F = Style.Font
local LobbyFn = Net.func("Lobby")
local player = Players.LocalPlayer

local Menu = {}

local gui: ScreenGui
local column: Frame
local content: Frame
local message: TextLabel
local visible = false
local busy = false
local renderedKey = ""

local function call(action: string, arg: any?): boolean
	if busy then
		return false
	end
	busy = true
	local ok, result = pcall(function()
		return LobbyFn:InvokeServer(action, arg)
	end)
	busy = false
	if not ok or typeof(result) ~= "table" then
		Menu.say("Something went wrong. Try again.", true)
		return false
	end
	if not result.ok then
		Menu.say(result.err or "Couldn't do that", true)
		Sound.play("error")
		return false
	end
	return true
end

function Menu.say(text: string, bad: boolean?)
	message.Text = text
	message.TextColor3 = if bad then U.Bad else U.InkSoft
	message.TextTransparency = 0
	local t = os.clock()
	message:SetAttribute("T", t)
	task.delay(3.5, function()
		if message:GetAttribute("T") == t then
			UI.tween(message, 0.3, { TextTransparency = 1 })
		end
	end)
end

--------------------------------------------------------------------------
-- Building blocks
--------------------------------------------------------------------------

local function button(text: string, sub: string?, primary: boolean, order: number, onClick: () -> ()): TextButton
	local b = UI.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = if primary then U.Accent else U.Paper,
		Size = UDim2.new(1, -8, 0, if sub then 58 else 48),
		LayoutOrder = order,
		Parent = content,
	}, { UI.corner(14) })
	if not primary then
		UI.new("UIStroke", { Color = U.Ink, Transparency = 0.8, Thickness = 2, Parent = b })
	end
	UI.label({
		Text = text,
		FontFace = F.Title,
		TextSize = if primary then 24 else 19,
		TextColor3 = if primary then U.Paper else U.Ink,
		Position = UDim2.fromOffset(18, if sub then 8 else 12),
		Parent = b,
	})
	if sub then
		UI.label({
			Text = sub,
			TextSize = 13,
			TextColor3 = if primary then U.Paper else U.Muted,
			TextTransparency = if primary then 0.15 else 0,
			Position = UDim2.fromOffset(18, 34),
			Parent = b,
		})
	end
	UI.pressable(b, function()
		Sound.play("pick")
		onClick()
	end)
	return b
end

local function heading(text: string, order: number)
	UI.label({ Text = text, FontFace = F.Bold, TextSize = 13, TextColor3 = U.Muted, LayoutOrder = order, Parent = content })
end

local function animalPicker(order: number)
	heading("YOUR ANIMAL", order)
	local row = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 74),
		LayoutOrder = order + 1,
		Parent = content,
	}, { UI.list(Enum.FillDirection.Horizontal, 8) })
	local mine = State.speciesOf[player.UserId]
	for i, s in Characters.List do
		local tile = UI.new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = U.PaperShade,
			Size = UDim2.fromOffset(70, 74),
			LayoutOrder = i,
			Parent = row,
		}, { UI.corner(12) })
		local stroke = UI.new("UIStroke", { Color = U.Accent, Thickness = if s.id == mine then 3 else 0, Parent = tile })
		local vp = UI.new("ViewportFrame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, -16),
			Ambient = Color3.fromRGB(180, 176, 170),
			LightColor = Color3.fromRGB(255, 250, 240),
			LightDirection = Vector3.new(-0.5, -1, 0.4),
			Parent = tile,
		})
		local model = Characters.build(s.id)
		model.Parent = vp
		local cam = Instance.new("Camera")
		cam.FieldOfView = 30
		cam.Parent = vp
		vp.CurrentCamera = cam
		local cf = (model.PrimaryPart :: BasePart).CFrame
		-- three-quarter view of the face (faces point toward local -Z)
		cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(6, 2.2, -8), cf.Position + Vector3.new(0, 0.2, 0))
		UI.label({
			Text = s.name,
			FontFace = F.Bold,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -3),
			Parent = tile,
		})
		UI.pressable(tile, function()
			Sound.play("pick")
			if call("species", s.id) then
				stroke.Thickness = 3
			end
		end)
	end
end

local function codeEntry(order: number)
	local row = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 48),
		LayoutOrder = order,
		Parent = content,
	})
	local box = UI.new("TextBox", {
		Text = "",
		PlaceholderText = "ROOM CODE",
		ClearTextOnFocus = false,
		FontFace = F.Title,
		TextSize = 22,
		TextColor3 = U.Ink,
		PlaceholderColor3 = U.Muted,
		BackgroundColor3 = U.Paper,
		Size = UDim2.new(1, -86, 1, 0),
		Parent = row,
	}, { UI.corner(14), UI.new("UIStroke", { Color = U.Ink, Transparency = 0.8, Thickness = 2 }) })
	box:GetPropertyChangedSignal("Text"):Connect(function()
		local clean = box.Text:upper():gsub("[^%w]", ""):sub(1, 5)
		if clean ~= box.Text then
			box.Text = clean
		end
	end)
	local go = UI.new("TextButton", {
		Text = "Join",
		FontFace = F.Title,
		TextSize = 19,
		TextColor3 = U.Paper,
		BackgroundColor3 = U.InkSoft,
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 78, 1, 0),
		Parent = row,
	}, { UI.corner(14) })
	local function submit()
		if #box.Text ~= 5 then
			Menu.say("Codes are 5 letters", true)
			return
		end
		Menu.say("Joining " .. box.Text .. "...")
		call("join", box.Text)
	end
	UI.pressable(go, submit)
	box.FocusLost:Connect(function(enter)
		if enter then
			submit()
		end
	end)
end

--------------------------------------------------------------------------
-- Screens
--------------------------------------------------------------------------

local function clear()
	for _, c in content:GetChildren() do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
end

local function publicScreen()
	clear()
	button("Play", "Jump into the next round", true, 1, function()
		if call("play") then
			Sound.play("go")
		end
	end)
	button("Create party", "Private room with a code for friends", false, 2, function()
		Menu.say("Creating your party...")
		call("create")
	end)
	heading("HAVE A CODE?", 3)
	codeEntry(4)
	animalPicker(5)
end

local function partyScreen()
	clear()
	local L = State.lobby
	local isHost = L.hostId == player.UserId

	heading("PARTY CODE", 1)
	UI.label({
		Text = (L.code or "-----"):gsub(".", "%0 "):sub(1, -2),
		FontFace = F.Title,
		TextSize = 44,
		TextColor3 = U.Accent,
		LayoutOrder = 2,
		Parent = content,
	})
	UI.label({ Text = "Friends type this in to join you", TextSize = 13, TextColor3 = U.Muted, LayoutOrder = 3, Parent = content })

	heading("IN THE PARTY (" .. #L.members .. ")", 4)
	local list = UI.new("Frame", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 5,
		Parent = content,
	}, { UI.list(Enum.FillDirection.Vertical, 4) })
	for i, m in L.members do
		local row = UI.new("Frame", {
			BackgroundColor3 = U.PaperShade,
			Size = UDim2.new(1, 0, 0, 32),
			LayoutOrder = i,
			Parent = list,
		}, { UI.corner(9) })
		local s = m.species and Characters.ById[m.species]
		UI.new("Frame", {
			BackgroundColor3 = if s then s.body else U.Muted,
			Size = UDim2.fromOffset(14, 14),
			Position = UDim2.fromOffset(10, 9),
			Parent = row,
		}, { UI.corner(7) })
		UI.label({ Text = m.name, FontFace = F.Bold, TextSize = 15, Position = UDim2.fromOffset(32, 6), Parent = row })
		if m.userId == L.hostId then
			local tag = UI.pill("HOST", U.Gold, U.Ink, 11)
			tag.AnchorPoint = Vector2.new(1, 0.5)
			tag.Position = UDim2.new(1, -8, 0.5, 0)
			tag.Parent = row
		end
	end

	if isHost then
		button("Start match", "Everyone here plays", true, 6, function()
			if call("start") then
				Sound.play("go")
			end
		end)
	else
		UI.label({ Text = "Waiting for the host to start...", FontFace = F.Bold, TextSize = 15, TextColor3 = U.InkSoft, LayoutOrder = 6, Parent = content })
	end
	button("Invite friends", nil, false, 7, function()
		local ok = pcall(function()
			if not SocialService:CanSendGameInviteAsync(player) then
				error("can't invite")
			end
			local options = Instance.new("ExperienceInviteOptions")
			options.PromptMessage = "Join my Chaos Course party!"
			options.LaunchData = L.code or ""
			SocialService:PromptGameInvite(player, options)
		end)
		if not ok then
			Menu.say("Invites aren't available here. Share the code instead!", true)
		end
	end)
	animalPicker(8)
	local leave = button("Leave party", nil, false, 10, function()
		Menu.say("Heading back...")
		call("leave")
	end)
	leave.Size = UDim2.new(1, 0, 0, 40)
end

--------------------------------------------------------------------------

local function shouldShow(): boolean
	local L = State.lobby
	if L.mode == "party" then
		return not L.inMatch
	end
	return not State.queued()
end

local function refresh()
	local show = shouldShow()
	local L = State.lobby
	-- only rebuild when something visible actually changed
	local key = L.mode .. tostring(L.code) .. tostring(L.hostId) .. #L.members .. tostring(State.speciesOf[player.UserId])
	for _, m in L.members do
		key ..= m.name .. tostring(m.species)
	end
	if show and key ~= renderedKey then
		renderedKey = key
		if L.mode == "party" then
			partyScreen()
		else
			publicScreen()
		end
	end

	if show ~= visible then
		visible = show
		Camera.menuOpen = show
		Hud.setVisible(not show)
		if show then
			gui.Enabled = true
			column.Position = UDim2.new(0, -460, 0.5, 0)
			UI.tween(column, 0.45, { Position = UDim2.new(0, 48, 0.5, 0) }, Enum.EasingStyle.Back)
		else
			UI.tween(column, 0.3, { Position = UDim2.new(0, -460, 0.5, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			task.delay(0.3, function()
				if not visible then
					gui.Enabled = false
				end
			end)
		end
	end
end

local function buildGui()
	gui = UI.new("ScreenGui", {
		Name = "Menu",
		ResetOnSpawn = false,
		DisplayOrder = 10,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local scale = UI.new("UIScale", { Parent = gui })
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(vp.Y / 860, 0.6, 1.15)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	local holder, face = UI.card({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, -460, 0.5, 0),
		Size = UDim2.fromOffset(400, 680),
		Parent = gui,
	}, 22)
	column = holder

	-- Logo: two words, slight tilt, hard shadow. No gradients, no glow.
	local logo = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(340, 120),
		Position = UDim2.fromOffset(30, 22),
		Rotation = -3,
		Parent = face,
	})
	for _, spec in { { "Chaos", U.Accent, 0 }, { "Course", U.Ink, 54 } } do
		UI.label({ Text = spec[1], FontFace = F.Title, TextSize = 60, TextColor3 = U.Ink, TextTransparency = 0.85, Position = UDim2.fromOffset(3, spec[3] + 4), Parent = logo })
		UI.label({ Text = spec[1], FontFace = F.Title, TextSize = 60, TextColor3 = spec[2], Position = UDim2.fromOffset(0, spec[3]), Parent = logo })
	end
	local dots = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(200, 14),
		Position = UDim2.fromOffset(34, 150),
		Parent = face,
	}, { UI.list(Enum.FillDirection.Horizontal, 6) })
	for _, s in Characters.List do
		UI.new("Frame", { BackgroundColor3 = s.body, Size = UDim2.fromOffset(14, 14), Parent = dots }, { UI.corner(7) })
	end
	UI.label({
		Text = "Build the course. Ruin it for your friends. Race it.",
		TextSize = 14,
		TextColor3 = U.Muted,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.None,
		Size = UDim2.fromOffset(340, 20),
		Position = UDim2.fromOffset(32, 172),
		Parent = face,
	})

	content = UI.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(30, 206),
		Size = UDim2.new(1, -52, 1, -250),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = U.Muted,
		Parent = face,
	}, { UI.list(Enum.FillDirection.Vertical, 10), UI.pad(2, 4) })

	message = UI.label({
		Text = "",
		FontFace = F.Bold,
		TextSize = 14,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.None,
		Size = UDim2.new(1, -60, 0, 32),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 30, 1, -12),
		Parent = face,
	})
end

function Menu.init()
	buildGui()
	-- wait for the loading screen to finish (or give up after a while)
	local waited = 0
	while not player:GetAttribute("Loaded") and waited < 12 do
		waited += task.wait(0.1)
	end
	State.lobbyChanged:Connect(refresh)
	refresh()
end

return Menu
]]></ProtectedString></Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX037DEF5081FB40AF9AFA0D6639F10039">
          <Properties><string name="Name">MovementController</string><ProtectedString name="Source"><![CDATA[-- The feel of the game lives here.
--
-- We keep Roblox's own ControlModule (so keyboard, gamepad and the mobile
-- thumbstick + jump button all work for free) but override what it does
-- with the input each frame:
--   * movement is locked to the X axis (2.5D)
--   * coyote time + jump buffering so jumps never feel "eaten"
--   * one air jump ("flap"), refilled on landing or on a wall jump
--   * wall slide + wall jump when you push into a wall in the air
--   * ice keeps your momentum, honey slows you and kills the flap
--   * launch(): springs, hammers, cannons hand us a velocity and we hold
--     its horizontal speed for a moment so the humanoid can't cancel it

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local State = require(script.Parent.State)
local Sound = require(script.Parent.SoundController)

local M = Config.Movement
local player = Players.LocalPlayer

local Movement = {}
Movement.enabled = false
Movement.windX = 0 -- horizontal push from fans this frame, set by ObjectController

local airJumpEvent = Instance.new("BindableEvent")
Movement.airJumped = airJumpEvent.Event

local root: BasePart?
local hum: Humanoid?
local controls: any

local inputX = 0
local grounded = false
local lastGrounded = 0
local jumpedSinceGround = false
local lastJumpReq = 0
local bufferedAt = -1
local airJumps = M.AirJumps
local launchUntil = 0
local launchVX = 0
local lastWallDir = 0
local wallUntil = 0
local surface: string? = nil
local lastSurface: string? = nil
local iceVX = 0
local peakFall = 0

local rayParams = RaycastParams.new()
rayParams.CollisionGroup = "Players" -- skips every character's hitbox

local function canMove(): boolean
	return Movement.enabled and root ~= nil and hum ~= nil and not (root :: BasePart).Anchored and not (hum :: Humanoid).PlatformStand
end

function Movement.launch(v: Vector3, lock: number)
	if not root then
		return
	end
	root.AssemblyLinearVelocity = Vector3.new(v.X, v.Y, 0)
	if lock > 0 then
		launchVX = v.X
		launchUntil = os.clock() + lock
	end
	jumpedSinceGround = true
end

function Movement.root(): BasePart?
	return root
end

local function setCharacter(c: Model)
	root = c:WaitForChild("HumanoidRootPart") :: BasePart
	hum = c:WaitForChild("Humanoid") :: Humanoid
	local h = hum :: Humanoid
	for _, st in {
		Enum.HumanoidStateType.Climbing,
		Enum.HumanoidStateType.Swimming,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Seated,
	} do
		h:SetStateEnabled(st, false)
	end
	h.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping and canMove() then
			jumpedSinceGround = true
			Sound.play("jump", 0.1)
		end
	end)
end

local function onLand(now: number)
	if now - bufferedAt <= M.JumpBuffer and hum then
		hum.Jump = true
	end
	bufferedAt = -1
	if peakFall > 40 then
		Sound.play("land", 0.15)
	end
	peakFall = 0
end

-- Runs right after the ControlModule, so our Move() call wins.
local function control(dt: number)
	if not hum or not root then
		return
	end
	local mv = controls and controls:GetMoveVector() or Vector3.zero
	local x = mv.X
	local ax = math.abs(x)
	if ax < 0.2 then
		x = 0
	elseif ax > 0.6 then
		x = math.sign(x)
	else
		x = math.sign(x) * (ax - 0.2) / 0.4
	end
	inputX = x

	if not canMove() then
		hum:Move(Vector3.zero)
		return
	end

	local honey = surface == "honey"
	local speed = M.WalkSpeed * (if honey then M.HoneySpeed else 1)
	hum.JumpPower = M.JumpPower * (if honey then M.HoneyJump else 1)

	local target: number
	if os.clock() < launchUntil then
		target = launchVX
	elseif surface == "ice" and grounded then
		local goal = x * speed + Movement.windX
		iceVX += (goal - iceVX) * math.min(1, dt * M.IceAccel)
		target = iceVX
	else
		target = x * speed + Movement.windX
		iceVX = root.AssemblyLinearVelocity.X
	end

	if math.abs(target) < 0.05 then
		hum.WalkSpeed = speed
		hum:Move(Vector3.zero)
	else
		hum.WalkSpeed = math.abs(target)
		hum:Move(Vector3.new(math.sign(target), 0, 0))
	end
end

local function physics()
	if not root or not hum then
		return
	end
	if root.Anchored then
		hum.PlatformStand = false
		return
	end

	-- 2.5D lock
	local p = root.Position
	if math.abs(p.Z) > 0.001 then
		root.CFrame -= Vector3.new(0, 0, p.Z)
	end
	local v = root.AssemblyLinearVelocity
	if v.Z ~= 0 then
		v = Vector3.new(v.X, v.Y, 0)
		root.AssemblyLinearVelocity = v
	end
	if not canMove() then
		return
	end

	local now = os.clock()
	local onFloor = hum.FloorMaterial ~= Enum.Material.Air
	if onFloor then
		if not grounded then
			onLand(now)
		end
		lastGrounded = now
		airJumps = M.AirJumps
		jumpedSinceGround = false
		local hit = workspace:Raycast(p, Vector3.new(0, -3.6, 0), rayParams)
		surface = if hit then hit.Instance:GetAttribute("Surface") :: string? else nil
		lastSurface = surface
	else
		surface = nil
		peakFall = math.max(peakFall, -v.Y)
	end
	grounded = onFloor

	-- Wall slide: only while pushing into a wall in the air
	if not onFloor and inputX ~= 0 then
		local dir = math.sign(inputX)
		local hit = workspace:Raycast(p, Vector3.new(dir * 1.5, 0, 0), rayParams)
		if hit and hit.Instance.CanCollide and math.abs(hit.Normal.X) > 0.7 then
			lastWallDir = dir
			wallUntil = now + 0.1
			if v.Y < -M.WallSlideSpeed then
				root.AssemblyLinearVelocity = Vector3.new(v.X, -M.WallSlideSpeed, 0)
			end
		end
	end
end

local function onJumpRequest()
	local now = os.clock()
	local fresh = now - lastJumpReq > 0.08 -- JumpRequest repeats while held; only new presses count
	lastJumpReq = now
	if not fresh or not canMove() or grounded or not root then
		return
	end
	local v = root.AssemblyLinearVelocity
	if now < wallUntil and lastWallDir ~= 0 then
		local away = -lastWallDir
		Movement.launch(Vector3.new(away * M.WallJumpPower.X, M.WallJumpPower.Y, 0), M.WallJumpLock)
		airJumps = M.AirJumps
		wallUntil = 0
		Sound.play("jump", 0.1)
	elseif now - lastGrounded <= M.CoyoteTime and not jumpedSinceGround then
		root.AssemblyLinearVelocity = Vector3.new(v.X, M.JumpPower, 0)
		jumpedSinceGround = true
		Sound.play("jump", 0.1)
	elseif airJumps > 0 and lastSurface ~= "honey" then
		airJumps -= 1
		root.AssemblyLinearVelocity = Vector3.new(v.X, M.AirJumpPower, 0)
		jumpedSinceGround = true
		Sound.play("airJump", 0.1)
		airJumpEvent:Fire()
	else
		bufferedAt = now
	end
end

local function tumble()
	if not root or not hum or root.Anchored then
		return
	end
	local facing = if root.CFrame.LookVector.X >= 0 then 1 else -1
	hum.PlatformStand = true
	root.AssemblyLinearVelocity = Vector3.new(-facing * 14, 40, 0)
	root.AssemblyAngularVelocity = Vector3.new(0, 0, facing * 12)
end

local function refreshEnabled()
	local was = Movement.enabled
	Movement.enabled = State.me == "running" and State.phase == "Run"
	if Movement.enabled and not was then
		launchUntil = 0
		airJumps = M.AirJumps
		bufferedAt = -1
		peakFall = 0
		if hum then
			hum.PlatformStand = false
		end
	end
end

function Movement.init()
	local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
	controls = playerModule:GetControls()

	if player.Character then
		task.spawn(setCharacter, player.Character)
	end
	player.CharacterAdded:Connect(setCharacter)

	RunService:BindToRenderStep("SprintControl", Enum.RenderPriority.Input.Value + 1, control)
	RunService.PreSimulation:Connect(physics)
	UserInputService.JumpRequest:Connect(onJumpRequest)

	State.phaseChanged:Connect(refreshEnabled)
	State.meChanged:Connect(function(me)
		refreshEnabled()
		if me == "dead" then
			tumble()
		end
	end)
end

return Movement
]]></ProtectedString></Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXDE331F2960FA47EBBFDAD508C9BE0B29">
          <Properties><string name="Name">ObjectController</string><ProtectedString name="Source"><![CDATA[-- Brings placed objects to life on the client.
--
-- All motion (saws, fans, hammers, shuttles, cannonballs) is computed from the
-- shared server clock, so every player sees the same thing at the same time
-- without the server streaming positions. That's cheaper and smoother.
--
-- Effects that push *your* character (springs, fans, hammers, cannonballs)
-- are applied here too, because your client owns your physics and these
-- must feel instant. Deadly contact is still decided by the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Objects = require(Shared.Objects)
local Style = require(Shared.Style)

local Movement = require(script.Parent.MovementController)
local Camera = require(script.Parent.CameraController)
local Sound = require(script.Parent.SoundController)
local Fx = require(script.Parent.FxController)

local C = Config.Objects
local TAU = math.pi * 2

local ObjectController = {}

type Animated = { part: BasePart, rel: CFrame }
type Record = {
	model: Model,
	id: string,
	pivot: CFrame,
	placedAt: number,
	groups: { [string]: { Animated } },
	ready: boolean,
	-- per-type scratch
	padPush: number?,
	cooldown: number?,
	headPrevX: number?,
	maxDist: number?,
	consumed: { [number]: boolean }?,
}

type Bird = { body: Part, left: Part, right: Part, speed: number, offset: number, y: number, z: number }
local birds = {} :: { Bird }

local records = {} :: { [Model]: Record }
local NONE = {} :: { Animated }
local balls = {} :: { BasePart }
local ballFolder: Folder

local function now(): number
	return workspace:GetServerTimeNow()
end

local function register(model: Model)
	local id = model:GetAttribute("Id") :: string?
	if not id or records[model] then
		return
	end
	-- Rebuild the exact placement frame from the server's attributes rather
	-- than trusting the replicated pivot.
	local x, y, r = model:GetAttribute("X"), model:GetAttribute("Y"), model:GetAttribute("Rot")
	local pivot = if typeof(x) == "number" and typeof(y) == "number" and typeof(r) == "number"
		then Objects.cframe(x, y, r)
		else model:GetPivot()
	local rec: Record = {
		model = model,
		id = id,
		pivot = pivot,
		placedAt = (model:GetAttribute("PlacedAt") :: number?) or now(),
		groups = {},
		ready = false,
	}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local g = d:GetAttribute("Group") :: string?
			if g then
				rec.groups[g] = rec.groups[g] or {}
				table.insert(rec.groups[g], { part = d, rel = pivot:ToObjectSpace(d.CFrame) })
			end
		end
	end
	records[model] = rec
	for _, a in rec.groups.bumper or NONE do
		a.part:SetAttribute("BaseSize", a.part.Size)
	end

	-- Placement pop: quick overshoot so it feels like the object "lands"
	Sound.playAt("place", model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart") :: BasePart, 0.15)
	local scale = Instance.new("NumberValue")
	scale.Value = 0.5
	local conn = scale.Changed:Connect(function(v)
		if model.Parent then
			model:ScaleTo(math.max(v, 0.05))
		end
	end)
	local tween = TweenService:Create(scale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = 1 })
	tween.Completed:Once(function()
		conn:Disconnect()
		if model.Parent then
			model:ScaleTo(1)
		end
		rec.ready = true
	end)
	tween:Play()
end

local function setGroup(rec: Record, name: string, offset: CFrame, velocity: Vector3?)
	local g = rec.groups[name]
	if not g then
		return
	end
	for _, a in g do
		a.part.CFrame = rec.pivot * offset * a.rel
		if velocity then
			a.part.AssemblyLinearVelocity = velocity
		end
	end
end

--------------------------------------------------------------------------
-- Cannonballs (deterministic from the clock, pooled parts)
--------------------------------------------------------------------------

local function ball(i: number): BasePart
	local b = balls[i]
	if not b then
		b = Instance.new("Part")
		b.Shape = Enum.PartType.Ball
		b.Size = Vector3.new(1.4, 1.4, 1.4)
		b.Color = Style.Object.Rubber
		b.Material = Enum.Material.SmoothPlastic
		b.Anchored = true
		b.CanCollide = false
		b.CanQuery = false
		b.CanTouch = false
		b.Parent = ballFolder
		balls[i] = b
	end
	return b
end

local function cannonRange(rec: Record): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local list = {}
	local level = workspace:FindFirstChild("Level")
	local objects = workspace:FindFirstChild("Objects")
	if level then
		table.insert(list, level)
	end
	if objects then
		table.insert(list, objects)
	end
	params.FilterDescendantsInstances = list
	local dir = rec.pivot.RightVector
	local origin = rec.pivot * Vector3.new(1.9, 0.3, 0)
	local best = 90
	-- ignore our own parts by stepping past them
	local hit = workspace:Raycast(origin + dir * 0.2, dir * best, params)
	while hit and hit.Instance:IsDescendantOf(rec.model) do
		origin = hit.Position + dir * 0.05
		hit = workspace:Raycast(origin, dir * best, params)
	end
	if hit and hit.Instance.CanCollide then
		return (hit.Position - (rec.pivot * Vector3.new(1.9, 0.3, 0))).Magnitude
	end
	return best
end

--------------------------------------------------------------------------
-- Per-frame
--------------------------------------------------------------------------

local function inBox(rel: Vector3, hx: number, hy: number): boolean
	return math.abs(rel.X) <= hx and math.abs(rel.Y) <= hy and math.abs(rel.Z) <= 4
end

local function visuals(dt: number)
	local t = now()
	local ballIndex = 0
	local root = Movement.root()
	local canAffect = Movement.enabled and root ~= nil and not (root :: BasePart).Anchored

	for model, rec in records do
		if not model.Parent then
			records[model] = nil
			continue
		end
		if not rec.ready then
			continue
		end
		local age = t - rec.placedAt
		local id = rec.id

		if id == "saw" then
			setGroup(rec, "spin", CFrame.Angles(0, 0, -age * 7))
		elseif id == "fan" then
			setGroup(rec, "fan", CFrame.Angles(0, age * 16, 0))
			local g = rec.groups.wind
			if g then
				for i, a in g do
					local y = 1.5 + ((age * 14 + i * 5.1) % 14)
					a.part.CFrame = rec.pivot * CFrame.new(a.rel.Position.X, y, a.rel.Position.Z)
				end
			end
		elseif id == "hammer" then
			local angle = math.rad(65) * math.sin(age * TAU / 2.4)
			setGroup(rec, "arm", CFrame.Angles(0, 0, angle))
			if canAffect and root then
				local head: Animated? = nil
				for _, a in rec.groups.arm or NONE do
					if a.part.Name == "Head" then
						head = a
					end
				end
				if head then
					local hx = head.part.Position.X
					local vx = hx - (rec.headPrevX or hx)
					rec.headPrevX = hx
					local rel = head.part.CFrame:PointToObjectSpace(root.Position)
					if inBox(rel, 1.6 + 0.9, 1 + 1.2) and os.clock() > (rec.cooldown or 0) then
						rec.cooldown = os.clock() + 0.7
						local dir = if math.abs(vx) > 0.001 then math.sign(vx) else math.sign(root.Position.X - hx)
						Movement.launch(Vector3.new(dir * C.HammerKnock.X, C.HammerKnock.Y, 0), 0.4)
						Sound.play("bonk", 0.1)
						Camera.shake(1.2)
					end
				end
			end
		elseif id == "cannon" then
			rec.maxDist = rec.maxDist or cannonRange(rec)
			rec.consumed = rec.consumed or {}
			local dir = rec.pivot.RightVector
			local muzzle = rec.pivot * Vector3.new(1.9, 0.3, 0)
			local life = (rec.maxDist :: number) / C.CannonSpeed
			local since = age - 1
			if since > 0 then
				local newest = math.floor(since / C.CannonInterval)
				local oldest = math.max(0, math.floor((since - life) / C.CannonInterval))
				for k = oldest, newest do
					local bAge = since - k * C.CannonInterval
					if bAge >= 0 and bAge <= life and not (rec.consumed :: any)[k] then
						if bAge < dt * 1.5 then
							Sound.playAt("cannon", rec.model.PrimaryPart or rec.model:FindFirstChildWhichIsA("BasePart") :: BasePart, 0.1)
						end
						ballIndex += 1
						local pos = muzzle + dir * (bAge * C.CannonSpeed)
						local b = ball(ballIndex)
						b.CFrame = CFrame.new(pos)
						b.Transparency = 0
						if canAffect and root and (root.Position - pos).Magnitude < 2.1 then
							(rec.consumed :: any)[k] = true
							local knock = dir * C.CannonKnock.X + Vector3.new(0, C.CannonKnock.Y, 0)
							Movement.launch(knock, 0.35)
							Sound.play("bonk", 0.1)
							Camera.shake(1)
						end
					end
				end
			end
		elseif id == "laser" then
			local g = rec.groups.beam
			local beam = g and g[1]
			if beam then
				-- re-measure now and then; pieces can be bombed away mid-match
				if not rec.maxDist or (rec.cooldown or 0) < os.clock() then
					rec.maxDist = Objects.laserLength(model, rec.pivot)
					rec.cooldown = os.clock() + 0.5
				end
				local len = rec.maxDist :: number
				local state = Objects.laserState(age)
				local thick = if state == "on" then 0.4 else 0.1
				beam.part.Size = Vector3.new(len, thick, thick)
				beam.part.CFrame = rec.pivot * CFrame.new(1 + len / 2, 0, 0)
				if state == "on" then
					beam.part.Transparency = 0.05
				elseif state == "warn" then
					beam.part.Transparency = if math.floor(age * 16) % 2 == 0 then 0.4 else 0.85
				else
					beam.part.Transparency = 1
				end
			end
		elseif id == "trapdoor" then
			local open = Objects.trapdoorOpen(age)
			-- doors swing down on their outer hinges
			local angle = if open then math.rad(85) else 0
			-- (negative Z rotation drops the left door's inner edge, positive drops the right's)
			setGroup(rec, "doorL", CFrame.new(-2.95, 0, 0) * CFrame.Angles(0, 0, -angle) * CFrame.new(2.95, 0, 0))
			setGroup(rec, "doorR", CFrame.new(2.95, 0, 0) * CFrame.Angles(0, 0, angle) * CFrame.new(-2.95, 0, 0))
			for _, gname in { "doorL", "doorR" } do
				for _, a in rec.groups[gname] or NONE do
					if a.part:GetAttribute("Solid") then
						a.part.CanCollide = not open
					end
				end
			end
		elseif id == "bumper" then
			local push = rec.padPush or 0
			if push > 0 then
				rec.padPush = math.max(0, push - dt * 5)
				local s = 1 + 0.25 * math.sin(push * math.pi)
				for _, a in rec.groups.bumper or NONE do
					a.part.CFrame = rec.pivot * a.rel
					a.part.Size = (a.part:GetAttribute("BaseSize") :: Vector3? or a.part.Size) * s
				end
			end
		elseif id == "spring" then
			local push = rec.padPush or 0
			if push > 0 then
				rec.padPush = math.max(0, push - dt * 4)
				setGroup(rec, "pad", CFrame.new(0, -0.35 * math.sin(push * math.pi), 0))
			end
		elseif id == "crumble" then
			local fallen = model:GetAttribute("Fallen")
			local trig = model:GetAttribute("TriggeredAt") :: number?
			for _, d in model:GetDescendants() do
				if d:IsA("BasePart") then
					d.LocalTransparencyModifier = if fallen then 1 else 0
				end
			end
			if trig and not fallen then
				local shake = CFrame.new((math.random() - 0.5) * 0.15, (math.random() - 0.5) * 0.1, 0)
				model:PivotTo(rec.pivot * shake)
			elseif model:GetPivot() ~= rec.pivot then
				model:PivotTo(rec.pivot)
			end
		end
	end

	for i = ballIndex + 1, #balls do
		balls[i].Transparency = 1
	end

	-- Ambient level life: flag sway, drifting clouds, the odd bird
	local level = workspace:FindFirstChild("Level")
	if level then
		local bmin = level:GetAttribute("BuildMin") :: Vector3?
		local bmax = level:GetAttribute("BuildMax") :: Vector3?
		if bmin and bmax then
			local span = bmax.X - bmin.X + 160
			for _, b in birds do
				local x = bmin.X - 80 + ((t * b.speed + b.offset) % (span * 2))
				local visible = x < bmax.X + 80
				local pos = Vector3.new(x, b.y + math.sin(t * 0.8 + b.offset) * 2, b.z)
				local flap = math.sin(t * 9 + b.offset) * 0.6
				local cf = if visible then CFrame.new(pos) else CFrame.new(0, -500, 0)
				b.body.CFrame = cf
				-- a "V" silhouette that flaps in the plane the camera sees
				b.left.CFrame = cf * CFrame.Angles(0, 0, -(0.45 + flap)) * CFrame.new(-0.55, 0, 0)
				b.right.CFrame = cf * CFrame.Angles(0, 0, 0.45 + flap) * CFrame.new(0.55, 0, 0)
			end
		end
		local flag = level:FindFirstChild("Flag") :: BasePart?
		if flag then
			local base = flag:GetAttribute("Base") :: CFrame?
			if not base then
				flag:SetAttribute("Base", flag.CFrame)
				base = flag.CFrame
			end
			local pole = (base :: CFrame) * CFrame.new(-1.7, 0, 0)
			flag.CFrame = pole * CFrame.Angles(0, math.sin(t * 2.2) * 0.18, 0) * CFrame.new(1.7, 0, 0)
		end
		local decor = level:FindFirstChild("Decor")
		if decor then
			for _, m in decor:GetChildren() do
				if m:IsA("Model") and m:GetAttribute("Group") == "cloud" then
					local base = m:GetAttribute("Base") :: CFrame?
					if not base then
						m:SetAttribute("Base", m:GetPivot())
						base = m:GetPivot()
					end
					local x = ((t * 1.2 + (base :: CFrame).X + 200) % 400) - 200
					m:PivotTo(CFrame.new(x, (base :: CFrame).Y, (base :: CFrame).Z))
				end
			end
		end
	end
end

-- Things that physically carry or push you: run before physics.
local function physicsStep(dt: number)
	local t = now()
	local root = Movement.root()
	local canAffect = Movement.enabled and root ~= nil and not (root :: BasePart).Anchored
	local windX = 0

	for model, rec in records do
		if not model.Parent or not rec.ready then
			continue
		end
		local age = t - rec.placedAt

		if rec.id == "mover" then
			local travel = 10
			local w = TAU / 4.5
			local offset = travel / 2 * math.sin(age * w)
			local speed = travel / 2 * w * math.cos(age * w)
			setGroup(rec, "mover", CFrame.new(offset, 0, 0), rec.pivot.RightVector * speed)
		elseif rec.id == "conveyor" then
			local belt = model:FindFirstChild("Belt") :: BasePart?
			if belt then
				belt.AssemblyLinearVelocity = rec.pivot.RightVector * C.ConveyorSpeed
			end
		end

		if not canAffect or not root then
			continue
		end
		local r = root :: BasePart

		if rec.id == "spring" then
			local rel = rec.pivot:PointToObjectSpace(r.Position)
			local up = rec.pivot.UpVector
			local v = r.AssemblyLinearVelocity
			if math.abs(rel.X) < 2.4 and rel.Y > 0.4 and rel.Y < 3.6 and v:Dot(up) <= 4 and os.clock() > (rec.cooldown or 0) then
				rec.cooldown = os.clock() + 0.3
				rec.padPush = 1
				if up.Y > 0.9 then
					Movement.launch(Vector3.new(v.X, C.SpringPower, 0), 0)
				else
					Movement.launch(up * C.SpringPower, 0.35)
				end
				Sound.play("spring", 0.1)
			end
		elseif rec.id == "bumper" then
			local center = rec.pivot.Position
			local off = r.Position - center
			if off.Magnitude < 1.5 + 1.6 and os.clock() > (rec.cooldown or 0) then
				rec.cooldown = os.clock() + 0.35
				rec.padPush = 1
				local dir = if off.Magnitude > 0.01 then off.Unit else Vector3.yAxis
				local v = dir * C.BumperKnock + Vector3.new(0, 18, 0)
				Movement.launch(v, 0.3)
				Sound.play("bumper", 0.15)
				Fx.ring(center, Style.UI.Paper, 6)
				Camera.shake(0.6)
			end
		elseif rec.id == "fan" then
			local rel = rec.pivot:PointToObjectSpace(r.Position)
			if math.abs(rel.X) < 1.5 + 0.9 and rel.Y > 0 and rel.Y < 16.5 then
				local up = rec.pivot.UpVector
				-- falls off toward the end of the column so the edge is readable
				local strength = 1 - math.clamp((rel.Y - 10) / 6.5, 0, 1) * 0.6
				windX += up.X * 18 * strength
				if math.abs(up.Y) > 0.1 then
					local v = r.AssemblyLinearVelocity
					local target = C.FanMaxSpeed * up.Y * strength
					if (up.Y > 0 and v.Y < target) or (up.Y < 0 and v.Y > target) then
						local a = math.min(1, dt * 3)
						r.AssemblyLinearVelocity = Vector3.new(v.X, v.Y + (target - v.Y) * a, 0)
					end
				end
			end
		end
	end
	Movement.windX = windX
end

local function explode(pos: Vector3)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Style.UI.Paper
	p.Size = Vector3.one
	p.CFrame = CFrame.new(pos)
	p.Parent = ballFolder
	local d = Config.Objects.BombRadius * 2
	local tween = TweenService:Create(p, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(d, d, d),
		Transparency = 1,
	})
	tween.Completed:Once(function()
		p:Destroy()
	end)
	tween:Play()
	Fx.ring(pos, Style.UI.Paper, d)
	Fx.puff(pos, 6, 2)
	Sound.play("poof", 0.1)
	Camera.shake(0.8)
end

function ObjectController.init()
	ballFolder = Instance.new("Folder")
	ballFolder.Name = "ClientFx"
	ballFolder.Parent = workspace

	local function bit(size: Vector3): Part
		local p = Instance.new("Part")
		p.Size = size
		p.Color = Style.UI.InkSoft
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Parent = ballFolder
		return p
	end
	for i = 1, 3 do
		table.insert(birds, {
			body = bit(Vector3.new(0.35, 0.35, 0.35)),
			left = bit(Vector3.new(1.2, 0.14, 0.1)),
			right = bit(Vector3.new(1.2, 0.14, 0.1)),
			speed = 6 + i * 1.5,
			offset = i * 97,
			y = 44 + i * 6,
			z = -45 - i * 8,
		})
	end

	local function watch(folder: Instance)
		for _, m in folder:GetChildren() do
			if m:IsA("Model") then
				task.spawn(register, m)
			end
		end
		folder.ChildAdded:Connect(function(m)
			if m:IsA("Model") then
				-- give replication a frame to deliver the parts
				task.wait()
				register(m)
			end
		end)
	end
	task.spawn(function()
		watch(workspace:WaitForChild("Objects"))
	end)

	RunService.RenderStepped:Connect(visuals)
	RunService.PreSimulation:Connect(physicsStep)
	Net.event("Explode").OnClientEvent:Connect(explode)
end

return ObjectController
]]></ProtectedString></Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX2B8635F51B3B43629EE3E9DBA2339581">
          <Properties><string name="Name">PickController</string><ProtectedString name="Source"><![CDATA[-- The pick box: a crate drops in, pieces pop out onto the table, and
-- everyone grabs one. First click wins. Taken pieces get the grabber's
-- colour and name stamped on them, so you see who snatched what.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Characters = require(Shared.Characters)
local Net = require(Shared.Net)
local Objects = require(Shared.Objects)
local Style = require(Shared.Style)

local Hud = require(script.Parent.HudController)
local Sound = require(script.Parent.SoundController)
local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local U = Style.UI
local F = Style.Font
local W = Style.Forest
local PickEvent = Net.event("Pick")
local player = Players.LocalPlayer

local Pick = {}

type Tile = { button: TextButton, face: Frame, stamp: Frame, stampLabel: TextLabel, stroke: UIStroke, scale: UIScale, taken: number }

local gui: ScreenGui
local crate: Frame?
local tiles = {} :: { Tile }
local myPick: string? = nil

local KIND_COLOR = { route = U.Good, trap = U.Bad, tool = U.Gold }

local function speciesColor(userId: number): Color3
	local s = State.speciesOf[userId]
	local def = s and Characters.ById[s]
	return if def then def.body else U.Muted
end

local function nameOf(userId: number): string
	local p = Players:GetPlayerByUserId(userId)
	return if p then p.DisplayName else "?"
end

local function viewport(parent: Instance, id: string)
	local vp = UI.new("ViewportFrame", {
		BackgroundColor3 = U.PaperShade,
		Size = UDim2.new(1, -12, 0, 78),
		Position = UDim2.fromOffset(6, 6),
		Ambient = Color3.fromRGB(170, 166, 160),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.4, -1, -0.6),
		ZIndex = 3,
		Parent = parent,
	}, { UI.corner(8) })
	local model = Objects.build(id)
	model.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	cam.Parent = vp
	vp.CurrentCamera = cam
	local cf, size = model:GetBoundingBox()
	local extent = math.max(size.X, size.Y * 1.3)
	local d = extent / 2 / math.tan(math.rad(15)) * 1.15 + size.Z / 2
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, size.Y * 0.15, d), cf.Position)
end

local function close()
	if not crate then
		return
	end
	local c = crate
	crate = nil
	table.clear(tiles)
	UI.tween(c, 0.3, { Position = UDim2.new(0.5, 0, -0.6, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(0.35, function()
		c:Destroy()
	end)
end

local function open(items: { any })
	close()
	myPick = nil
	local count = #items
	local cols = math.min(count, 5)
	local rows = math.ceil(count / cols)
	local tileW, tileH, gap = 116, 132, 12
	local width = cols * tileW + (cols - 1) * gap + 48
	local height = rows * tileH + (rows - 1) * gap + 96

	-- The crate: a wooden frame with a darker rim
	local holder = UI.new("Frame", {
		BackgroundColor3 = W.Wood,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, -0.6, 0),
		Size = UDim2.fromOffset(width, height),
		Parent = gui,
	}, { UI.corner(18), UI.new("UIStroke", { Color = W.WoodDark, Thickness = 5 }) })
	crate = holder
	UI.new("Frame", {
		Name = "Shadow",
		BackgroundColor3 = U.Ink,
		BackgroundTransparency = 0.8,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 8),
		ZIndex = 0,
		Parent = holder,
	}, { UI.corner(18) })
	-- plank lines on the crate face
	for i = 1, 3 do
		UI.new("Frame", {
			BackgroundColor3 = W.WoodDark,
			BackgroundTransparency = 0.6,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 2),
			Position = UDim2.new(0, 0, i / 4, 0),
			ZIndex = 1,
			Parent = holder,
		})
	end
	UI.label({
		Text = "Grab a piece!",
		FontFace = F.Title,
		TextSize = 26,
		TextColor3 = U.Paper,
		Position = UDim2.fromOffset(24, 16),
		ZIndex = 2,
		Parent = holder,
	})
	UI.new("UIStroke", { Color = W.WoodDark, Thickness = 2, Parent = holder:FindFirstChildOfClass("TextLabel") })
	UI.label({
		Text = "First come, first served",
		FontFace = F.Bold,
		TextSize = 14,
		TextColor3 = U.Paper,
		TextTransparency = 0.15,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -24, 0, 24),
		ZIndex = 2,
		Parent = holder,
	})

	local grid = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(24, 68),
		Size = UDim2.new(1, -48, 1, -88),
		ZIndex = 2,
		Parent = holder,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(tileW, tileH),
			CellPadding = UDim2.fromOffset(gap, gap),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	for i, item in items do
		local def = Objects.ById[item.id]
		local button = UI.new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			LayoutOrder = i,
			Selectable = true,
			ZIndex = 2,
			Parent = grid,
		})
		local scale = UI.new("UIScale", { Scale = 0, Parent = button })
		local face = UI.new("Frame", {
			BackgroundColor3 = U.Paper,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 2,
			Parent = button,
		}, { UI.corner(12) })
		local stroke = UI.new("UIStroke", { Color = U.Accent, Thickness = 0, Parent = face })
		viewport(face, item.id)
		UI.new("Frame", {
			BackgroundColor3 = KIND_COLOR[def.kind],
			Size = UDim2.fromOffset(10, 10),
			Position = UDim2.fromOffset(10, 94),
			ZIndex = 3,
			Parent = face,
		}, { UI.corner(5) })
		UI.label({
			Text = def.name,
			FontFace = F.Title,
			TextSize = 15,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AutomaticSize = Enum.AutomaticSize.None,
			Size = UDim2.new(1, -30, 0, 20),
			Position = UDim2.fromOffset(24, 89),
			ZIndex = 3,
			Parent = face,
		})
		UI.label({
			Text = def.blurb,
			TextSize = 11,
			TextColor3 = U.Muted,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AutomaticSize = Enum.AutomaticSize.None,
			Size = UDim2.new(1, -16, 0, 16),
			Position = UDim2.fromOffset(8, 110),
			ZIndex = 3,
			Parent = face,
		})

		-- "Taken" stamp, hidden until someone grabs it
		local stamp = UI.new("Frame", {
			BackgroundColor3 = U.Ink,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 5,
			Parent = face,
		}, { UI.corner(12) })
		local stampLabel = UI.label({
			Text = "",
			FontFace = F.Title,
			TextSize = 15,
			TextColor3 = U.Paper,
			BackgroundColor3 = U.Ink,
			BackgroundTransparency = 1,
			TextTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.42),
			Rotation = -8,
			ZIndex = 6,
			Parent = stamp,
		})
		UI.corner(8).Parent = stampLabel
		UI.pad(10, 4).Parent = stampLabel

		local tile: Tile = { button = button, face = face, stamp = stamp, stampLabel = stampLabel, stroke = stroke, scale = scale, taken = 0 }
		tiles[i] = tile

		button.MouseEnter:Connect(function()
			if tile.taken == 0 and not myPick then
				UI.tween(scale, 0.12, { Scale = 1.06 })
				UI.tween(stroke, 0.12, { Thickness = 3 })
				Sound.play("hover")
			end
		end)
		button.MouseLeave:Connect(function()
			UI.tween(scale, 0.12, { Scale = 1 })
			UI.tween(stroke, 0.12, { Thickness = 0 })
		end)
		button.Activated:Connect(function()
			if tile.taken ~= 0 or myPick then
				Sound.play("error")
				return
			end
			UI.tween(scale, 0.06, { Scale = 0.92 })
			PickEvent:FireServer(i)
		end)

		-- pop out of the crate one by one
		task.delay(0.25 + i * 0.07, function()
			UI.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			Sound.play("hover")
		end)
	end

	UI.tween(holder, 0.45, { Position = UDim2.fromScale(0.5, 0.52) }, Enum.EasingStyle.Back)
	Sound.play("crate")
	if UserInputService.GamepadEnabled and tiles[1] then
		task.delay(0.6, function()
			if tiles[1] then
				GuiService.SelectedObject = tiles[1].button
			end
		end)
	end
end

local function update(items: { any })
	for i, item in items do
		local tile = tiles[i]
		if not tile or tile.taken == item.takenBy then
			continue
		end
		tile.taken = item.takenBy
		if item.takenBy == 0 then
			continue
		end
		local mine = item.takenBy == player.UserId
		local color = speciesColor(item.takenBy)
		tile.stamp.BackgroundTransparency = if mine then 0.75 else 0.45
		tile.stampLabel.Text = if mine then "YOURS" else nameOf(item.takenBy)
		tile.stampLabel.BackgroundColor3 = if mine then U.Accent else color
		tile.stampLabel.BackgroundTransparency = 0
		tile.stampLabel.TextTransparency = 0
		tile.stroke.Color = if mine then U.Accent else color
		tile.stroke.Thickness = 3
		-- stamp slams down
		local s = UI.new("UIScale", { Scale = 1.8, Parent = tile.stampLabel })
		UI.tween(s, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
		UI.tween(tile.scale, 0.1, { Scale = 1 })
		if mine then
			myPick = items[i].id
			Sound.play("grab")
		else
			Sound.play("pick", 0.2)
		end
	end
end

function Pick.init()
	gui = UI.new("ScreenGui", {
		Name = "PickBox",
		ResetOnSpawn = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local scale = UI.new("UIScale", { Parent = gui })
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min(vp.Y / 820, vp.X / 900), 0.55, 1.1)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	-- The box arrives just before the "Pick" phase is announced, so open on
	-- the first message and treat every later one as an update.
	Net.event("Box").OnClientEvent:Connect(function(items, pickers: { number })
		if not crate then
			-- only people in this round pick; menu-sitters just watch
			if not table.find(pickers or {}, player.UserId) then
				return
			end
			open(items)
		end
		update(items)
	end)

	State.phaseChanged:Connect(function(phase)
		if phase == "Build" then
			if myPick then
				local def = Objects.ById[myPick]
				Hud.toast("You grabbed: " .. (if def then def.name else myPick))
			end
			close()
		elseif phase ~= "Pick" then
			close()
		end
	end)
end

return Pick
]]></ProtectedString></Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX8D6906EAB98A4709A3CD2335103B4680">
          <Properties><string name="Name">ResultsUI</string><ProtectedString name="Source"><![CDATA[-- The score table: one bar per player racing toward the finish line.
-- Banked points sit in your animal's colour; this round's points slide in
-- category by category (finish, traps, clutch, own route) for everyone at
-- once, each with a rising note. Readable at a glance, satisfying to watch.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Characters = require(Shared.Characters)
local Style = require(Shared.Style)

local Sound = require(script.Parent.SoundController)
local UI = require(script.Parent.UI)

local U = Style.UI
local F = Style.Font

local ResultsUI = {}

local LABELS = { finish = "Finish", trap = "Trap", clutch = "Clutch", route = "Own route" }
local WIDTH = 720
local TRACK_X = 196
local TRACK_W = 430
local ROW_H = 46
local BAR_H = 24

local panel: Frame? = nil
local token = 0

local function speciesColor(species: string?): Color3
	local s = species and Characters.ById[species]
	return if s then s.body else U.Muted
end

function ResultsUI.close()
	token += 1
	if panel then
		local p = panel
		panel = nil
		UI.tween(p, 0.2, { Position = UDim2.new(0.5, 0, 0.5, 40) })
		task.delay(0.2, function()
			p:Destroy()
		end)
	end
end

export type Options = {
	title: string,
	subtitle: string,
	verdict: string?,
	target: number,
	winners: { number }?,
}

-- rows: { userId, name, species, before, items = {{cat,label,points}}, total }
function ResultsUI.show(parent: Instance, rows: { any }, opts: Options)
	ResultsUI.close()
	token += 1
	local myToken = token

	local height = 132 + #rows * ROW_H + 26
	local holder, face = UI.card({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 40),
		Size = UDim2.fromOffset(WIDTH, height),
		Parent = parent,
	}, 18)
	panel = holder
	UI.tween(holder, 0.32, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)

	UI.label({ Text = opts.title, FontFace = F.Title, TextSize = 30, Position = UDim2.fromOffset(26, 18), Parent = face })
	UI.label({ Text = opts.subtitle, TextSize = 14, TextColor3 = U.Muted, Position = UDim2.fromOffset(26, 58), Parent = face })

	-- Legend, top right
	local legend = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -24, 0, 26),
		Size = UDim2.fromOffset(330, 20),
		Parent = face,
	}, { UI.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center) })
	for i, cat in Style.ScoreOrder do
		local item = UI.new("Frame", { BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.new(), LayoutOrder = i, Parent = legend }, {
			UI.list(Enum.FillDirection.Horizontal, 5, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center),
		})
		UI.new("Frame", { BackgroundColor3 = Style.ScoreColor[cat], Size = UDim2.fromOffset(10, 10), Parent = item }, { UI.corner(3) })
		UI.label({ Text = LABELS[cat], TextSize = 12, TextColor3 = U.InkSoft, FontFace = F.Bold, Parent = item })
	end

	local top = 100
	local target = math.max(opts.target, 1)
	local function px(points: number): number
		return math.clamp(points / target, 0, 1) * TRACK_W
	end

	-- Finish line across all rows, with a little flag tag
	local lineH = #rows * ROW_H
	UI.new("Frame", {
		BackgroundColor3 = U.Ink,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(3, lineH + 6),
		Position = UDim2.fromOffset(TRACK_X + TRACK_W, top - 4),
		ZIndex = 4,
		Parent = face,
	})
	local tag = UI.pill("FINISH " .. target, U.Ink, U.Paper, 11)
	tag.AnchorPoint = Vector2.new(0.5, 1)
	tag.Position = UDim2.fromOffset(TRACK_X + TRACK_W + 1, top - 6)
	tag.ZIndex = 4
	tag.Parent = face

	type RowUI = { offset: number, segs: Frame, total: TextLabel, gainedLabel: TextLabel, data: any, line: Frame }
	local rowUIs = {} :: { RowUI }

	for i, row in rows do
		local y = top + (i - 1) * ROW_H
		local mine = row.userId == Players.LocalPlayer.UserId
		local isWinner = opts.winners and table.find(opts.winners, row.userId) ~= nil
		local line = UI.new("Frame", {
			BackgroundColor3 = U.PaperShade,
			BackgroundTransparency = if mine then 0 else 1,
			Size = UDim2.new(1, -24, 0, ROW_H - 6),
			Position = UDim2.fromOffset(12, y),
			Parent = face,
		}, { UI.corner(10) })
		if isWinner then
			UI.new("UIStroke", { Color = U.Gold, Thickness = 3, Parent = line })
		end

		UI.label({ Text = tostring(i), FontFace = F.Title, TextSize = 16, TextColor3 = U.Muted, Position = UDim2.fromOffset(12, 10), Parent = line })
		UI.new("Frame", {
			BackgroundColor3 = speciesColor(row.species),
			Size = UDim2.fromOffset(14, 14),
			Position = UDim2.fromOffset(34, 13),
			Parent = line,
		}, { UI.corner(7) })
		UI.label({
			Text = row.name,
			FontFace = F.Bold,
			TextSize = 15,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AutomaticSize = Enum.AutomaticSize.None,
			Size = UDim2.fromOffset(120, ROW_H - 6),
			Position = UDim2.fromOffset(56, 0),
			Parent = line,
		})

		-- Track + 100-point ticks
		local track = UI.new("Frame", {
			BackgroundColor3 = U.Paper,
			Size = UDim2.fromOffset(TRACK_W, BAR_H),
			Position = UDim2.fromOffset(TRACK_X - 12, (ROW_H - 6 - BAR_H) / 2),
			ClipsDescendants = true,
			Parent = line,
		}, { UI.corner(7), UI.new("UIStroke", { Color = U.Ink, Transparency = 0.85, Thickness = 1 }) })
		for p = 100, target - 1, 100 do
			UI.new("Frame", {
				BackgroundColor3 = U.Ink,
				BackgroundTransparency = 0.9,
				BorderSizePixel = 0,
				Size = UDim2.fromOffset(1, BAR_H),
				Position = UDim2.fromOffset(px(p), 0),
				ZIndex = 3,
				Parent = track,
			})
		end
		local segs = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = track })
		local banked = px(row.before or 0)
		if banked > 0 then
			UI.new("Frame", {
				BackgroundColor3 = speciesColor(row.species),
				BorderSizePixel = 0,
				Size = UDim2.fromOffset(banked, BAR_H),
				ZIndex = 2,
				Parent = segs,
			})
		end

		local total = UI.label({
			Text = tostring(row.before or row.total),
			FontFace = F.Title,
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Right,
			AutomaticSize = Enum.AutomaticSize.None,
			Size = UDim2.fromOffset(52, ROW_H - 6),
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 0),
			Parent = line,
		})
		local gainedLabel = UI.label({
			Text = "",
			FontFace = F.Title,
			TextSize = 14,
			TextColor3 = U.Accent,
			TextTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -66, 0.5, 0),
			Parent = line,
		})
		rowUIs[i] = { offset = banked, segs = segs, total = total, gainedLabel = gainedLabel, data = row, line = line }
	end

	-- Verdict stamp, slammed across the middle
	local function stamp(text: string)
		local s = UI.label({
			Text = text,
			FontFace = F.Title,
			TextSize = 54,
			TextColor3 = U.Bad,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0, top + lineH / 2),
			Rotation = -8,
			ZIndex = 10,
			Parent = face,
		})
		UI.new("UIStroke", { Color = U.Paper, Thickness = 4, Parent = s })
		local sc = UI.new("UIScale", { Scale = 2.6, Parent = s })
		UI.tween(sc, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
		Sound.play("stamp")
	end

	task.spawn(function()
		task.wait(0.45)
		if opts.verdict == "TOO_EASY" then
			stamp("TOO EASY!")
		elseif opts.verdict == "TOO_HARD" then
			stamp("TOO HARD!")
		end

		local pitch = 1
		for _, cat in Style.ScoreOrder do
			local any = false
			for _, r in rowUIs do
				local pts, label = 0, nil
				for _, it in r.data.items or {} do
					if it.cat == cat then
						pts += it.points
						label = it.label
					end
				end
				if pts > 0 then
					any = true
					local w = math.max(px(pts), 3)
					local seg = UI.new("Frame", {
						BackgroundColor3 = Style.ScoreColor[cat],
						BorderSizePixel = 0,
						Size = UDim2.fromOffset(0, BAR_H),
						Position = UDim2.fromOffset(r.offset, 0),
						ClipsDescendants = true,
						ZIndex = 2,
						Parent = r.segs,
					})
					if w > 44 and label then
						UI.label({
							Text = label,
							FontFace = F.Bold,
							TextSize = 12,
							TextColor3 = U.Paper,
							Position = UDim2.fromOffset(6, 4),
							ZIndex = 3,
							Parent = seg,
						})
					end
					UI.tween(seg, 0.35, { Size = UDim2.fromOffset(w, BAR_H) }, Enum.EasingStyle.Back)
					r.offset += w
				end
			end
			if any then
				Sound.play("bar", 0, pitch)
				pitch *= 1.12
				task.wait(0.55)
				if myToken ~= token then
					return
				end
			end
		end

		-- Count totals up and flash what each player gained
		for _, r in rowUIs do
			local from = r.data.before or r.data.total
			local to = r.data.total
			local gained = to - from
			if gained > 0 then
				r.gainedLabel.Text = "+" .. gained
				UI.tween(r.gainedLabel, 0.2, { TextTransparency = 0 })
				task.spawn(function()
					for s = 1, 10 do
						task.wait(0.03)
						if not r.total.Parent then
							return
						end
						r.total.Text = tostring(math.floor(from + gained * s / 10))
					end
				end)
			end
			if to >= target then
				UI.new("UIStroke", { Color = U.Gold, Thickness = 3, Parent = r.line })
			end
		end
		Sound.play("points")
	end)
end

return ResultsUI
]]></ProtectedString></Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX34D5A68E77BF4F3680ABAD2B433602AF">
          <Properties><string name="Name">SoundController</string><ProtectedString name="Source"><![CDATA[-- Every sound in the game goes through here, so swapping in real audio later
-- is a matter of editing this one table.
--
-- PLACEHOLDERS: these are sounds that ship inside the Roblox client.
-- Replace with Creator Store audio ("rbxassetid://123...") before release.

local SoundService = game:GetService("SoundService")

local SOUNDS = {
	jump = { id = "rbxasset://sounds/action_jump.mp3", volume = 0.35, pitch = 1.15 },
	airJump = { id = "rbxasset://sounds/action_jump.mp3", volume = 0.35, pitch = 1.45 },
	land = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.35, pitch = 1.1 },
	spring = { id = "rbxasset://sounds/action_jump.mp3", volume = 0.6, pitch = 0.7 },
	bonk = { id = "rbxasset://sounds/collide.wav", volume = 0.7, pitch = 0.8 },
	fail = { id = "rbxasset://sounds/uuhhh.mp3", volume = 0.45, pitch = 1.05 },
	splash = { id = "rbxasset://sounds/impact_water.mp3", volume = 0.5, pitch = 1 },
	place = { id = "rbxasset://sounds/clickfast.wav", volume = 0.6, pitch = 0.9 },
	pick = { id = "rbxasset://sounds/clickfast.wav", volume = 0.4, pitch = 1.3 },
	error = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.3, pitch = 0.6 },
	tick = { id = "rbxasset://sounds/clickfast.wav", volume = 0.35, pitch = 1.6 },
	go = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5, pitch = 1.2 },
	goal = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6, pitch = 1.5 },
	points = { id = "rbxasset://sounds/clickfast.wav", volume = 0.4, pitch = 2 },
	bar = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.25, pitch = 1.8 },
	stamp = { id = "rbxasset://sounds/collide.wav", volume = 0.45, pitch = 1.3 },
	-- no explosion sound on purpose: the bomb is a soft "poof" (whoosh) only
	poof = { id = "rbxasset://sounds/swoosh.wav", volume = 0.45, pitch = 0.8 },
	cannon = { id = "rbxasset://sounds/clickfast.wav", volume = 0.35, pitch = 0.5 },
	bumper = { id = "rbxasset://sounds/action_jump.mp3", volume = 0.5, pitch = 1.8 },
	whoosh = { id = "rbxasset://sounds/swoosh.wav", volume = 0.4, pitch = 1 },
	grab = { id = "rbxasset://sounds/clickfast.wav", volume = 0.6, pitch = 1.1 },
	crate = { id = "rbxasset://sounds/swoosh.wav", volume = 0.5, pitch = 0.65 },
	hover = { id = "rbxasset://sounds/clickfast.wav", volume = 0.15, pitch = 2.2 },
	victory = { id = "rbxasset://sounds/victory.wav", volume = 0.5, pitch = 1 },
}

local SoundController = {}

local group = Instance.new("SoundGroup")
group.Name = "SFX"
group.Volume = 0.8
group.Parent = SoundService

local templates = {} :: { [string]: Sound }

function SoundController.init()
	for name, def in SOUNDS do
		local s = Instance.new("Sound")
		s.Name = name
		s.SoundId = def.id
		s.Volume = def.volume
		s.PlaybackSpeed = def.pitch
		s.SoundGroup = group
		s.RollOffMaxDistance = 160
		s.RollOffMinDistance = 30
		templates[name] = s
	end
end

-- 2D sound (UI, your own actions). pitch multiplies the base pitch.
function SoundController.play(name: string, pitchJitter: number?, pitch: number?)
	local t = templates[name]
	if not t then
		return
	end
	local s = t:Clone()
	if pitchJitter then
		s.PlaybackSpeed *= 1 + (math.random() - 0.5) * pitchJitter
	end
	if pitch then
		s.PlaybackSpeed *= pitch
	end
	s.Parent = SoundService
	s:Play()
	s.Ended:Once(function()
		s:Destroy()
	end)
	task.delay(4, function()
		if s.Parent then
			s:Destroy()
		end
	end)
end

-- Positional sound (other players, objects)
function SoundController.playAt(name: string, where: BasePart | Attachment, pitchJitter: number?)
	local t = templates[name]
	if not t then
		return
	end
	local s = t:Clone()
	if pitchJitter then
		s.PlaybackSpeed *= 1 + (math.random() - 0.5) * pitchJitter
	end
	s.Parent = where
	s:Play()
	task.delay(4, function()
		s:Destroy()
	end)
end

return SoundController
]]></ProtectedString></Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX42C8C189B06E4E44B3DEF84D298FCA59">
          <Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- Client-side mirror of what the server told us. Read-only for gameplay;
-- the server is always the source of truth.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local State = {}

State.phase = "Waiting"
State.endsAt = 0
State.round = 0
State.rounds = 0
State.final = false
State.level = ""
State.extra = {} :: { [string]: any }
State.runners = {} :: { number }
State.me = "idle" -- idle | running | done | dead
State.standings = {} :: { any }
State.speciesOf = {} :: { [number]: string }

local phaseChanged = Instance.new("BindableEvent")
State.phaseChanged = phaseChanged.Event

local meChanged = Instance.new("BindableEvent")
State.meChanged = meChanged.Event

State.lobby = {
	mode = "public",
	code = nil :: string?,
	hostId = nil :: number?,
	inMatch = false,
	members = {} :: { any },
}
local lobbyChanged = Instance.new("BindableEvent")
State.lobbyChanged = lobbyChanged.Event

function State.queued(): boolean
	for _, m in State.lobby.members do
		if m.userId == Players.LocalPlayer.UserId then
			return m.queued
		end
	end
	return false
end

local localId = Players.LocalPlayer.UserId

local function setMe(v: string)
	if State.me ~= v then
		State.me = v
		meChanged:Fire(v)
	end
end

function State.timeLeft(): number
	return math.max(0, State.endsAt - workspace:GetServerTimeNow())
end

function State.isRunner(userId: number): boolean
	return table.find(State.runners, userId) ~= nil
end

function State.init()
	Net.event("MatchState").OnClientEvent:Connect(function(s)
		State.phase = s.phase
		State.endsAt = s.endsAt
		State.round = s.round
		State.rounds = s.rounds
		State.final = s.final
		State.level = s.level
		State.extra = s.extra or {}
		State.runners = s.runners or {}

		if s.phase == "Countdown" or s.phase == "Run" then
			if State.isRunner(localId) and (s.phase == "Countdown" or State.me == "idle") then
				setMe("running")
			end
		else
			setMe("idle")
		end
		phaseChanged:Fire(s.phase)
	end)

	Net.event("Fail").OnClientEvent:Connect(function(userId)
		if userId == localId then
			setMe("dead")
		end
	end)
	Net.event("Finish").OnClientEvent:Connect(function(userId)
		if userId == localId then
			setMe("done")
		end
	end)
	Net.event("LobbyState").OnClientEvent:Connect(function(lobby)
		State.lobby = lobby
		for _, m in lobby.members do
			State.speciesOf[m.userId] = m.species
		end
		lobbyChanged:Fire()
	end)
	Net.event("Scores").OnClientEvent:Connect(function(standings)
		State.standings = standings
		for _, row in standings do
			State.speciesOf[row.userId] = row.species
		end
	end)
end

return State
]]></ProtectedString></Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXCF042630CFD440B0B2A69EF9FF556246">
          <Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Tiny UI kit so every panel, label and button shares one look:
-- warm paper cards, ink text, a hard offset shadow (no blur, no gradients).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Style = require(ReplicatedStorage.Shared.Style)

local U = Style.UI
local UI = {}

function UI.new(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = props.Parent
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(r: number): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, r) })
end

function UI.pad(px: number, py: number?): UIPadding
	local y = py or px
	return UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, y),
		PaddingBottom = UDim.new(0, y),
	})
end

function UI.list(dir: Enum.FillDirection, gap: number, align: Enum.HorizontalAlignment?, valign: Enum.VerticalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		FillDirection = dir,
		Padding = UDim.new(0, gap),
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		FontFace = Style.Font.Body,
		TextSize = 16,
		TextColor3 = U.Ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(),
	}
	for k, v in props do
		defaults[k] = v
	end
	return UI.new("TextLabel", defaults)
end

-- A card with a hard shadow underneath. Returns (holder, face).
-- Put content in `face`; position/size the holder.
function UI.card(props: { [string]: any }, radius: number?): (Frame, Frame)
	local r = radius or 12
	local holder = UI.new("Frame", { BackgroundTransparency = 1 })
	for k, v in props do
		(holder :: any)[k] = v
	end
	UI.new("Frame", {
		Name = "Shadow",
		BackgroundColor3 = U.Ink,
		BackgroundTransparency = 0.82,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 4),
		ZIndex = 0,
		Parent = holder,
	}, { UI.corner(r) })
	local face = UI.new("Frame", {
		Name = "Face",
		BackgroundColor3 = U.Paper,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
		Parent = holder,
	}, { UI.corner(r) })
	return holder, face
end

function UI.pill(text: string, bg: Color3, fg: Color3?, size: number?): Frame
	local f = UI.new("Frame", {
		BackgroundColor3 = bg,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(),
	}, { UI.corner(99), UI.pad(8, 3) })
	UI.label({ Text = text, FontFace = Style.Font.Bold, TextSize = size or 13, TextColor3 = fg or U.Paper, Parent = f })
	return f
end

function UI.tween(obj: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- Hover lift + press squish, the same on every button
function UI.pressable(button: GuiButton, onClick: () -> ())
	local scale = button:FindFirstChildOfClass("UIScale") or UI.new("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1.04 })
	end)
	button.MouseLeave:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		UI.tween(scale, 0.06, { Scale = 0.95 })
	end)
	button.MouseButton1Up:Connect(function()
		UI.tween(scale, 0.18, { Scale = 1.04 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(onClick)
end

return UI
]]></ProtectedString></Properties>
        </Item>
      </Item>
    </Item>
