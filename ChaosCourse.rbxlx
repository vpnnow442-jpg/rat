    <Item class="LocalScript" referent="RBX91C916E373964F3D9C7987341C9F6D58">
      <Properties><string name="Name">Loading</string><ProtectedString name="Source"><![CDATA[-- Loading screen. Runs before anything else, so it can't use the shared
-- modules yet: colours and fonts are repeated here on purpose.
-- Tips teach the core rule while you wait.

local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local INK = Color3.fromRGB(34, 31, 43)
local PAPER = Color3.fromRGB(250, 246, 238)
local SHADE = Color3.fromRGB(232, 225, 212)
local MUTED = Color3.fromRGB(128, 120, 132)
local ACCENT = Color3.fromRGB(238, 108, 77)
local ANIMALS = {
	Color3.fromRGB(226, 121, 58),
	Color3.fromRGB(138, 136, 146),
	Color3.fromRGB(48, 52, 68),
	Color3.fromRGB(112, 178, 92),
}
local TITLE = Font.fromEnum(Enum.Font.FredokaOne)
local BODY = Font.fromEnum(Enum.Font.BuilderSansBold)

local TIPS = {
	"If everyone reaches the flag, nobody scores.",
	"Trap your friends, but keep the course beatable.",
	"Hold toward a wall in the air, then jump, to wall-jump.",
	"The Trick Plank has no nails. Learn the tell.",
	"Too slow at the pick box? You get the leftovers.",
	"A Bomb clears pieces. Use it to fix a ruined course.",
}

local player = Players.LocalPlayer
ReplicatedFirst:RemoveDefaultLoadingScreen()

local gui = Instance.new("ScreenGui")
gui.Name = "Loading"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 100
gui.Parent = player:WaitForChild("PlayerGui")

local bg = Instance.new("Frame")
bg.Size = UDim2.fromScale(1, 1)
bg.BackgroundColor3 = PAPER
bg.BorderSizePixel = 0
bg.Parent = gui

local center = Instance.new("Frame")
center.AnchorPoint = Vector2.new(0.5, 0.5)
center.Position = UDim2.fromScale(0.5, 0.46)
center.Size = UDim2.fromOffset(420, 260)
center.BackgroundTransparency = 1
center.Parent = bg
local scale = Instance.new("UIScale")
scale.Parent = center
local function rescale()
	local vp = workspace.CurrentCamera.ViewportSize
	scale.Scale = math.clamp(math.min(vp.X / 700, vp.Y / 600), 0.6, 1.3)
end
rescale()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

local function text(str: string, font: Font, size: number, color: Color3, y: number, transparency: number?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.FontFace = font
	l.TextSize = size
	l.TextColor3 = color
	l.TextTransparency = transparency or 0
	l.Text = str
	l.AnchorPoint = Vector2.new(0.5, 0)
	l.Position = UDim2.new(0.5, 0, 0, y)
	l.Size = UDim2.fromOffset(420, size + 8)
	l.Parent = center
	return l
end

-- Logo with a hard offset shadow
local logo = Instance.new("Frame")
logo.BackgroundTransparency = 1
logo.Size = UDim2.fromScale(1, 1)
logo.Rotation = -3
logo.Parent = center
for _, spec in { { "Chaos Course", INK, 4, 0.85 }, { "Chaos Course", ACCENT, 0, 0 } } do
	local l = text(spec[1], TITLE, 64, spec[2], 20 + spec[3], spec[4])
	l.Position += UDim2.fromOffset(spec[3], 0)
	l.Parent = logo
end

-- Four animal-coloured dots hopping in a wave
local dots = {}
for i, c in ANIMALS do
	local d = Instance.new("Frame")
	d.BackgroundColor3 = c
	d.Size = UDim2.fromOffset(18, 18)
	d.AnchorPoint = Vector2.new(0.5, 0.5)
	d.Position = UDim2.new(0.5, (i - 2.5) * 30, 0, 130)
	d.Parent = center
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = d
	dots[i] = d
end

local barBg = Instance.new("Frame")
barBg.BackgroundColor3 = SHADE
barBg.BorderSizePixel = 0
barBg.AnchorPoint = Vector2.new(0.5, 0)
barBg.Position = UDim2.new(0.5, 0, 0, 168)
barBg.Size = UDim2.fromOffset(240, 6)
barBg.Parent = center
local c1 = Instance.new("UICorner")
c1.CornerRadius = UDim.new(1, 0)
c1.Parent = barBg
local bar = Instance.new("Frame")
bar.BackgroundColor3 = INK
bar.BorderSizePixel = 0
bar.Size = UDim2.fromScale(0, 1)
bar.Parent = barBg
local c2 = Instance.new("UICorner")
c2.CornerRadius = UDim.new(1, 0)
c2.Parent = bar

local tip = text(TIPS[math.random(1, #TIPS)], BODY, 16, MUTED, 196)

local t0 = os.clock()
local conn = RunService.RenderStepped:Connect(function()
	local t = os.clock() - t0
	for i, d in dots do
		local hop = math.max(0, math.sin(t * 6 - i * 0.7))
		d.Position = UDim2.new(0.5, (i - 2.5) * 30, 0, 130 - hop * 16)
		d.Size = UDim2.fromOffset(18 + hop * 2, 18 - hop * 3)
	end
end)

-- Rotate tips while we wait
task.spawn(function()
	while gui.Parent do
		task.wait(3.2)
		local nextTip = TIPS[math.random(1, #TIPS)]
		TweenService:Create(tip, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()
		task.wait(0.2)
		tip.Text = nextTip
		TweenService:Create(tip, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
	end
end)

-- Progress: game loaded -> remotes exist -> the level exists; never less than 1.5s
local steps = 0
local function step()
	steps += 1
	TweenService:Create(bar, TweenInfo.new(0.3, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(steps / 3, 1) }):Play()
end

if not game:IsLoaded() then
	game.Loaded:Wait()
end
step()
ReplicatedStorage:WaitForChild("Remotes", 20)
step()
workspace:WaitForChild("Level", 20)
pcall(function()
	-- give asset requests a moment, but don't hang on them
	local deadline = os.clock() + 3
	while ContentProvider.RequestQueueSize > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end)
step()
while os.clock() - t0 < 1.5 do
	task.wait(0.05)
end
task.wait(0.3)

player:SetAttribute("Loaded", true)
local fade = TweenInfo.new(0.45, Enum.EasingStyle.Quad)
TweenService:Create(bg, fade, { BackgroundTransparency = 1 }):Play()
for _, d in center:GetDescendants() do
	if d:IsA("TextLabel") then
		TweenService:Create(d, fade, { TextTransparency = 1 }):Play()
	elseif d:IsA("Frame") and d.BackgroundTransparency < 1 then
		TweenService:Create(d, fade, { BackgroundTransparency = 1 }):Play()
	end
end
task.wait(0.5)
conn:Disconnect()
gui:Destroy()
]]></ProtectedString></Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="RBX5407D391B7FD4954B3B53F3678A2CF38">
    <Properties><string name="Name">ReplicatedStorage</string></Properties>
    <Item class="Folder" referent="RBXE9459ED54BEE4EA2BCB13B852B650703">
      <Properties><string name="Name">Shared</string></Properties>
      <Item class="ModuleScript" referent="RBXA5152E41D7DE41FB97AD07DDBC428723">
        <Properties><string name="Name">Characters</string><ProtectedString name="Source"><![CDATA[--!strict
-- The cast. Every animal shares the exact same hitbox (HumanoidRootPart);
-- everything you see is massless decoration animated by the client.

local Config = require(script.Parent.Config)

export type Species = {
	id: string,
	name: string,
	body: Color3,
	belly: Color3,
	feet: Color3,
	ears: ("pointy" | "round")?,
	earColor: Color3?,
	earTip: Color3?,
	snout: ("long" | "short" | "beak")?,
	snoutColor: Color3?,
	mask: Color3?,
	bulgyEyes: boolean?,
	flippers: boolean?,
	tail: ("bushy" | "ringed")?,
	tailTip: Color3?,
}

local Characters = {}

local NOSE = Color3.fromRGB(40, 34, 38)
local EYE = Color3.fromRGB(28, 24, 30)

Characters.List = {
	{
		id = "fox", name = "Fox",
		body = Color3.fromRGB(226, 121, 58), belly = Color3.fromRGB(250, 240, 228), feet = Color3.fromRGB(70, 52, 48),
		ears = "pointy", earTip = Color3.fromRGB(70, 52, 48),
		snout = "long", snoutColor = Color3.fromRGB(250, 240, 228),
		tail = "bushy", tailTip = Color3.fromRGB(250, 240, 228),
	},
	{
		id = "raccoon", name = "Raccoon",
		body = Color3.fromRGB(138, 136, 146), belly = Color3.fromRGB(212, 208, 204), feet = Color3.fromRGB(60, 58, 66),
		ears = "round", earColor = Color3.fromRGB(110, 108, 118),
		snout = "short", snoutColor = Color3.fromRGB(212, 208, 204),
		mask = Color3.fromRGB(56, 54, 64),
		tail = "ringed", tailTip = Color3.fromRGB(56, 54, 64),
	},
	{
		id = "penguin", name = "Penguin",
		body = Color3.fromRGB(48, 52, 68), belly = Color3.fromRGB(248, 246, 240), feet = Color3.fromRGB(240, 160, 60),
		snout = "beak", snoutColor = Color3.fromRGB(240, 160, 60),
		flippers = true,
	},
	{
		id = "frog", name = "Frog",
		body = Color3.fromRGB(112, 178, 92), belly = Color3.fromRGB(214, 230, 164), feet = Color3.fromRGB(92, 150, 76),
		bulgyEyes = true,
	},
} :: { Species }

Characters.ById = {} :: { [string]: Species }
for _, s in Characters.List do
	Characters.ById[s.id] = s
end

local function piece(model: Model, name: string, size: Vector3, color: Color3, ball: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Massless = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if ball then
		p.Shape = Enum.PartType.Ball
	else
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = model
	return p
end

local function weld(p0: BasePart, p1: BasePart, c0: CFrame)
	local w = Instance.new("Weld")
	w.Part0 = p0
	w.Part1 = p1
	w.C0 = c0
	w.Parent = p1
end

local function motor(name: string, p0: BasePart, p1: BasePart, c0: CFrame, c1: CFrame?): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = p0
	m.Part1 = p1
	m.C0 = c0
	m.C1 = c1 or CFrame.identity
	m.Parent = p0
	return m
end

-- Builds a ready-to-use character model. Local -Z is "forward".
function Characters.build(speciesId: string): Model
	local s = Characters.ById[speciesId] or Characters.List[1]
	local model = Instance.new("Model")
	model.Name = s.name

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(1.8, 2.4, 1.8)
	root.Transparency = 1
	root.CanCollide = true
	root.CanQuery = false
	root.CanTouch = true
	root.CollisionGroup = "Players"
	root.Parent = model
	model.PrimaryPart = root

	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 1
	hum.RequiresNeck = false
	hum.BreakJointsOnDeath = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.UseJumpPower = true
	hum.JumpPower = Config.Movement.JumpPower
	hum.WalkSpeed = Config.Movement.WalkSpeed
	hum.Parent = model

	local body = piece(model, "Body", Vector3.new(2.4, 2.4, 2.4), s.body)
	motor("BodyJoint", root, body, CFrame.new(0, -0.7, 0))

	local head = piece(model, "Head", Vector3.new(2, 1.9, 1.9), s.body)
	motor("Neck", body, head, CFrame.new(0, 1.45, -0.45))

	-- Belly patch
	if s.flippers then
		weld(body, piece(model, "Belly", Vector3.new(1.9, 2, 1.2), s.belly), CFrame.new(0, -0.1, -0.62))
	else
		weld(body, piece(model, "Belly", Vector3.new(1.5, 1.6, 0.9), s.belly), CFrame.new(0, -0.15, -0.8))
	end

	-- Feet (animated)
	for i, x in { -0.45, 0.45 } do
		local foot = piece(model, i == 1 and "FootL" or "FootR", Vector3.new(0.5, 0.4, 0.8), s.feet)
		motor(i == 1 and "HipL" or "HipR", body, foot, CFrame.new(x, -1.25, -0.15))
	end

	-- Face
	if s.mask then
		weld(head, piece(model, "Mask", Vector3.new(1.9, 0.5, 1.5), s.mask), CFrame.new(0, 0.2, -0.35))
	end
	for _, side in { -1, 1 } do
		if s.bulgyEyes then
			local white = piece(model, "EyeWhite", Vector3.new(0.8, 0.8, 0.8), Color3.new(1, 1, 1), true)
			weld(head, white, CFrame.new(side * 0.5, 0.85, -0.35))
			weld(head, piece(model, "Eye", Vector3.new(0.12, 0.4, 0.34), EYE), CFrame.new(side * 0.88, 0.9, -0.45))
		else
			weld(head, piece(model, "Eye", Vector3.new(0.12, 0.42, 0.3), EYE), CFrame.new(side * 0.95, 0.2, -0.45))
			weld(head, piece(model, "Shine", Vector3.new(0.1, 0.1, 0.1), Color3.new(1, 1, 1), true), CFrame.new(side * 1.0, 0.3, -0.5))
		end
	end

	if s.snout == "long" then
		weld(head, piece(model, "Snout", Vector3.new(0.8, 0.7, 1.2), s.snoutColor or s.belly), CFrame.new(0, -0.2, -0.95))
		weld(head, piece(model, "Nose", Vector3.new(0.32, 0.32, 0.32), NOSE, true), CFrame.new(0, -0.05, -1.55))
	elseif s.snout == "short" then
		weld(head, piece(model, "Snout", Vector3.new(0.8, 0.6, 0.8), s.snoutColor or s.belly), CFrame.new(0, -0.25, -0.8))
		weld(head, piece(model, "Nose", Vector3.new(0.28, 0.28, 0.28), NOSE, true), CFrame.new(0, -0.1, -1.18))
	elseif s.snout == "beak" then
		weld(head, piece(model, "Beak", Vector3.new(0.5, 0.35, 0.9), s.snoutColor or s.feet), CFrame.new(0, -0.15, -1.0))
	end

	-- Ears
	for _, side in { -1, 1 } do
		if s.ears == "pointy" then
			local ear = piece(model, "Ear", Vector3.new(0.35, 1.1, 0.7), s.earColor or s.body)
			weld(head, ear, CFrame.new(side * 0.45, 1.0, 0.1) * CFrame.Angles(0, 0, math.rad(-side * 15)))
			weld(ear, piece(model, "EarTip", Vector3.new(0.37, 0.45, 0.5), s.earTip or s.body), CFrame.new(0, 0.38, 0))
		elseif s.ears == "round" then
			weld(head, piece(model, "Ear", Vector3.new(0.3, 0.7, 0.7), s.earColor or s.body), CFrame.new(side * 0.55, 0.85, 0.1))
		end
		if s.flippers then
			local flipper = piece(model, "Flipper", Vector3.new(0.3, 1.2, 0.6), s.body)
			motor(side < 0 and "FlipL" or "FlipR", body, flipper, CFrame.new(side * 1.15, -0.1, 0) * CFrame.Angles(0, 0, math.rad(side * 20)))
		end
	end

	-- Tail (animated)
	if s.tail then
		local tail = piece(model, "Tail", Vector3.new(0.9, 0.9, 2), s.body)
		motor("TailJoint", body, tail, CFrame.new(0, -0.2, 1.0) * CFrame.Angles(math.rad(35), 0, 0), CFrame.new(0, 0, -0.9))
		weld(tail, piece(model, "TailTip", Vector3.new(0.78, 0.78, 0.7), s.tailTip or s.belly), CFrame.new(0, 0, 0.75))
		if s.tail == "ringed" then
			weld(tail, piece(model, "Ring", Vector3.new(0.96, 0.96, 0.25), s.tailTip or s.belly), CFrame.new(0, 0, -0.15))
		end
	end

	model:SetAttribute("Species", s.id)
	return model
end

return Characters
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX59BBD278F2CB4374BA0B54414A2B7E05">
        <Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- Every tuning number lives here so playtesting changes are one-line edits.

local Config = {}

Config.Match = {
	MinPlayers = 1, -- 1 so it can be tested solo in Studio
	PointsToWin = 600, -- first across the line wins...
	MaxRounds = 12, -- ...or whoever leads after this many rounds
	LastRoundMultiplier = 2,
	IntroTime = 5,
	PickTime = 12,
	BuildTime = 25,
	CountdownTime = 3,
	RunTime = 60,
	ResultsTime = 8,
	WinnerTime = 10,
	BoxExtra = 2, -- the pick box holds players + this many pieces
}

Config.Scoring = {
	Place = { 100, 75, 50, 25 }, -- 5th and lower get the last value
	Trap = 25, -- per opponent your object takes out
	TrapCap = 75, -- per round, so one trap can't decide the whole match
	Clutch = 15, -- finish with under ClutchWindow seconds left
	ClutchWindow = 5,
	OwnRoute = 15, -- finish after touching a route piece you placed
}

Config.Movement = {
	WalkSpeed = 22,
	JumpPower = 54,
	AirJumpPower = 46,
	AirJumps = 1,
	CoyoteTime = 0.1,
	JumpBuffer = 0.12,
	WallSlideSpeed = 9,
	WallJumpPower = Vector3.new(26, 50, 0),
	WallJumpLock = 0.18,
	IceAccel = 2.2, -- lower = slipperier
	HoneySpeed = 0.45,
	HoneyJump = 0.6,
}

Config.Objects = {
	SpringPower = 92,
	FanAccel = 150,
	FanMaxSpeed = 55,
	ConveyorSpeed = 14,
	HammerKnock = Vector3.new(62, 34, 0),
	CannonSpeed = 24,
	CannonInterval = 2.6,
	CannonKnock = Vector3.new(58, 30, 0),
	CrumbleDelay = 0.55,
	CrumbleRespawn = 3.5,
	BombRadius = 5,
	BumperKnock = 70,
}

-- 2.5D: everything lives on the Z = 0 plane, the camera looks down -Z.
Config.World = {
	KillY = -12,
	Hold = Vector3.new(0, 80, 420), -- behind the camera, where parked characters wait
	GoalMinTime = 1.5, -- anti-teleport sanity check
}

return Config
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXF8E2947736CF439E9C1947F7D37E0C57">
        <Properties><string name="Name">Levels</string><ProtectedString name="Source"><![CDATA[--!strict
-- Hand-authored layouts, stored as plain data.
-- The same shape will be what community levels save to DataStores later.
--
-- Design rules every layout follows:
--   * start and flag are on solid ground with clear space around them
--   * the bare layout is beatable with double jumps, but never comfortably
--   * at least two routes somewhere (a high one and a low one), so one
--     player's trap never blocks the only way through
--   * big open air between pieces, because that's where players build
--
-- Reference: single jump ~7 studs high, double jump ~12, ~18 across.

export type Piece = {
	kind: "ground" | "ledge" | "stump" | "tree" | "rock" | "log",
	x0: number,
	x1: number,
	top: number,
}

export type Layout = {
	name: string,
	world: string,
	spawn: Vector2, -- point on the start ledge surface
	flag: Vector2, -- point on the goal ledge surface
	buildMin: Vector2,
	buildMax: Vector2,
	pieces: { Piece },
	seed: number,
}

local Levels = {}

Levels.Forest = {
	{
		-- Low meadow path vs. a high ledge route over the middle
		name = "Mossy Hollow",
		world = "Forest",
		spawn = Vector2.new(0, 10),
		flag = Vector2.new(214, 16),
		buildMin = Vector2.new(-8, -8),
		buildMax = Vector2.new(228, 64),
		seed = 11,
		pieces = {
			{ kind = "ground", x0 = -12, x1 = 12, top = 10 },
			{ kind = "ground", x0 = 26, x1 = 40, top = 6 },
			{ kind = "stump", x0 = 52, x1 = 57, top = 16 },
			{ kind = "ledge", x0 = 66, x1 = 80, top = 24 },
			{ kind = "ground", x0 = 72, x1 = 96, top = 4 },
			{ kind = "rock", x0 = 108, x1 = 114, top = 12 },
			{ kind = "ground", x0 = 124, x1 = 152, top = 8 },
			{ kind = "stump", x0 = 140, x1 = 145, top = 18 },
			{ kind = "ledge", x0 = 158, x1 = 172, top = 28 },
			{ kind = "ground", x0 = 168, x1 = 186, top = 10 },
			{ kind = "ground", x0 = 200, x1 = 232, top = 16 },
		},
	},
	{
		-- Two long logs, a rocky dip, and an overhang that rewards the brave
		name = "Fallen Log",
		world = "Forest",
		spawn = Vector2.new(-2, 12),
		flag = Vector2.new(212, 12),
		buildMin = Vector2.new(-8, -8),
		buildMax = Vector2.new(228, 64),
		seed = 23,
		pieces = {
			{ kind = "ground", x0 = -12, x1 = 10, top = 12 },
			{ kind = "log", x0 = 22, x1 = 60, top = 6 },
			{ kind = "rock", x0 = 70, x1 = 76, top = 2 },
			{ kind = "ground", x0 = 88, x1 = 110, top = 10 },
			{ kind = "ledge", x0 = 100, x1 = 116, top = 28 },
			{ kind = "log", x0 = 124, x1 = 160, top = 14 },
			{ kind = "rock", x0 = 172, x1 = 177, top = 6 },
			{ kind = "ledge", x0 = 168, x1 = 182, top = 30 },
			{ kind = "ground", x0 = 192, x1 = 232, top = 12 },
		},
	},
	{
		-- Treetop hopping: lots of height changes, lots of places to build
		name = "Canopy Run",
		world = "Forest",
		spawn = Vector2.new(-2, 20),
		flag = Vector2.new(214, 18),
		buildMin = Vector2.new(-8, -8),
		buildMax = Vector2.new(228, 68),
		seed = 37,
		pieces = {
			{ kind = "ground", x0 = -12, x1 = 8, top = 20 },
			{ kind = "tree", x0 = 20, x1 = 28, top = 14 },
			{ kind = "tree", x0 = 38, x1 = 44, top = 24 },
			{ kind = "tree", x0 = 56, x1 = 64, top = 12 },
			{ kind = "tree", x0 = 76, x1 = 82, top = 22 },
			{ kind = "tree", x0 = 94, x1 = 102, top = 30 },
			{ kind = "tree", x0 = 116, x1 = 124, top = 16 },
			{ kind = "tree", x0 = 136, x1 = 142, top = 26 },
			{ kind = "tree", x0 = 154, x1 = 162, top = 14 },
			{ kind = "tree", x0 = 174, x1 = 180, top = 24 },
			{ kind = "ground", x0 = 194, x1 = 232, top = 18 },
		},
	},
} :: { Layout }

return Levels
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXD874BB7FDF3948978CBC4C2F384A1A47">
        <Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!strict
-- All remotes in one place. Server creates them, clients wait for them.
-- Rule: clients only ever *ask*. The server decides everything that matters.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local RELIABLE = {
	"MatchState", -- S->C  phase, timers, round
	"Scores", -- S->C  totals
	"Box", -- S->C  the shared pick box: pieces + who grabbed what
	"Pick", -- C->S  grab a piece from the box
	"Hand", -- S->C  the piece you'll place this round (nil closes)
	"Place", -- C->S  request to place a card
	"PlaceResult", -- S->C  ok / reason
	"Fail", -- S->C  someone got taken out
	"Finish", -- S->C  someone reached the flag
	"RoundResults", -- S->C  per-player breakdown
	"Explode", -- S->C  bomb went off (visual only)
	"Notify", -- S->C  small toast
	"LobbyState", -- S->C  menu/party info: mode, code, host, members, queued
}

local FUNCTIONS = {
	"Lobby", -- C->S  menu actions: play, create, join, start, leave, species
}

local UNRELIABLE = {
	"Cursor", -- C->S->C  live ghost previews of other builders
}

local Net = {}

local folder: Folder
if RunService:IsServer() then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in RELIABLE do
		local r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = folder
	end
	for _, name in FUNCTIONS do
		local r = Instance.new("RemoteFunction")
		r.Name = name
		r.Parent = folder
	end
	for _, name in UNRELIABLE do
		local r = Instance.new("UnreliableRemoteEvent")
		r.Name = name
		r.Parent = folder
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Net.event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Net.func(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

function Net.unreliable(name: string): UnreliableRemoteEvent
	return folder:WaitForChild(name) :: UnreliableRemoteEvent
end

return Net
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX796CD50CD3E34685AAD76C373DC8769F">
        <Properties><string name="Name">Objects</string><ProtectedString name="Source"><![CDATA[--!strict
-- Placeable object definitions + their models.
-- The server builds the real thing; the client builds the same model for
-- ghost previews and card icons, so what you see is exactly what you get.
--
-- Model conventions (read by server services and client controllers):
--   part attribute Solid   -> you can stand on it
--   part attribute Deadly  -> touching it with your hitbox takes you out
--   part attribute Surface -> "ice" | "honey"
--   part attribute Group   -> client animates it: "spin" | "fan" | "arm" | "mover" | "wind" | "pad"

local Style = require(script.Parent.Style)
local Config = require(script.Parent.Config)

local O = Style.Object
local F = Style.Forest
local DEPTH = 4
local FRONT = DEPTH / 2 + 0.02

export type Def = {
	id: string,
	name: string,
	blurb: string,
	kind: "route" | "trap" | "tool",
	size: Vector2, -- footprint at rotation 0
	weight: number,
	travel: number?,
}

local Objects = {}

Objects.List = {
	{ id = "plank", name = "Plank", blurb = "A trusty wooden ledge.", kind = "route", size = Vector2.new(6, 1), weight = 3 },
	{ id = "longplank", name = "Long Plank", blurb = "Bridges a big gap. Or blocks one.", kind = "route", size = Vector2.new(10, 1), weight = 2 },
	{ id = "pillar", name = "Pillar", blurb = "A tall post. Wall-jump off it.", kind = "route", size = Vector2.new(1, 6), weight = 1 },
	{ id = "crate", name = "Crate", blurb = "Solid. Stack it, hide behind it.", kind = "route", size = Vector2.new(3, 3), weight = 2 },
	{ id = "spring", name = "Spring", blurb = "Boing. Tilt it to launch sideways.", kind = "route", size = Vector2.new(3, 2), weight = 2 },
	{ id = "conveyor", name = "Conveyor", blurb = "Carries you along. Or into things.", kind = "route", size = Vector2.new(8, 1), weight = 2 },
	{ id = "mover", name = "Shuttle", blurb = "Slides back and forth on a rail.", kind = "route", size = Vector2.new(5, 1), weight = 2, travel = 10 },
	{ id = "ice", name = "Ice", blurb = "Slippery. Fast, if you're brave.", kind = "route", size = Vector2.new(8, 1), weight = 1 },
	{ id = "crumble", name = "Crumbly Ledge", blurb = "Falls apart right after you land.", kind = "route", size = Vector2.new(4, 1), weight = 1 },
	{ id = "decoy", name = "Trick Plank", blurb = "Looks like a plank. Isn't. (No nails.)", kind = "trap", size = Vector2.new(6, 1), weight = 1 },
	{ id = "honey", name = "Honey", blurb = "Sticky. Slow feet, weak jumps.", kind = "trap", size = Vector2.new(6, 1), weight = 1 },
	{ id = "spikes", name = "Spikes", blurb = "Don't.", kind = "trap", size = Vector2.new(4, 1), weight = 2 },
	{ id = "saw", name = "Buzzsaw", blurb = "Spins. Hurts.", kind = "trap", size = Vector2.new(5, 5), weight = 2 },
	{ id = "hammer", name = "Swing Hammer", blurb = "Knocks you flying. Timing matters.", kind = "trap", size = Vector2.new(2, 2), weight = 2 },
	{ id = "fan", name = "Fan", blurb = "Blows everyone the way it points.", kind = "trap", size = Vector2.new(3, 2), weight = 2 },
	{ id = "cannon", name = "Cannon", blurb = "Lobs slow cannonballs. Knockback.", kind = "trap", size = Vector2.new(3, 2), weight = 1 },
	{ id = "trapdoor", name = "Trapdoor", blurb = "Solid... until it drops open.", kind = "trap", size = Vector2.new(6, 1), weight = 1 },
	{ id = "bumper", name = "Bumper", blurb = "Bounces you away, pinball style.", kind = "trap", size = Vector2.new(3, 3), weight = 1 },
	{ id = "laser", name = "Laser", blurb = "Blinks on and off. Deadly when on.", kind = "trap", size = Vector2.new(2, 2), weight = 1 },
	{ id = "bomb", name = "Bomb", blurb = "Clears objects nearby. Fix a ruined level.", kind = "tool", size = Vector2.new(1, 1), weight = 1 },
} :: { Def }

Objects.ById = {} :: { [string]: Def }
for _, def in Objects.List do
	Objects.ById[def.id] = def
end

--------------------------------------------------------------------------
-- Geometry helpers
--------------------------------------------------------------------------

function Objects.footprint(def: Def, rot: number): Vector2
	local w = def.size.X + (def.travel or 0)
	local h = def.size.Y
	if rot % 180 ~= 0 then
		return Vector2.new(h, w)
	end
	return Vector2.new(w, h)
end

-- Snap so the footprint's edges land on whole studs (pieces line up flush)
function Objects.snap(def: Def, x: number, y: number, rot: number): (number, number)
	local fp = Objects.footprint(def, rot)
	local sx = math.floor(x - fp.X / 2 + 0.5) + fp.X / 2
	local sy = math.floor(y - fp.Y / 2 + 0.5) + fp.Y / 2
	return sx, sy
end

function Objects.cframe(x: number, y: number, rot: number): CFrame
	return CFrame.new(x, y, 0) * CFrame.Angles(0, 0, math.rad(rot))
end

--------------------------------------------------------------------------
-- Timed objects: both server and client compute state from the same clock
--------------------------------------------------------------------------

Objects.LASER_PERIOD = 3.2
-- "on" for 1.4s, a short "warn" flicker before it fires again, otherwise "off"
function Objects.laserState(age: number): string
	local t = age % Objects.LASER_PERIOD
	if t < 1.4 then
		return "on"
	elseif t > Objects.LASER_PERIOD - 0.5 then
		return "warn"
	end
	return "off"
end

Objects.TRAPDOOR_PERIOD = 4
function Objects.trapdoorOpen(age: number): boolean
	return age % Objects.TRAPDOOR_PERIOD > 2.8
end

-- How far a laser reaches before something solid stops it
function Objects.laserLength(model: Model, pivot: CFrame): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local list = {}
	for _, name in { "Level", "Objects" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(list, f)
		end
	end
	params.FilterDescendantsInstances = list
	local dir = pivot.RightVector
	local origin = pivot * Vector3.new(1, 0, 0)
	local max = 60
	local traveled = 0
	while traveled < max do
		local hit = workspace:Raycast(origin, dir * (max - traveled), params)
		if not hit then
			break
		end
		if hit.Instance.CanCollide and not hit.Instance:IsDescendantOf(model) then
			return traveled + (hit.Position - origin).Magnitude
		end
		traveled += (hit.Position - origin).Magnitude + 0.05
		origin = hit.Position + dir * 0.05
	end
	return max
end

-- Shared by the client ghost (red/green) and the server (final say).
function Objects.check(def: Def, x: number, y: number, rot: number): (boolean, string?)
	local level = workspace:FindFirstChild("Level")
	local objects = workspace:FindFirstChild("Objects")
	if not level then
		return false, "No level"
	end

	local fp = Objects.footprint(def, rot)
	local bmin = level:GetAttribute("BuildMin") :: Vector3?
	local bmax = level:GetAttribute("BuildMax") :: Vector3?
	if bmin and bmax then
		if x - fp.X / 2 < bmin.X or x + fp.X / 2 > bmax.X or y - fp.Y / 2 < bmin.Y or y + fp.Y / 2 > bmax.Y then
			return false, "Out of bounds"
		end
	end

	if def.id == "bomb" then
		return true, nil
	end

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = if objects then { level, objects } else { level }
	local hits = workspace:GetPartBoundsInBox(CFrame.new(x, y, 0), Vector3.new(fp.X - 0.15, fp.Y - 0.15, 3), params)
	if #hits > 0 then
		for _, hit in hits do
			if hit.Name == "SafeZone" then
				return false, "Too close to the start or flag"
			end
		end
		return false, "Something's in the way"
	end
	return true, nil
end

--------------------------------------------------------------------------
-- Model building
--------------------------------------------------------------------------

local function add(model: Model, name: string, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function solid(p: Part): Part
	p.CanCollide = true
	p.CanQuery = true
	p.CanTouch = true
	p:SetAttribute("Solid", true)
	return p
end

local function deadly(model: Model, size: Vector3, cf: CFrame, shape: Enum.PartType?): Part
	local p = add(model, "Hitbox", size, cf, O.Danger, shape)
	p.Transparency = 1
	p.CanTouch = true
	p.CanQuery = true
	p:SetAttribute("Deadly", true)
	return p
end

local function ellipsoid(model: Model, name: string, size: Vector3, cf: CFrame, color: Color3): Part
	local p = add(model, name, size, cf, color)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local FACE_CAMERA = CFrame.Angles(0, math.pi / 2, 0) -- cylinder axis X -> Z

local builders: { [string]: (Model) -> () } = {}

local function plankBody(m: Model, withNails: boolean)
	solid(add(m, "Board", Vector3.new(6, 1, DEPTH), CFrame.identity, F.Wood))
	add(m, "Trim", Vector3.new(6.02, 0.22, DEPTH + 0.02), CFrame.new(0, -0.4, 0), F.WoodDark)
	if withNails then
		for _, x in { -2.3, 2.3 } do
			add(m, "Nail", Vector3.new(0.28, 0.28, 0.06), CFrame.new(x, 0.12, FRONT), F.WoodDark)
		end
	end
end

builders.plank = function(m)
	plankBody(m, true)
end

builders.decoy = function(m)
	plankBody(m, false)
	for _, p in m:GetChildren() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p:SetAttribute("Solid", nil)
		end
	end
end

builders.longplank = function(m)
	solid(add(m, "Board", Vector3.new(10, 1, DEPTH), CFrame.identity, F.Wood))
	add(m, "Trim", Vector3.new(10.02, 0.22, DEPTH + 0.02), CFrame.new(0, -0.4, 0), F.WoodDark)
	for _, x in { -4.3, 0, 4.3 } do
		add(m, "Nail", Vector3.new(0.28, 0.28, 0.06), CFrame.new(x, 0.12, FRONT), F.WoodDark)
	end
end

builders.pillar = function(m)
	solid(add(m, "Post", Vector3.new(1, 6, DEPTH), CFrame.identity, F.Wood))
	add(m, "Cap", Vector3.new(1.3, 0.4, DEPTH + 0.2), CFrame.new(0, 2.85, 0), F.WoodDark)
	add(m, "Foot", Vector3.new(1.3, 0.4, DEPTH + 0.2), CFrame.new(0, -2.85, 0), F.WoodDark)
end

builders.trapdoor = function(m)
	add(m, "Frame", Vector3.new(6, 0.3, DEPTH + 0.1), CFrame.new(0, -0.55, 0), O.Metal)
	for _, side in { -1, 1 } do
		local door = solid(add(m, "Door", Vector3.new(2.95, 0.8, DEPTH), CFrame.new(side * 1.5, 0, 0), F.Wood))
		door:SetAttribute("Group", side < 0 and "doorL" or "doorR")
		local hinge = add(m, "Hinge", Vector3.new(0.35, 0.35, 0.06), CFrame.new(side * 2.7, 0, FRONT), O.MetalLight)
		hinge:SetAttribute("Group", side < 0 and "doorL" or "doorR")
	end
	add(m, "Seam", Vector3.new(0.12, 0.82, 0.05), CFrame.new(0, 0, FRONT), F.WoodDark)
end

builders.bumper = function(m)
	local ball = solid(add(m, "Bumper", Vector3.new(3, 3, 3), CFrame.identity, O.Spring, Enum.PartType.Ball))
	ball:SetAttribute("Group", "bumper")
	local ring = add(m, "Ring", Vector3.new(0.3, 3.1, 3.1), FACE_CAMERA, Style.UI.Paper, Enum.PartType.Cylinder)
	ring:SetAttribute("Group", "bumper")
	local dot = add(m, "Dot", Vector3.new(0.32, 1.2, 1.2), FACE_CAMERA, O.Spring, Enum.PartType.Cylinder)
	dot:SetAttribute("Group", "bumper")
end

builders.laser = function(m)
	solid(add(m, "Emitter", Vector3.new(2, 2, 3), CFrame.identity, O.Metal))
	add(m, "Lens", Vector3.new(0.3, 1, 1), CFrame.new(1.05, 0, 0), O.Danger, Enum.PartType.Cylinder)
	add(m, "Vent", Vector3.new(1.4, 0.15, 0.05), CFrame.new(-0.1, 0.4, 1.52), O.MetalLight)
	add(m, "Vent", Vector3.new(1.4, 0.15, 0.05), CFrame.new(-0.1, 0, 1.52), O.MetalLight)
	local beam = add(m, "Beam", Vector3.new(4, 0.3, 0.3), CFrame.new(3.1, 0, 0), O.Danger)
	beam:SetAttribute("Group", "beam")
	beam.CastShadow = false
	beam.Transparency = 0.15
end

builders.crate = function(m)
	solid(add(m, "Box", Vector3.new(3, 3, DEPTH), CFrame.identity, F.Wood))
	local t = 0.36
	add(m, "Trim", Vector3.new(3, t, 0.06), CFrame.new(0, 1.5 - t / 2, FRONT), F.WoodDark)
	add(m, "Trim", Vector3.new(3, t, 0.06), CFrame.new(0, -1.5 + t / 2, FRONT), F.WoodDark)
	add(m, "Trim", Vector3.new(t, 3, 0.06), CFrame.new(1.5 - t / 2, 0, FRONT), F.WoodDark)
	add(m, "Trim", Vector3.new(t, 3, 0.06), CFrame.new(-1.5 + t / 2, 0, FRONT), F.WoodDark)
	add(m, "Trim", Vector3.new(t, 3.1, 0.05), CFrame.new(0, 0, FRONT) * CFrame.Angles(0, 0, math.rad(45)), F.WoodDark)
end

builders.spring = function(m)
	solid(add(m, "Base", Vector3.new(3, 0.5, 3), CFrame.new(0, -0.75, 0), O.Metal))
	for i = 0, 2 do
		add(m, "Coil", Vector3.new(0.16, 1.5, 1.5), CFrame.new(0, -0.35 + i * 0.32, 0) * CFrame.Angles(0, 0, math.pi / 2), O.MetalLight, Enum.PartType.Cylinder)
	end
	local pad = solid(add(m, "Pad", Vector3.new(3, 0.4, 3), CFrame.new(0, 0.6, 0), O.Spring))
	pad:SetAttribute("Group", "pad")
end

builders.conveyor = function(m)
	local belt = solid(add(m, "Belt", Vector3.new(8, 1, DEPTH), CFrame.identity, O.Rubber))
	belt:SetAttribute("Conveyor", true)
	for _, x in { -4, 4 } do
		add(m, "Roller", Vector3.new(DEPTH + 0.1, 1.1, 1.1), CFrame.new(x, 0, 0) * FACE_CAMERA, O.MetalLight, Enum.PartType.Cylinder)
	end
	for _, x in { -2.2, 0, 2.2 } do
		add(m, "Chevron", Vector3.new(0.8, 0.16, 0.05), CFrame.new(x, 0.17, FRONT) * CFrame.Angles(0, 0, math.rad(-38)), O.Stripe)
		add(m, "Chevron", Vector3.new(0.8, 0.16, 0.05), CFrame.new(x, -0.17, FRONT) * CFrame.Angles(0, 0, math.rad(38)), O.Stripe)
	end
end

builders.mover = function(m)
	local travel = (Objects.ById.mover.travel :: number) + 5
	add(m, "Rail", Vector3.new(travel, 0.3, 0.3), CFrame.new(0, 0, -1.6), O.Rubber)
	for _, x in { -travel / 2, travel / 2 } do
		add(m, "RailEnd", Vector3.new(0.7, 0.7, 0.7), CFrame.new(x, 0, -1.6), O.Metal, Enum.PartType.Ball)
	end
	local deck = solid(add(m, "Deck", Vector3.new(5, 1, DEPTH), CFrame.identity, F.Wood))
	deck:SetAttribute("Group", "mover")
	for _, x in { -2.35, 2.35 } do
		local cap = add(m, "Cap", Vector3.new(0.4, 1.06, DEPTH + 0.06), CFrame.new(x, 0, 0), O.MetalLight)
		cap:SetAttribute("Group", "mover")
	end
end

builders.ice = function(m)
	local slab = solid(add(m, "Slab", Vector3.new(8, 1, DEPTH), CFrame.identity, O.Ice))
	slab:SetAttribute("Surface", "ice")
	for _, x in { -2.6, -2.1, 1.8 } do
		add(m, "Shine", Vector3.new(0.14, 0.7, 0.05), CFrame.new(x, 0, FRONT) * CFrame.Angles(0, 0, math.rad(-30)), Color3.new(1, 1, 1))
	end
end

builders.crumble = function(m)
	local slab = solid(add(m, "Slab", Vector3.new(4, 1, DEPTH), CFrame.identity, O.Crumble))
	slab:SetAttribute("Crumble", true)
	add(m, "Crack", Vector3.new(0.1, 0.8, 0.05), CFrame.new(-0.7, 0, FRONT) * CFrame.Angles(0, 0, math.rad(20)), F.WoodDark)
	add(m, "Crack", Vector3.new(0.1, 0.5, 0.05), CFrame.new(0.9, 0.15, FRONT) * CFrame.Angles(0, 0, math.rad(-35)), F.WoodDark)
end

builders.honey = function(m)
	local slab = solid(add(m, "Slab", Vector3.new(6, 0.8, DEPTH), CFrame.new(0, -0.1, 0), O.Honey))
	slab:SetAttribute("Surface", "honey")
	ellipsoid(m, "Top", Vector3.new(6.2, 0.5, DEPTH + 0.2), CFrame.new(0, 0.25, 0), O.Honey)
	for _, x in { -2.1, 0.4, 2.3 } do
		ellipsoid(m, "Drip", Vector3.new(0.5, 0.9, 0.5), CFrame.new(x, -0.6, 1.4), O.Honey)
	end
end

builders.spikes = function(m)
	solid(add(m, "Base", Vector3.new(4, 0.4, DEPTH), CFrame.new(0, -0.3, 0), O.Metal))
	add(m, "Band", Vector3.new(4.02, 0.12, 0.05), CFrame.new(0, -0.3, FRONT), O.Danger)
	for _, x in { -1.5, -0.5, 0.5, 1.5 } do
		add(m, "Spike", Vector3.new(0.85, 0.85, DEPTH - 0.4), CFrame.new(x, -0.1, 0) * CFrame.Angles(0, 0, math.rad(45)), O.MetalLight)
	end
	-- Slightly smaller than the art: forgiving hitboxes feel fair
	deadly(m, Vector3.new(3.6, 0.7, 3), CFrame.new(0, 0.05, 0))
end

builders.saw = function(m)
	local blade = add(m, "Blade", Vector3.new(0.4, 5, 5), FACE_CAMERA, O.MetalLight, Enum.PartType.Cylinder)
	blade:SetAttribute("Group", "spin")
	for i = 0, 7 do
		local a = i * math.pi / 4
		local tooth = add(m, "Tooth", Vector3.new(0.7, 0.7, 0.3), CFrame.Angles(0, 0, a) * CFrame.new(0, 2.45, 0) * CFrame.Angles(0, 0, math.rad(45)), O.Metal)
		tooth:SetAttribute("Group", "spin")
	end
	local hub = add(m, "Hub", Vector3.new(0.7, 1.4, 1.4), FACE_CAMERA, O.Danger, Enum.PartType.Cylinder)
	hub:SetAttribute("Group", "spin")
	deadly(m, Vector3.new(4.4, 4.4, 4.4), CFrame.identity, Enum.PartType.Ball)
end

builders.hammer = function(m)
	solid(add(m, "Mount", Vector3.new(2, 2, 3), CFrame.identity, O.Metal))
	add(m, "Bolt", Vector3.new(0.3, 0.8, 0.8), CFrame.new(0, 0, 1.9) * FACE_CAMERA, O.MetalLight, Enum.PartType.Cylinder)
	local arm = add(m, "Arm", Vector3.new(0.5, 7, 0.5), CFrame.new(0, -3.5, 1.8), F.WoodDark)
	arm:SetAttribute("Group", "arm")
	local head = add(m, "Head", Vector3.new(3.2, 2, 2.2), CFrame.new(0, -7.5, 1.8), O.Metal)
	head:SetAttribute("Group", "arm")
	local band = add(m, "Band", Vector3.new(0.5, 2.06, 2.26), CFrame.new(0, -7.5, 1.8), O.Danger)
	band:SetAttribute("Group", "arm")
end

builders.fan = function(m)
	solid(add(m, "Housing", Vector3.new(3, 1.2, 3), CFrame.new(0, -0.4, 0), O.Metal))
	add(m, "Grill", Vector3.new(3.02, 0.14, 0.05), CFrame.new(0, -0.4, 1.52), O.MetalLight)
	for i = 0, 2 do
		local blade = add(m, "Blade", Vector3.new(2.6, 0.12, 0.5), CFrame.new(0, 0.35, 0) * CFrame.Angles(0, i * math.pi / 3, 0), O.MetalLight)
		blade:SetAttribute("Group", "fan")
	end
	-- Faint column so players can always see the wind's reach
	local zone = add(m, "Zone", Vector3.new(3, 16, 0.1), CFrame.new(0, 8.5, -1.8), Color3.new(1, 1, 1))
	zone.Transparency = 0.9
	zone.CastShadow = false
	for i = 1, 3 do
		local s = add(m, "Wind", Vector3.new(0.1, 1.8, 0.1), CFrame.new(-1 + (i - 1), 2 + i * 4, 0.5), Color3.new(1, 1, 1))
		s.Transparency = 0.5
		s.CastShadow = false
		s:SetAttribute("Group", "wind")
	end
end

builders.cannon = function(m)
	solid(add(m, "Base", Vector3.new(3, 0.8, 3), CFrame.new(0, -0.6, 0), F.WoodDark))
	solid(add(m, "Barrel", Vector3.new(2.8, 1.4, 1.4), CFrame.new(0.3, 0.3, 0), O.Rubber, Enum.PartType.Cylinder))
	add(m, "Lip", Vector3.new(0.3, 1.7, 1.7), CFrame.new(1.65, 0.3, 0), O.Metal, Enum.PartType.Cylinder)
	for _, x in { -0.8, 0.8 } do
		add(m, "Wheel", Vector3.new(0.35, 1.2, 1.2), CFrame.new(x, -0.7, 1.7) * FACE_CAMERA, F.Wood, Enum.PartType.Cylinder)
	end
end

builders.bomb = function(m)
	add(m, "Ball", Vector3.new(1.6, 1.6, 1.6), CFrame.identity, O.Rubber, Enum.PartType.Ball)
	add(m, "Fuse", Vector3.new(0.2, 0.6, 0.2), CFrame.new(0.3, 0.9, 0) * CFrame.Angles(0, 0, math.rad(-25)), F.WoodDark)
	local r = Config.Objects.BombRadius * 2
	local ring = add(m, "Radius", Vector3.new(0.1, r, r), FACE_CAMERA, O.Danger, Enum.PartType.Cylinder)
	ring.Transparency = 0.8
	ring.CastShadow = false
end

function Objects.build(id: string): Model
	local m = Instance.new("Model")
	m.Name = id
	builders[id](m)
	m.WorldPivot = CFrame.identity
	m:SetAttribute("Id", id)
	return m
end

return Objects
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3C095C0EF9CB412B81D1B092C1D9C0D8">
        <Properties><string name="Name">Style</string><ProtectedString name="Source"><![CDATA[--!strict
-- One palette for UI and world. Flat colors, no gradients, no neon.

local Style = {}

Style.UI = {
	Ink = Color3.fromRGB(34, 31, 43),
	InkSoft = Color3.fromRGB(58, 54, 70),
	Paper = Color3.fromRGB(250, 246, 238),
	PaperShade = Color3.fromRGB(232, 225, 212),
	Muted = Color3.fromRGB(128, 120, 132),
	Accent = Color3.fromRGB(238, 108, 77),
	Good = Color3.fromRGB(82, 170, 110),
	Bad = Color3.fromRGB(214, 76, 76),
	Gold = Color3.fromRGB(240, 184, 72),
	Cool = Color3.fromRGB(92, 150, 220),
}

-- Score categories, in the order they animate into the bar chart
Style.ScoreOrder = { "finish", "trap", "clutch", "route" }
Style.ScoreColor = {
	finish = Style.UI.Good,
	trap = Style.UI.Bad,
	clutch = Style.UI.Gold,
	route = Style.UI.Cool,
}

Style.Font = {
	Title = Font.fromEnum(Enum.Font.FredokaOne),
	Body = Font.fromEnum(Enum.Font.BuilderSansMedium),
	Bold = Font.fromEnum(Enum.Font.BuilderSansBold),
}

Style.Forest = {
	Grass = Color3.fromRGB(118, 176, 86),
	GrassDark = Color3.fromRGB(92, 150, 72),
	Dirt = Color3.fromRGB(141, 101, 70),
	DirtDark = Color3.fromRGB(112, 80, 58),
	Wood = Color3.fromRGB(196, 146, 96),
	WoodDark = Color3.fromRGB(150, 106, 68),
	Bark = Color3.fromRGB(112, 82, 60),
	Leaf = { Color3.fromRGB(86, 146, 78), Color3.fromRGB(70, 126, 74), Color3.fromRGB(108, 162, 88) },
	Stone = Color3.fromRGB(150, 150, 140),
	Water = Color3.fromRGB(96, 168, 196),
	Hill = Color3.fromRGB(128, 168, 132),
	HillFar = Color3.fromRGB(160, 190, 176),
	Cloud = Color3.fromRGB(252, 250, 246),
}

-- Shared materials for placed objects so they read as one family
Style.Object = {
	Metal = Color3.fromRGB(96, 100, 112),
	MetalLight = Color3.fromRGB(176, 180, 190),
	Danger = Color3.fromRGB(214, 76, 76),
	Spring = Color3.fromRGB(238, 108, 77),
	Honey = Color3.fromRGB(232, 162, 48),
	Ice = Color3.fromRGB(186, 226, 238),
	Rubber = Color3.fromRGB(52, 50, 60),
	Stripe = Color3.fromRGB(240, 184, 72),
	Crumble = Color3.fromRGB(206, 178, 132),
}

return Style
]]></ProtectedString></Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX334AB81ECC3A4AA58E51FDA75F5B4644">
    <Properties><string name="Name">ServerScriptService</string></Properties>
    <Item class="Script" referent="RBX30688872F43E47A08484F12ABFFDFFBF">
      <Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Server entry point. Services are plain modules; order matters only here.

local Services = script.Parent.Services

local PlayerService = require(Services.PlayerService)
local LevelService = require(Services.LevelService)
local BuildService = require(Services.BuildService)
local RoundService = require(Services.RoundService)
local LobbyService = require(Services.LobbyService)
local MatchService = require(Services.MatchService)

PlayerService.init()
LevelService.init()
BuildService.init()
RoundService.init()
LobbyService.init()
MatchService.start()
]]></ProtectedString></Properties>
    </Item>
    <Item class="Folder" referent="RBXAF76D896A74E41249B32E989DB27FD58">
      <Properties><string name="Name">Services</string></Properties>
      <Item class="ModuleScript" referent="RBXB2B58120A8264D58A31C2E745A01BC5F">
        <Properties><string name="Name">BuildService</string><ProtectedString name="Source"><![CDATA[-- The pick box and the build phase.
--
-- Pick: a crate opens with (players + 2) pieces. First click wins a piece;
-- whoever's too slow gets a leftover. Fighting over the good piece is the point.
-- Build: everyone places the piece they grabbed.
--
-- The client only *asks* to pick or place; every rule is re-checked here.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Objects = require(Shared.Objects)

local HazardService = require(script.Parent.HazardService)
local LevelService = require(script.Parent.LevelService)

local BoxEvent = Net.event("Box")
local PickEvent = Net.event("Pick")
local HandEvent = Net.event("Hand")
local PlaceEvent = Net.event("Place")
local PlaceResult = Net.event("PlaceResult")
local Explode = Net.event("Explode")
local Cursor = Net.unreliable("Cursor")

local BuildService = {}

type Slot = { id: string, takenBy: number }

local box = {} :: { Slot }
local pickers = {} :: { Player }
local picked = {} :: { [Player]: string }
local hands = {} :: { [Player]: { string } }
local placed = {} :: { [Player]: boolean }
local lastCursor = {} :: { [Player]: number }
local pickOpen = false
local buildOpen = false

local function weightedPick(pool: { Objects.Def }): Objects.Def
	local total = 0
	for _, d in pool do
		total += d.weight
	end
	local r = math.random() * total
	for _, d in pool do
		r -= d.weight
		if r <= 0 then
			return d
		end
	end
	return pool[#pool]
end

-- Roll the box. Rules: about a third are route pieces so the level can always
-- grow a way through; at most one bomb, and never in round 1 (nothing to bomb).
local function roll(count: number, round: number): { string }
	local items = {}
	local function from(filter: (Objects.Def) -> boolean): string?
		local pool = {}
		for _, d in Objects.List do
			if filter(d) and (d.id ~= "bomb" or (round > 1 and not table.find(items, "bomb"))) then
				table.insert(pool, d)
			end
		end
		if #pool == 0 then
			return nil
		end
		return weightedPick(pool).id
	end
	local routes = math.max(1, math.ceil(count / 3))
	for _ = 1, routes do
		table.insert(items, from(function(d)
			return d.kind == "route"
		end) :: string)
	end
	while #items < count do
		-- avoid more than two of the same thing so the box feels varied
		local id = from(function(d)
			local n = 0
			for _, it in items do
				if it == d.id then
					n += 1
				end
			end
			return n < 2
		end)
		table.insert(items, id :: string)
	end
	for i = #items, 2, -1 do
		local j = math.random(1, i)
		items[i], items[j] = items[j], items[i]
	end
	return items
end

local function finite(n: any): boolean
	return typeof(n) == "number" and n == n and math.abs(n) < 1e4
end

local function sendBox()
	local payload = {}
	for i, s in box do
		payload[i] = { id = s.id, takenBy = s.takenBy }
	end
	local ids = {}
	for _, p in pickers do
		table.insert(ids, p.UserId)
	end
	BoxEvent:FireAllClients(payload, ids)
end

--------------------------------------------------------------------------
-- Pick
--------------------------------------------------------------------------

local function onPick(player: Player, slot: any)
	if not pickOpen or picked[player] or not table.find(pickers, player) then
		return
	end
	if typeof(slot) ~= "number" or slot ~= slot then
		return
	end
	local s = box[math.floor(slot)]
	if not s or s.takenBy ~= 0 then
		return -- someone beat you to it
	end
	s.takenBy = player.UserId
	picked[player] = s.id
	sendBox()
end

function BuildService.openPick(players: { Player }, round: number)
	table.clear(box)
	table.clear(picked)
	pickers = table.clone(players)
	for _, id in roll(#players + Config.Match.BoxExtra, round) do
		table.insert(box, { id = id, takenBy = 0 })
	end
	pickOpen = true
	sendBox()
end

function BuildService.everyonePicked(): boolean
	for _, p in pickers do
		if p.Parent and not picked[p] then
			return false
		end
	end
	return true
end

-- Too slow? You get whatever's left.
function BuildService.closePick()
	pickOpen = false
	for _, p in pickers do
		if p.Parent and not picked[p] then
			local free = {}
			for _, s in box do
				if s.takenBy == 0 then
					table.insert(free, s)
				end
			end
			local s = free[math.random(1, #free)]
			if s then
				s.takenBy = p.UserId
				picked[p] = s.id
			end
		end
	end
	sendBox()
end

--------------------------------------------------------------------------
-- Build
--------------------------------------------------------------------------

local function bomb(pos: Vector3)
	local r = Config.Objects.BombRadius
	for _, model in LevelService.objectsFolder():GetChildren() do
		local def = Objects.ById[model:GetAttribute("Id") :: string]
		if not def then
			continue
		end
		local fp = Objects.footprint(def, model:GetAttribute("Rot") :: number)
		local mx, my = model:GetAttribute("X") :: number, model:GetAttribute("Y") :: number
		-- distance from blast centre to the object's footprint rectangle
		local dx = math.max(math.abs(pos.X - mx) - fp.X / 2, 0)
		local dy = math.max(math.abs(pos.Y - my) - fp.Y / 2, 0)
		if dx * dx + dy * dy <= r * r then
			model:Destroy()
		end
	end
	Explode:FireAllClients(pos)
end

function BuildService.spawn(owner: Player, def: Objects.Def, x: number, y: number, rot: number): Model
	local model = Objects.build(def.id)
	model:PivotTo(Objects.cframe(x, y, rot))
	model:SetAttribute("Owner", owner.UserId)
	model:SetAttribute("OwnerName", owner.DisplayName)
	model:SetAttribute("X", x)
	model:SetAttribute("Y", y)
	model:SetAttribute("Rot", rot)
	model:SetAttribute("PlacedAt", workspace:GetServerTimeNow())
	model.Parent = LevelService.objectsFolder()

	local belt = model:FindFirstChild("Belt") :: BasePart?
	if belt then
		belt.AssemblyLinearVelocity = belt.CFrame.RightVector * Config.Objects.ConveyorSpeed
	end
	HazardService.watch(model)
	return model
end

local function onPlace(player: Player, id: any, x: any, y: any, rot: any)
	local function reject(reason: string)
		PlaceResult:FireClient(player, false, reason)
	end
	if not buildOpen or placed[player] then
		return reject("Building is closed")
	end
	if typeof(id) ~= "string" or not finite(x) or not finite(y) or not finite(rot) then
		return reject("Bad request")
	end
	if rot % 90 ~= 0 then
		return reject("Bad rotation")
	end
	rot %= 360
	local hand = hands[player]
	local def = Objects.ById[id]
	if not hand or not def or not table.find(hand, id) then
		return reject("That piece isn't yours")
	end

	local sx, sy = Objects.snap(def, x, y, rot)
	local ok, reason = Objects.check(def, sx, sy, rot)
	if not ok then
		return reject(reason or "Can't place there")
	end

	placed[player] = true
	hands[player] = nil
	if def.id == "bomb" then
		bomb(Vector3.new(sx, sy, 0))
	else
		BuildService.spawn(player, def, sx, sy, rot)
	end
	PlaceResult:FireClient(player, true)
	HandEvent:FireClient(player, nil)
	return
end

local function onCursor(player: Player, id: any, x: any, y: any, rot: any)
	if not buildOpen or placed[player] or not hands[player] then
		return
	end
	local now = os.clock()
	if now - (lastCursor[player] or 0) < 0.06 then
		return
	end
	lastCursor[player] = now
	if typeof(id) ~= "string" or not finite(x) or not finite(y) or not finite(rot) then
		return
	end
	if id ~= "" and not table.find(hands[player], id) then
		return
	end
	for _, other in Players:GetPlayers() do
		if other ~= player then
			Cursor:FireClient(other, player.UserId, id, x, y, rot)
		end
	end
end

function BuildService.openBuild(players: { Player })
	table.clear(hands)
	table.clear(placed)
	for _, p in players do
		local id = picked[p]
		if id and p.Parent then
			hands[p] = { id }
			HandEvent:FireClient(p, hands[p])
		else
			placed[p] = true -- nothing to place (joined mid-pick)
		end
	end
	buildOpen = true
end

function BuildService.closeBuild()
	buildOpen = false
	for p in hands do
		HandEvent:FireClient(p, nil)
	end
	table.clear(hands)
	for _, p in Players:GetPlayers() do
		Cursor:FireClient(p, 0, "", 0, 0, 0) -- userId 0 = clear all ghosts
	end
end

function BuildService.everyonePlaced(players: { Player }): boolean
	for _, p in players do
		if p.Parent and not placed[p] then
			return false
		end
	end
	return true
end

function BuildService.clearObjects()
	LevelService.objectsFolder():ClearAllChildren()
end

function BuildService.init()
	PickEvent.OnServerEvent:Connect(onPick)
	PlaceEvent.OnServerEvent:Connect(onPlace)
	Cursor.OnServerEvent:Connect(onCursor)
	Players.PlayerRemoving:Connect(function(p)
		hands[p] = nil
		placed[p] = nil
		picked[p] = nil
		lastCursor[p] = nil
	end)
end

return BuildService
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX905475ACBC22425A9F008807C0280AFE">
        <Properties><string name="Name">HazardService</string><ProtectedString name="Source"><![CDATA[-- Server-side object behaviour that has to be authoritative:
-- deadly contact, crumbling ledges, and "you used your own route" tracking.
-- Knockback/launch effects run on the client (it owns its character's physics),
-- because they must feel instant.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Objects = require(Shared.Objects)

local HazardService = {}

-- Set by RoundService
HazardService.isRunning = function(_player: Player): boolean
	return false
end
HazardService.onDeadly = function(_player: Player, _model: Model) end

local touchedOwn = {} :: { [Player]: boolean }
local crumbles = {} :: { Model }
local lasers = {} :: { Model }

local function playerFromHit(hit: BasePart): Player?
	if hit.Name ~= "HumanoidRootPart" then
		return nil
	end
	return Players:GetPlayerFromCharacter(hit.Parent)
end

local function crumble(model: Model)
	if model:GetAttribute("TriggeredAt") then
		return
	end
	model:SetAttribute("TriggeredAt", workspace:GetServerTimeNow())
	task.delay(Config.Objects.CrumbleDelay, function()
		if not model.Parent then
			return
		end
		model:SetAttribute("Fallen", true)
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") and p:GetAttribute("Solid") then
				p.CanCollide = false
			end
		end
		task.delay(Config.Objects.CrumbleRespawn, function()
			HazardService.restore(model)
		end)
	end)
end

function HazardService.restore(model: Model)
	if not model.Parent then
		return
	end
	model:SetAttribute("TriggeredAt", nil)
	model:SetAttribute("Fallen", nil)
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p:GetAttribute("Solid") then
			p.CanCollide = true
		end
	end
end

function HazardService.watch(model: Model)
	local def = Objects.ById[model:GetAttribute("Id") :: string]
	local owner = model:GetAttribute("Owner") :: number
	local isRoute = def and def.kind == "route"

	for _, p in model:GetDescendants() do
		if not p:IsA("BasePart") then
			continue
		end
		if p:GetAttribute("Deadly") then
			p.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				if player and HazardService.isRunning(player) then
					HazardService.onDeadly(player, model)
				end
			end)
		elseif p:GetAttribute("Solid") and (isRoute or p:GetAttribute("Crumble")) then
			p.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				if not player or not HazardService.isRunning(player) then
					return
				end
				if p:GetAttribute("Crumble") then
					crumble(model)
				end
				if isRoute and player.UserId == owner then
					touchedOwn[player] = true
				end
			end)
		end
	end

	if model:FindFirstChild("Slab") and (model:FindFirstChild("Slab") :: BasePart):GetAttribute("Crumble") then
		table.insert(crumbles, model)
	end
	if def and def.id == "laser" then
		table.insert(lasers, model)
	end
end

local function pivotOf(model: Model): CFrame
	return Objects.cframe(model:GetAttribute("X") :: number, model:GetAttribute("Y") :: number, model:GetAttribute("Rot") :: number)
end

-- Called ~10x a second during a run. Lasers are checked by geometry instead
-- of Touched, because their on/off state comes from the clock.
function HazardService.tick(running: { Player })
	local now = workspace:GetServerTimeNow()
	for i = #lasers, 1, -1 do
		local m = lasers[i]
		if not m.Parent then
			table.remove(lasers, i)
			continue
		end
		local age = now - (m:GetAttribute("PlacedAt") :: number)
		if Objects.laserState(age) ~= "on" then
			continue
		end
		local pivot = pivotOf(m)
		local a = pivot * Vector3.new(1, 0, 0)
		local dir = pivot.RightVector
		local len = Objects.laserLength(m, pivot)
		for _, player in running do
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local rel = root.Position - a
				local along = math.clamp(rel:Dot(dir), 0, len)
				if (rel - dir * along).Magnitude < 1.15 then
					HazardService.onDeadly(player, m)
				end
			end
		end
	end
end

-- Called at the start of each run so the level is identical for everyone
function HazardService.resetRound()
	table.clear(touchedOwn)
	for i = #crumbles, 1, -1 do
		local m = crumbles[i]
		if m.Parent then
			HazardService.restore(m)
		else
			table.remove(crumbles, i)
		end
	end
end

function HazardService.usedOwnRoute(player: Player): boolean
	return touchedOwn[player] == true
end

return HazardService
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX656EEB4B15C345EEBA2FFB82D10EF501">
        <Properties><string name="Name">LevelService</string><ProtectedString name="Source"><![CDATA[-- Builds a layout into the world: playable pieces, start, flag, safe zones,
-- and a background with just enough life in it (trees, hills, a river, clouds).

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Levels = require(Shared.Levels)
local Style = require(Shared.Style)

local F = Style.Forest
local LevelService = {}

LevelService.layout = nil :: Levels.Layout?
LevelService.goalZone = nil :: BasePart?
LevelService.spawn = Vector3.zero
LevelService.flag = Vector3.zero

local level: Folder

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function solid(p: Part): Part
	p.CanCollide = true
	p.CanQuery = true
	p:SetAttribute("Solid", true)
	return p
end

local function blob(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3): Part
	local p = part(parent, name, size, cf, color)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2) -- cylinder axis X -> Y
local BOTTOM = -26

--------------------------------------------------------------------------
-- Playable pieces
--------------------------------------------------------------------------

local builders = {}

builders.ground = function(p: Levels.Piece, rng: Random)
	local w = p.x1 - p.x0
	local cx = (p.x0 + p.x1) / 2
	solid(part(level, "Grass", Vector3.new(w + 0.6, 1.2, 8.4), CFrame.new(cx, p.top - 0.6, 0), F.Grass))
	local h = p.top - 1.2 - BOTTOM
	solid(part(level, "Dirt", Vector3.new(w, h, 8), CFrame.new(cx, BOTTOM + h / 2, 0), F.Dirt))
	part(level, "DirtBand", Vector3.new(w + 0.02, 1.4, 8.02), CFrame.new(cx, p.top - 3.2, 0), F.DirtDark)
	-- a couple of grass tufts at the back edge, never in the play lane
	for _ = 1, math.max(1, math.floor(w / 8)) do
		local x = rng:NextNumber(p.x0 + 1, p.x1 - 1)
		blob(level, "Tuft", Vector3.new(1.4, 1, 1), CFrame.new(x, p.top + 0.2, -3.4), F.GrassDark)
	end
end

-- A floating grassy chunk: the "high route" piece
builders.ledge = function(p: Levels.Piece, rng: Random)
	local w = p.x1 - p.x0
	local cx = (p.x0 + p.x1) / 2
	solid(part(level, "Grass", Vector3.new(w + 0.6, 1.2, 7.4), CFrame.new(cx, p.top - 0.6, 0), F.Grass))
	solid(part(level, "Dirt", Vector3.new(w, 2.6, 7), CFrame.new(cx, p.top - 2.5, 0), F.Dirt))
	blob(level, "Underside", Vector3.new(w * 0.8, 3.4, 6), CFrame.new(cx, p.top - 3.6, 0), F.DirtDark)
	blob(level, "Root", Vector3.new(0.6, 2.4, 0.6), CFrame.new(cx + rng:NextNumber(-w / 3, w / 3), p.top - 5, 1.6), F.Bark)
	blob(level, "Tuft", Vector3.new(1.4, 1, 1), CFrame.new(cx + rng:NextNumber(-w / 3, w / 3), p.top + 0.2, -3), F.GrassDark)
end

builders.stump = function(p: Levels.Piece)
	local w = p.x1 - p.x0
	local cx = (p.x0 + p.x1) / 2
	local h = p.top - BOTTOM
	solid(part(level, "Stump", Vector3.new(h, w, w), CFrame.new(cx, BOTTOM + h / 2, 0) * UPRIGHT, F.Bark, Enum.PartType.Cylinder))
	part(level, "Rings", Vector3.new(0.12, w - 0.8, w - 0.8), CFrame.new(cx, p.top + 0.02, 0) * UPRIGHT, F.Wood, Enum.PartType.Cylinder)
	blob(level, "Moss", Vector3.new(w * 0.7, 0.8, w * 0.6), CFrame.new(cx - w * 0.15, p.top - 0.1, -w * 0.25), F.GrassDark)
end

builders.rock = function(p: Levels.Piece)
	local w = p.x1 - p.x0
	local cx = (p.x0 + p.x1) / 2
	local h = p.top - BOTTOM
	solid(part(level, "Rock", Vector3.new(w, h, 6), CFrame.new(cx, BOTTOM + h / 2, 0), F.Stone))
	blob(level, "RockCap", Vector3.new(w + 0.6, 2.2, 6.4), CFrame.new(cx, p.top - 0.9, 0), F.Stone)
end

builders.log = function(p: Levels.Piece)
	local w = p.x1 - p.x0
	local cx = (p.x0 + p.x1) / 2
	solid(part(level, "Log", Vector3.new(w, 4, 4), CFrame.new(cx, p.top - 2, 0), F.Bark, Enum.PartType.Cylinder))
	for _, x in { p.x0, p.x1 } do
		part(level, "LogEnd", Vector3.new(0.3, 3.4, 3.4), CFrame.new(x, p.top - 2, 0), F.Wood, Enum.PartType.Cylinder)
		local sx = x + (x == p.x0 and 3 or -3)
		local h = p.top - 4 - BOTTOM
		part(level, "Support", Vector3.new(3, h, 3), CFrame.new(sx, BOTTOM + h / 2, 0), F.Stone)
	end
	-- a little branch stub for character
	part(level, "Branch", Vector3.new(2.6, 0.7, 0.7), CFrame.new(cx + w * 0.2, p.top - 0.4, -1.6) * CFrame.Angles(0, 0, math.rad(35)), F.Bark)
end

builders.tree = function(p: Levels.Piece, rng: Random)
	local w = p.x1 - p.x0
	local cx = (p.x0 + p.x1) / 2
	local h = p.top - 1 - BOTTOM
	part(level, "Trunk", Vector3.new(h, 2.4, 2.4), CFrame.new(cx, BOTTOM + h / 2, -0.5) * UPRIGHT, F.Bark, Enum.PartType.Cylinder)
	solid(part(level, "Deck", Vector3.new(w, 1, 6), CFrame.new(cx, p.top - 0.5, 0), F.Wood))
	part(level, "DeckTrim", Vector3.new(w + 0.02, 0.24, 6.02), CFrame.new(cx, p.top - 0.9, 0), F.WoodDark)
	-- canopy sits behind the lane so it frames the platform without hiding anyone
	local leaf = F.Leaf[rng:NextInteger(1, #F.Leaf)]
	blob(level, "Canopy", Vector3.new(w + 7, 7, 5), CFrame.new(cx, p.top + 5, -5), leaf)
	blob(level, "Canopy", Vector3.new(w + 2, 5, 4), CFrame.new(cx + 2, p.top + 9, -6), F.Leaf[1])
end

--------------------------------------------------------------------------
-- Start, flag, background
--------------------------------------------------------------------------

local function buildStart(spawn: Vector3)
	part(level, "SignPost", Vector3.new(0.4, 3.2, 0.4), CFrame.new(spawn.X - 4, spawn.Y + 1.6, -2.6), F.WoodDark)
	local board = part(level, "Sign", Vector3.new(2.8, 1.2, 0.3), CFrame.new(spawn.X - 4, spawn.Y + 3, -2.6), F.Wood)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(140, 60)
	gui.LightInfluence = 1
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.FontFace = Style.Font.Title
	label.TextScaled = true
	label.TextColor3 = F.WoodDark
	label.Text = "GO  >"
	label.Parent = gui
	-- SurfaceGui Front faces -Z; turn the board around so the camera reads it
	board.CFrame *= CFrame.Angles(0, math.pi, 0)
end

local function buildFlag(flag: Vector3)
	part(level, "FlagBase", Vector3.new(1.6, 0.6, 1.6), CFrame.new(flag.X, flag.Y + 0.3, -1), F.Stone)
	part(level, "Pole", Vector3.new(0.35, 9, 0.35), CFrame.new(flag.X, flag.Y + 4.5, -1), Style.UI.Paper)
	part(level, "PoleTop", Vector3.new(0.7, 0.7, 0.7), CFrame.new(flag.X, flag.Y + 9.1, -1), Style.UI.Gold, Enum.PartType.Ball)
	local cloth = part(level, "Flag", Vector3.new(3.4, 2.2, 0.12), CFrame.new(flag.X + 1.85, flag.Y + 7.7, -1), Style.UI.Accent)
	cloth:SetAttribute("Group", "flag")

	local zone = part(level, "GoalZone", Vector3.new(5, 8, 6), CFrame.new(flag.X, flag.Y + 4, 0), Style.UI.Gold)
	zone.Transparency = 1
	zone.CanTouch = true
	LevelService.goalZone = zone
end

local function safeZone(center: Vector3)
	local z = part(level, "SafeZone", Vector3.new(10, 8, 6), CFrame.new(center.X, center.Y + 4, 0), Style.UI.Good)
	z.Transparency = 1
	z.CanQuery = true
end

local function buildBackground(layout: Levels.Layout, rng: Random)
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = level

	local midX = (layout.buildMin.X + layout.buildMax.X) / 2

	local water = part(decor, "River", Vector3.new(420, 1, 150), CFrame.new(midX, -14, -40), F.Water)
	water.Transparency = 0.1
	water.CastShadow = false

	for i = 1, 5 do
		local w = rng:NextNumber(90, 150)
		blob(decor, "Hill", Vector3.new(w, w * 0.5, 30), CFrame.new(midX - 200 + i * 75 + rng:NextNumber(-20, 20), -12, -150), F.HillFar)
	end
	for i = 1, 4 do
		local w = rng:NextNumber(60, 100)
		blob(decor, "Hill", Vector3.new(w, w * 0.45, 24), CFrame.new(midX - 160 + i * 70 + rng:NextNumber(-15, 15), -14, -95), F.Hill)
	end

	-- Background trees: varied but restrained (one silhouette, three greens)
	for _ = 1, 16 do
		local x = rng:NextNumber(layout.buildMin.X - 40, layout.buildMax.X + 40)
		local z = rng:NextNumber(-60, -16)
		local h = rng:NextNumber(18, 34)
		part(decor, "Trunk", Vector3.new(h, 1.6, 1.6), CFrame.new(x, -14 + h / 2, z) * UPRIGHT, F.Bark, Enum.PartType.Cylinder)
		local leaf = F.Leaf[rng:NextInteger(1, #F.Leaf)]
		local r = rng:NextNumber(7, 11)
		blob(decor, "Leaves", Vector3.new(r, r * 1.1, r), CFrame.new(x, -14 + h + r * 0.2, z), leaf)
		blob(decor, "Leaves", Vector3.new(r * 0.7, r * 0.75, r * 0.7), CFrame.new(x + r * 0.35, -14 + h + r * 0.65, z + 1), leaf)
	end

	for i = 1, 6 do
		local cloud = Instance.new("Model")
		cloud.Name = "Cloud"
		local x = midX - 150 + i * 55 + rng:NextNumber(-15, 15)
		local y = rng:NextNumber(58, 85)
		local s = rng:NextNumber(0.8, 1.4)
		blob(cloud, "Puff", Vector3.new(16, 6, 6) * s, CFrame.new(x, y, -110), F.Cloud)
		blob(cloud, "Puff", Vector3.new(9, 6, 5) * s, CFrame.new(x - 4 * s, y + 2.2 * s, -110), F.Cloud)
		blob(cloud, "Puff", Vector3.new(8, 5, 5) * s, CFrame.new(x + 4 * s, y + 1.6 * s, -110), F.Cloud)
		for _, p in cloud:GetChildren() do
			(p :: BasePart).CastShadow = false
		end
		cloud.WorldPivot = CFrame.new(x, y, -110)
		cloud:SetAttribute("Group", "cloud")
		cloud.Parent = decor
	end
end

local function setupLighting()
	Lighting.ClockTime = 15.2
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(96, 92, 104)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 146, 156)
	Lighting.ShadowSoftness = 0.35
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.05
	Lighting.GlobalShadows = true

	for _, c in Lighting:GetChildren() do
		if c:IsA("PostEffect") or c:IsA("Atmosphere") then
			c:Destroy()
		end
	end
	local atmo = Instance.new("Atmosphere")
	atmo.Density = 0.26
	atmo.Offset = 0.1
	atmo.Haze = 1.2
	atmo.Glare = 0
	atmo.Color = Color3.fromRGB(236, 226, 206)
	atmo.Decay = Color3.fromRGB(150, 170, 180)
	atmo.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.06
	cc.Contrast = 0.04
	cc.Parent = Lighting
end

--------------------------------------------------------------------------

function LevelService.build(layout: Levels.Layout)
	LevelService.clear()
	LevelService.layout = layout
	local rng = Random.new(layout.seed)

	level = Instance.new("Folder")
	level.Name = "Level"
	level:SetAttribute("Name", layout.name)
	level:SetAttribute("BuildMin", Vector3.new(layout.buildMin.X, layout.buildMin.Y, 0))
	level:SetAttribute("BuildMax", Vector3.new(layout.buildMax.X, layout.buildMax.Y, 0))

	for _, piece in layout.pieces do
		builders[piece.kind](piece, rng)
	end

	LevelService.spawn = Vector3.new(layout.spawn.X, layout.spawn.Y, 0)
	LevelService.flag = Vector3.new(layout.flag.X, layout.flag.Y, 0)
	level:SetAttribute("Spawn", LevelService.spawn)
	level:SetAttribute("Flag", LevelService.flag)

	buildStart(LevelService.spawn)
	buildFlag(LevelService.flag)
	safeZone(LevelService.spawn)
	safeZone(LevelService.flag)
	buildBackground(layout, rng)

	level.Parent = workspace
end

function LevelService.clear()
	local old = workspace:FindFirstChild("Level")
	if old then
		old:Destroy()
	end
	LevelService.goalZone = nil
end

function LevelService.objectsFolder(): Folder
	local f = workspace:FindFirstChild("Objects")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Objects"
		f.Parent = workspace
	end
	return f :: Folder
end

function LevelService.pick(previous: string?): Levels.Layout
	local pool = {}
	for _, l in Levels.Forest do
		if l.name ~= previous then
			table.insert(pool, l)
		end
	end
	return pool[math.random(1, #pool)]
end

function LevelService.init()
	setupLighting()
	LevelService.objectsFolder()
end

return LevelService
]]></ProtectedString></Properties>
