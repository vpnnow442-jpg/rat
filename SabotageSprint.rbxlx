      <Item class="ModuleScript" referent="RBX4D1B2CCB75E24F299CE4558C2D59DC45">
        <Properties><string name="Name">Characters</string><ProtectedString name="Source"><![CDATA[--!strict
-- The cast. Every animal shares the exact same hitbox (HumanoidRootPart);
-- everything you see is massless decoration animated by the client.

local Config = require(script.Parent.Config)

export type Species = {
	id: string,
	name: string,
	body: Color3,
	belly: Color3,
	feet: Color3,
	ears: ("pointy" | "round")?,
	earColor: Color3?,
	earTip: Color3?,
	snout: ("long" | "short" | "beak")?,
	snoutColor: Color3?,
	mask: Color3?,
	bulgyEyes: boolean?,
	flippers: boolean?,
	tail: ("bushy" | "ringed")?,
	tailTip: Color3?,
}

local Characters = {}

local NOSE = Color3.fromRGB(40, 34, 38)
local EYE = Color3.fromRGB(28, 24, 30)

Characters.List = {
	{
		id = "fox", name = "Fox",
		body = Color3.fromRGB(226, 121, 58), belly = Color3.fromRGB(250, 240, 228), feet = Color3.fromRGB(70, 52, 48),
		ears = "pointy", earTip = Color3.fromRGB(70, 52, 48),
		snout = "long", snoutColor = Color3.fromRGB(250, 240, 228),
		tail = "bushy", tailTip = Color3.fromRGB(250, 240, 228),
	},
	{
		id = "raccoon", name = "Raccoon",
		body = Color3.fromRGB(138, 136, 146), belly = Color3.fromRGB(212, 208, 204), feet = Color3.fromRGB(60, 58, 66),
		ears = "round", earColor = Color3.fromRGB(110, 108, 118),
		snout = "short", snoutColor = Color3.fromRGB(212, 208, 204),
		mask = Color3.fromRGB(56, 54, 64),
		tail = "ringed", tailTip = Color3.fromRGB(56, 54, 64),
	},
	{
		id = "penguin", name = "Penguin",
		body = Color3.fromRGB(48, 52, 68), belly = Color3.fromRGB(248, 246, 240), feet = Color3.fromRGB(240, 160, 60),
		snout = "beak", snoutColor = Color3.fromRGB(240, 160, 60),
		flippers = true,
	},
	{
		id = "frog", name = "Frog",
		body = Color3.fromRGB(112, 178, 92), belly = Color3.fromRGB(214, 230, 164), feet = Color3.fromRGB(92, 150, 76),
		bulgyEyes = true,
	},
} :: { Species }

Characters.ById = {} :: { [string]: Species }
for _, s in Characters.List do
	Characters.ById[s.id] = s
end

local function piece(model: Model, name: string, size: Vector3, color: Color3, ball: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Massless = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if ball then
		p.Shape = Enum.PartType.Ball
	else
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = model
	return p
end

local function weld(p0: BasePart, p1: BasePart, c0: CFrame)
	local w = Instance.new("Weld")
	w.Part0 = p0
	w.Part1 = p1
	w.C0 = c0
	w.Parent = p1
end

local function motor(name: string, p0: BasePart, p1: BasePart, c0: CFrame, c1: CFrame?): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = p0
	m.Part1 = p1
	m.C0 = c0
	m.C1 = c1 or CFrame.identity
	m.Parent = p0
	return m
end

-- Builds a ready-to-use character model. Local -Z is "forward".
function Characters.build(speciesId: string): Model
	local s = Characters.ById[speciesId] or Characters.List[1]
	local model = Instance.new("Model")
	model.Name = s.name

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(1.8, 2.4, 1.8)
	root.Transparency = 1
	root.CanCollide = true
	root.CanQuery = false
	root.CanTouch = true
	root.CollisionGroup = "Players"
	root.Parent = model
	model.PrimaryPart = root

	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 1
	hum.RequiresNeck = false
	hum.BreakJointsOnDeath = false
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.UseJumpPower = true
	hum.JumpPower = Config.Movement.JumpPower
	hum.WalkSpeed = Config.Movement.WalkSpeed
	hum.Parent = model

	local body = piece(model, "Body", Vector3.new(2.4, 2.4, 2.4), s.body)
	motor("BodyJoint", root, body, CFrame.new(0, -0.7, 0))

	local head = piece(model, "Head", Vector3.new(2, 1.9, 1.9), s.body)
	motor("Neck", body, head, CFrame.new(0, 1.45, -0.45))

	-- Belly patch
	if s.flippers then
		weld(body, piece(model, "Belly", Vector3.new(1.9, 2, 1.2), s.belly), CFrame.new(0, -0.1, -0.62))
	else
		weld(body, piece(model, "Belly", Vector3.new(1.5, 1.6, 0.9), s.belly), CFrame.new(0, -0.15, -0.8))
	end

	-- Feet (animated)
	for i, x in { -0.45, 0.45 } do
		local foot = piece(model, i == 1 and "FootL" or "FootR", Vector3.new(0.5, 0.4, 0.8), s.feet)
		motor(i == 1 and "HipL" or "HipR", body, foot, CFrame.new(x, -1.25, -0.15))
	end

	-- Face
	if s.mask then
		weld(head, piece(model, "Mask", Vector3.new(1.9, 0.5, 1.5), s.mask), CFrame.new(0, 0.2, -0.35))
	end
	for _, side in { -1, 1 } do
		if s.bulgyEyes then
			local white = piece(model, "EyeWhite", Vector3.new(0.8, 0.8, 0.8), Color3.new(1, 1, 1), true)
			weld(head, white, CFrame.new(side * 0.5, 0.85, -0.35))
			weld(head, piece(model, "Eye", Vector3.new(0.12, 0.4, 0.34), EYE), CFrame.new(side * 0.88, 0.9, -0.45))
		else
			weld(head, piece(model, "Eye", Vector3.new(0.12, 0.42, 0.3), EYE), CFrame.new(side * 0.95, 0.2, -0.45))
			weld(head, piece(model, "Shine", Vector3.new(0.1, 0.1, 0.1), Color3.new(1, 1, 1), true), CFrame.new(side * 1.0, 0.3, -0.5))
		end
	end

	if s.snout == "long" then
		weld(head, piece(model, "Snout", Vector3.new(0.8, 0.7, 1.2), s.snoutColor or s.belly), CFrame.new(0, -0.2, -0.95))
		weld(head, piece(model, "Nose", Vector3.new(0.32, 0.32, 0.32), NOSE, true), CFrame.new(0, -0.05, -1.55))
	elseif s.snout == "short" then
		weld(head, piece(model, "Snout", Vector3.new(0.8, 0.6, 0.8), s.snoutColor or s.belly), CFrame.new(0, -0.25, -0.8))
		weld(head, piece(model, "Nose", Vector3.new(0.28, 0.28, 0.28), NOSE, true), CFrame.new(0, -0.1, -1.18))
	elseif s.snout == "beak" then
		weld(head, piece(model, "Beak", Vector3.new(0.5, 0.35, 0.9), s.snoutColor or s.feet), CFrame.new(0, -0.15, -1.0))
	end

	-- Ears
	for _, side in { -1, 1 } do
		if s.ears == "pointy" then
			local ear = piece(model, "Ear", Vector3.new(0.35, 1.1, 0.7), s.earColor or s.body)
			weld(head, ear, CFrame.new(side * 0.45, 1.0, 0.1) * CFrame.Angles(0, 0, math.rad(-side * 15)))
			weld(ear, piece(model, "EarTip", Vector3.new(0.37, 0.45, 0.5), s.earTip or s.body), CFrame.new(0, 0.38, 0))
		elseif s.ears == "round" then
			weld(head, piece(model, "Ear", Vector3.new(0.3, 0.7, 0.7), s.earColor or s.body), CFrame.new(side * 0.55, 0.85, 0.1))
		end
		if s.flippers then
			local flipper = piece(model, "Flipper", Vector3.new(0.3, 1.2, 0.6), s.body)
			motor(side < 0 and "FlipL" or "FlipR", body, flipper, CFrame.new(side * 1.15, -0.1, 0) * CFrame.Angles(0, 0, math.rad(side * 20)))
		end
	end

	-- Tail (animated)
	if s.tail then
		local tail = piece(model, "Tail", Vector3.new(0.9, 0.9, 2), s.body)
		motor("TailJoint", body, tail, CFrame.new(0, -0.2, 1.0) * CFrame.Angles(math.rad(35), 0, 0), CFrame.new(0, 0, -0.9))
		weld(tail, piece(model, "TailTip", Vector3.new(0.78, 0.78, 0.7), s.tailTip or s.belly), CFrame.new(0, 0, 0.75))
		if s.tail == "ringed" then
			weld(tail, piece(model, "Ring", Vector3.new(0.96, 0.96, 0.25), s.tailTip or s.belly), CFrame.new(0, 0, -0.15))
		end
	end

	model:SetAttribute("Species", s.id)
	return model
end

return Characters
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX8A6B5C97D4DE4D1CB2B709E9AC0A7ABC">
        <Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- Every tuning number lives here so playtesting changes are one-line edits.

local Config = {}

Config.Match = {
	MinPlayers = 1, -- 1 so it can be tested solo in Studio
	Rounds = 8,
	FinalRoundMultiplier = 2,
	IntroTime = 4,
	BuildTime = 22,
	CountdownTime = 3,
	RunTime = 45,
	ResultsTime = 7,
	WinnerTime = 10,
	HandSize = 3,
}

Config.Scoring = {
	Place = { 100, 75, 50, 25 }, -- 5th and lower get the last value
	Trap = 25, -- per opponent your object takes out
	TrapCap = 75, -- per round, so one trap can't decide the whole match
	Clutch = 15, -- finish with under ClutchWindow seconds left
	ClutchWindow = 5,
	OwnRoute = 15, -- finish after touching a route piece you placed
}

Config.Movement = {
	WalkSpeed = 22,
	JumpPower = 54,
	AirJumpPower = 46,
	AirJumps = 1,
	CoyoteTime = 0.1,
	JumpBuffer = 0.12,
	WallSlideSpeed = 9,
	WallJumpPower = Vector3.new(26, 50, 0),
	WallJumpLock = 0.18,
	IceAccel = 2.2, -- lower = slipperier
	HoneySpeed = 0.45,
	HoneyJump = 0.6,
}

Config.Objects = {
	SpringPower = 92,
	FanAccel = 150,
	FanMaxSpeed = 55,
	ConveyorSpeed = 14,
	HammerKnock = Vector3.new(62, 34, 0),
	CannonSpeed = 24,
	CannonInterval = 2.6,
	CannonKnock = Vector3.new(58, 30, 0),
	CrumbleDelay = 0.55,
	CrumbleRespawn = 3.5,
	BombRadius = 5,
}

-- 2.5D: everything lives on the Z = 0 plane, the camera looks down -Z.
Config.World = {
	KillY = -12,
	Hold = Vector3.new(0, 80, 260), -- behind the camera, where parked characters wait
	GoalMinTime = 1.5, -- anti-teleport sanity check
}

return Config
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX7C606E1A780247559B82C05E1AF4C22A">
        <Properties><string name="Name">Levels</string><ProtectedString name="Source"><![CDATA[--!strict
-- Hand-authored layouts, stored as plain data.
-- The same shape will be what community levels save to DataStores later.
--
-- Design rules every layout follows:
--   * start and flag are on solid ground with clear space around them
--   * the bare layout is beatable with a double jump, but not comfortably
--   * there is open air above and between pieces for players to build in

export type Piece = {
	kind: "ground" | "stump" | "tree" | "rock" | "log",
	x0: number,
	x1: number,
	top: number,
}

export type Layout = {
	name: string,
	world: string,
	spawn: Vector2, -- point on the start ledge surface
	flag: Vector2, -- point on the goal ledge surface
	buildMin: Vector2,
	buildMax: Vector2,
	pieces: { Piece },
	seed: number,
}

local Levels = {}

Levels.Forest = {
	{
		name = "Mossy Hollow",
		world = "Forest",
		spawn = Vector2.new(2, 10),
		flag = Vector2.new(108, 14),
		buildMin = Vector2.new(-6, -8),
		buildMax = Vector2.new(120, 44),
		seed = 11,
		pieces = {
			{ kind = "ground", x0 = -8, x1 = 10, top = 10 },
			{ kind = "ground", x0 = 24, x1 = 36, top = 6 },
			{ kind = "stump", x0 = 48, x1 = 53, top = 14 },
			{ kind = "ground", x0 = 64, x1 = 78, top = 8 },
			{ kind = "ground", x0 = 94, x1 = 122, top = 14 },
		},
	},
	{
		name = "Fallen Log",
		world = "Forest",
		spawn = Vector2.new(0, 12),
		flag = Vector2.new(106, 10),
		buildMin = Vector2.new(-6, -8),
		buildMax = Vector2.new(120, 44),
		seed = 23,
		pieces = {
			{ kind = "ground", x0 = -8, x1 = 8, top = 12 },
			{ kind = "log", x0 = 20, x1 = 56, top = 6 },
			{ kind = "rock", x0 = 68, x1 = 75, top = 3 },
			{ kind = "ground", x0 = 90, x1 = 122, top = 10 },
		},
	},
	{
		name = "Canopy Run",
		world = "Forest",
		spawn = Vector2.new(0, 20),
		flag = Vector2.new(110, 18),
		buildMin = Vector2.new(-6, -8),
		buildMax = Vector2.new(120, 48),
		seed = 37,
		pieces = {
			{ kind = "ground", x0 = -8, x1 = 8, top = 20 },
			{ kind = "tree", x0 = 22, x1 = 30, top = 14 },
			{ kind = "tree", x0 = 40, x1 = 46, top = 22 },
			{ kind = "tree", x0 = 58, x1 = 66, top = 12 },
			{ kind = "tree", x0 = 78, x1 = 85, top = 20 },
			{ kind = "ground", x0 = 98, x1 = 122, top = 18 },
		},
	},
} :: { Layout }

return Levels
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXC744054353544918A90E9FF96FAD06C6">
        <Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!strict
-- All remotes in one place. Server creates them, clients wait for them.
-- Rule: clients only ever *ask*. The server decides everything that matters.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local RELIABLE = {
	"MatchState", -- S->C  phase, timers, round
	"Scores", -- S->C  totals
	"Hand", -- S->C  your cards for this build phase (nil closes)
	"Place", -- C->S  request to place a card
	"PlaceResult", -- S->C  ok / reason
	"Fail", -- S->C  someone got taken out
	"Finish", -- S->C  someone reached the flag
	"RoundResults", -- S->C  per-player breakdown
	"Explode", -- S->C  bomb went off (visual only)
	"Notify", -- S->C  small toast
}

local UNRELIABLE = {
	"Cursor", -- C->S->C  live ghost previews of other builders
}

local Net = {}

local folder: Folder
if RunService:IsServer() then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in RELIABLE do
		local r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = folder
	end
	for _, name in UNRELIABLE do
		local r = Instance.new("UnreliableRemoteEvent")
		r.Name = name
		r.Parent = folder
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Net.event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Net.unreliable(name: string): UnreliableRemoteEvent
	return folder:WaitForChild(name) :: UnreliableRemoteEvent
end

return Net
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX3F8DB816FA284484BC2CBCDD27C6A340">
        <Properties><string name="Name">Objects</string><ProtectedString name="Source"><![CDATA[--!strict
-- Placeable object definitions + their models.
-- The server builds the real thing; the client builds the same model for
-- ghost previews and card icons, so what you see is exactly what you get.
--
-- Model conventions (read by server services and client controllers):
--   part attribute Solid   -> you can stand on it
--   part attribute Deadly  -> touching it with your hitbox takes you out
--   part attribute Surface -> "ice" | "honey"
--   part attribute Group   -> client animates it: "spin" | "fan" | "arm" | "mover" | "wind" | "pad"

local Style = require(script.Parent.Style)
local Config = require(script.Parent.Config)

local O = Style.Object
local F = Style.Forest
local DEPTH = 4
local FRONT = DEPTH / 2 + 0.02

export type Def = {
	id: string,
	name: string,
	blurb: string,
	kind: "route" | "trap" | "tool",
	size: Vector2, -- footprint at rotation 0
	weight: number,
	travel: number?,
}

local Objects = {}

Objects.List = {
	{ id = "plank", name = "Plank", blurb = "A trusty wooden ledge.", kind = "route", size = Vector2.new(6, 1), weight = 3 },
	{ id = "crate", name = "Crate", blurb = "Solid. Stack it, hide behind it.", kind = "route", size = Vector2.new(3, 3), weight = 2 },
	{ id = "spring", name = "Spring", blurb = "Boing. Tilt it to launch sideways.", kind = "route", size = Vector2.new(3, 2), weight = 2 },
	{ id = "conveyor", name = "Conveyor", blurb = "Carries you along. Or into things.", kind = "route", size = Vector2.new(8, 1), weight = 2 },
	{ id = "mover", name = "Shuttle", blurb = "Slides back and forth on a rail.", kind = "route", size = Vector2.new(5, 1), weight = 2, travel = 10 },
	{ id = "ice", name = "Ice", blurb = "Slippery. Fast, if you're brave.", kind = "route", size = Vector2.new(8, 1), weight = 1 },
	{ id = "crumble", name = "Crumbly Ledge", blurb = "Falls apart right after you land.", kind = "route", size = Vector2.new(4, 1), weight = 1 },
	{ id = "decoy", name = "Trick Plank", blurb = "Looks like a plank. Isn't. (No nails.)", kind = "trap", size = Vector2.new(6, 1), weight = 1 },
	{ id = "honey", name = "Honey", blurb = "Sticky. Slow feet, weak jumps.", kind = "trap", size = Vector2.new(6, 1), weight = 1 },
	{ id = "spikes", name = "Spikes", blurb = "Don't.", kind = "trap", size = Vector2.new(4, 1), weight = 2 },
	{ id = "saw", name = "Buzzsaw", blurb = "Spins. Hurts.", kind = "trap", size = Vector2.new(5, 5), weight = 2 },
	{ id = "hammer", name = "Swing Hammer", blurb = "Knocks you flying. Timing matters.", kind = "trap", size = Vector2.new(2, 2), weight = 2 },
	{ id = "fan", name = "Fan", blurb = "Blows everyone the way it points.", kind = "trap", size = Vector2.new(3, 2), weight = 2 },
	{ id = "cannon", name = "Cannon", blurb = "Lobs slow cannonballs. Knockback.", kind = "trap", size = Vector2.new(3, 2), weight = 1 },
	{ id = "bomb", name = "Bomb", blurb = "Clears objects nearby. Fix a ruined level.", kind = "tool", size = Vector2.new(1, 1), weight = 1 },
} :: { Def }

Objects.ById = {} :: { [string]: Def }
for _, def in Objects.List do
	Objects.ById[def.id] = def
end

--------------------------------------------------------------------------
-- Geometry helpers
--------------------------------------------------------------------------

function Objects.footprint(def: Def, rot: number): Vector2
	local w = def.size.X + (def.travel or 0)
	local h = def.size.Y
	if rot % 180 ~= 0 then
		return Vector2.new(h, w)
	end
	return Vector2.new(w, h)
end

-- Snap so the footprint's edges land on whole studs (pieces line up flush)
function Objects.snap(def: Def, x: number, y: number, rot: number): (number, number)
	local fp = Objects.footprint(def, rot)
	local sx = math.floor(x - fp.X / 2 + 0.5) + fp.X / 2
	local sy = math.floor(y - fp.Y / 2 + 0.5) + fp.Y / 2
	return sx, sy
end

function Objects.cframe(x: number, y: number, rot: number): CFrame
	return CFrame.new(x, y, 0) * CFrame.Angles(0, 0, math.rad(rot))
end

-- Shared by the client ghost (red/green) and the server (final say).
function Objects.check(def: Def, x: number, y: number, rot: number): (boolean, string?)
	local level = workspace:FindFirstChild("Level")
	local objects = workspace:FindFirstChild("Objects")
	if not level then
		return false, "No level"
	end

	local fp = Objects.footprint(def, rot)
	local bmin = level:GetAttribute("BuildMin") :: Vector3?
	local bmax = level:GetAttribute("BuildMax") :: Vector3?
	if bmin and bmax then
		if x - fp.X / 2 < bmin.X or x + fp.X / 2 > bmax.X or y - fp.Y / 2 < bmin.Y or y + fp.Y / 2 > bmax.Y then
			return false, "Out of bounds"
		end
	end

	if def.id == "bomb" then
		return true, nil
	end

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = if objects then { level, objects } else { level }
	local hits = workspace:GetPartBoundsInBox(CFrame.new(x, y, 0), Vector3.new(fp.X - 0.15, fp.Y - 0.15, 3), params)
	if #hits > 0 then
		for _, hit in hits do
			if hit.Name == "SafeZone" then
				return false, "Too close to the start or flag"
			end
		end
		return false, "Something's in the way"
	end
	return true, nil
end

--------------------------------------------------------------------------
-- Model building
--------------------------------------------------------------------------

local function add(model: Model, name: string, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function solid(p: Part): Part
	p.CanCollide = true
	p.CanQuery = true
	p.CanTouch = true
	p:SetAttribute("Solid", true)
	return p
end

local function deadly(model: Model, size: Vector3, cf: CFrame, shape: Enum.PartType?): Part
	local p = add(model, "Hitbox", size, cf, O.Danger, shape)
	p.Transparency = 1
	p.CanTouch = true
	p.CanQuery = true
	p:SetAttribute("Deadly", true)
	return p
end

local function ellipsoid(model: Model, name: string, size: Vector3, cf: CFrame, color: Color3): Part
	local p = add(model, name, size, cf, color)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local FACE_CAMERA = CFrame.Angles(0, math.pi / 2, 0) -- cylinder axis X -> Z

local builders: { [string]: (Model) -> () } = {}

local function plankBody(m: Model, withNails: boolean)
	solid(add(m, "Board", Vector3.new(6, 1, DEPTH), CFrame.identity, F.Wood))
	add(m, "Trim", Vector3.new(6.02, 0.22, DEPTH + 0.02), CFrame.new(0, -0.4, 0), F.WoodDark)
	if withNails then
		for _, x in { -2.3, 2.3 } do
			add(m, "Nail", Vector3.new(0.28, 0.28, 0.06), CFrame.new(x, 0.12, FRONT), F.WoodDark)
		end
	end
end

builders.plank = function(m)
	plankBody(m, true)
end

builders.decoy = function(m)
	plankBody(m, false)
	for _, p in m:GetChildren() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p:SetAttribute("Solid", nil)
		end
	end
end

builders.crate = function(m)
	solid(add(m, "Box", Vector3.new(3, 3, DEPTH), CFrame.identity, F.Wood))
	local t = 0.36
	add(m, "Trim", Vector3.new(3, t, 0.06), CFrame.new(0, 1.5 - t / 2, FRONT), F.WoodDark)
	add(m, "Trim", Vector3.new(3, t, 0.06), CFrame.new(0, -1.5 + t / 2, FRONT), F.WoodDark)
	add(m, "Trim", Vector3.new(t, 3, 0.06), CFrame.new(1.5 - t / 2, 0, FRONT), F.WoodDark)
	add(m, "Trim", Vector3.new(t, 3, 0.06), CFrame.new(-1.5 + t / 2, 0, FRONT), F.WoodDark)
	add(m, "Trim", Vector3.new(t, 3.1, 0.05), CFrame.new(0, 0, FRONT) * CFrame.Angles(0, 0, math.rad(45)), F.WoodDark)
end

builders.spring = function(m)
	solid(add(m, "Base", Vector3.new(3, 0.5, 3), CFrame.new(0, -0.75, 0), O.Metal))
	for i = 0, 2 do
		add(m, "Coil", Vector3.new(0.16, 1.5, 1.5), CFrame.new(0, -0.35 + i * 0.32, 0) * CFrame.Angles(0, 0, math.pi / 2), O.MetalLight, Enum.PartType.Cylinder)
	end
	local pad = solid(add(m, "Pad", Vector3.new(3, 0.4, 3), CFrame.new(0, 0.6, 0), O.Spring))
	pad:SetAttribute("Group", "pad")
end

builders.conveyor = function(m)
	local belt = solid(add(m, "Belt", Vector3.new(8, 1, DEPTH), CFrame.identity, O.Rubber))
	belt:SetAttribute("Conveyor", true)
	for _, x in { -4, 4 } do
		add(m, "Roller", Vector3.new(DEPTH + 0.1, 1.1, 1.1), CFrame.new(x, 0, 0) * FACE_CAMERA, O.MetalLight, Enum.PartType.Cylinder)
	end
	for _, x in { -2.2, 0, 2.2 } do
		add(m, "Chevron", Vector3.new(0.8, 0.16, 0.05), CFrame.new(x, 0.17, FRONT) * CFrame.Angles(0, 0, math.rad(-38)), O.Stripe)
		add(m, "Chevron", Vector3.new(0.8, 0.16, 0.05), CFrame.new(x, -0.17, FRONT) * CFrame.Angles(0, 0, math.rad(38)), O.Stripe)
	end
end

builders.mover = function(m)
	local travel = (Objects.ById.mover.travel :: number) + 5
	add(m, "Rail", Vector3.new(travel, 0.3, 0.3), CFrame.new(0, 0, -1.6), O.Rubber)
	for _, x in { -travel / 2, travel / 2 } do
		add(m, "RailEnd", Vector3.new(0.7, 0.7, 0.7), CFrame.new(x, 0, -1.6), O.Metal, Enum.PartType.Ball)
	end
	local deck = solid(add(m, "Deck", Vector3.new(5, 1, DEPTH), CFrame.identity, F.Wood))
	deck:SetAttribute("Group", "mover")
	for _, x in { -2.35, 2.35 } do
		local cap = add(m, "Cap", Vector3.new(0.4, 1.06, DEPTH + 0.06), CFrame.new(x, 0, 0), O.MetalLight)
		cap:SetAttribute("Group", "mover")
	end
end

builders.ice = function(m)
	local slab = solid(add(m, "Slab", Vector3.new(8, 1, DEPTH), CFrame.identity, O.Ice))
	slab:SetAttribute("Surface", "ice")
	for _, x in { -2.6, -2.1, 1.8 } do
		add(m, "Shine", Vector3.new(0.14, 0.7, 0.05), CFrame.new(x, 0, FRONT) * CFrame.Angles(0, 0, math.rad(-30)), Color3.new(1, 1, 1))
	end
end

builders.crumble = function(m)
	local slab = solid(add(m, "Slab", Vector3.new(4, 1, DEPTH), CFrame.identity, O.Crumble))
	slab:SetAttribute("Crumble", true)
	add(m, "Crack", Vector3.new(0.1, 0.8, 0.05), CFrame.new(-0.7, 0, FRONT) * CFrame.Angles(0, 0, math.rad(20)), F.WoodDark)
	add(m, "Crack", Vector3.new(0.1, 0.5, 0.05), CFrame.new(0.9, 0.15, FRONT) * CFrame.Angles(0, 0, math.rad(-35)), F.WoodDark)
end

builders.honey = function(m)
	local slab = solid(add(m, "Slab", Vector3.new(6, 0.8, DEPTH), CFrame.new(0, -0.1, 0), O.Honey))
	slab:SetAttribute("Surface", "honey")
	ellipsoid(m, "Top", Vector3.new(6.2, 0.5, DEPTH + 0.2), CFrame.new(0, 0.25, 0), O.Honey)
	for _, x in { -2.1, 0.4, 2.3 } do
		ellipsoid(m, "Drip", Vector3.new(0.5, 0.9, 0.5), CFrame.new(x, -0.6, 1.4), O.Honey)
	end
end

builders.spikes = function(m)
	solid(add(m, "Base", Vector3.new(4, 0.4, DEPTH), CFrame.new(0, -0.3, 0), O.Metal))
	add(m, "Band", Vector3.new(4.02, 0.12, 0.05), CFrame.new(0, -0.3, FRONT), O.Danger)
	for _, x in { -1.5, -0.5, 0.5, 1.5 } do
		add(m, "Spike", Vector3.new(0.85, 0.85, DEPTH - 0.4), CFrame.new(x, -0.1, 0) * CFrame.Angles(0, 0, math.rad(45)), O.MetalLight)
	end
	-- Slightly smaller than the art: forgiving hitboxes feel fair
	deadly(m, Vector3.new(3.6, 0.7, 3), CFrame.new(0, 0.05, 0))
end

builders.saw = function(m)
	local blade = add(m, "Blade", Vector3.new(0.4, 5, 5), FACE_CAMERA, O.MetalLight, Enum.PartType.Cylinder)
	blade:SetAttribute("Group", "spin")
	for i = 0, 7 do
		local a = i * math.pi / 4
		local tooth = add(m, "Tooth", Vector3.new(0.7, 0.7, 0.3), CFrame.Angles(0, 0, a) * CFrame.new(0, 2.45, 0) * CFrame.Angles(0, 0, math.rad(45)), O.Metal)
		tooth:SetAttribute("Group", "spin")
	end
	local hub = add(m, "Hub", Vector3.new(0.7, 1.4, 1.4), FACE_CAMERA, O.Danger, Enum.PartType.Cylinder)
	hub:SetAttribute("Group", "spin")
	deadly(m, Vector3.new(4.4, 4.4, 4.4), CFrame.identity, Enum.PartType.Ball)
end

builders.hammer = function(m)
	solid(add(m, "Mount", Vector3.new(2, 2, 3), CFrame.identity, O.Metal))
	add(m, "Bolt", Vector3.new(0.3, 0.8, 0.8), CFrame.new(0, 0, 1.9) * FACE_CAMERA, O.MetalLight, Enum.PartType.Cylinder)
	local arm = add(m, "Arm", Vector3.new(0.5, 7, 0.5), CFrame.new(0, -3.5, 1.8), F.WoodDark)
	arm:SetAttribute("Group", "arm")
	local head = add(m, "Head", Vector3.new(3.2, 2, 2.2), CFrame.new(0, -7.5, 1.8), O.Metal)
	head:SetAttribute("Group", "arm")
	local band = add(m, "Band", Vector3.new(0.5, 2.06, 2.26), CFrame.new(0, -7.5, 1.8), O.Danger)
	band:SetAttribute("Group", "arm")
end

builders.fan = function(m)
	solid(add(m, "Housing", Vector3.new(3, 1.2, 3), CFrame.new(0, -0.4, 0), O.Metal))
	add(m, "Grill", Vector3.new(3.02, 0.14, 0.05), CFrame.new(0, -0.4, 1.52), O.MetalLight)
	for i = 0, 2 do
		local blade = add(m, "Blade", Vector3.new(2.6, 0.12, 0.5), CFrame.new(0, 0.35, 0) * CFrame.Angles(0, i * math.pi / 3, 0), O.MetalLight)
		blade:SetAttribute("Group", "fan")
	end
	-- Faint column so players can always see the wind's reach
	local zone = add(m, "Zone", Vector3.new(3, 16, 0.1), CFrame.new(0, 8.5, -1.8), Color3.new(1, 1, 1))
	zone.Transparency = 0.9
	zone.CastShadow = false
	for i = 1, 3 do
		local s = add(m, "Wind", Vector3.new(0.1, 1.8, 0.1), CFrame.new(-1 + (i - 1), 2 + i * 4, 0.5), Color3.new(1, 1, 1))
		s.Transparency = 0.5
		s.CastShadow = false
		s:SetAttribute("Group", "wind")
	end
end

builders.cannon = function(m)
	solid(add(m, "Base", Vector3.new(3, 0.8, 3), CFrame.new(0, -0.6, 0), F.WoodDark))
	solid(add(m, "Barrel", Vector3.new(2.8, 1.4, 1.4), CFrame.new(0.3, 0.3, 0), O.Rubber, Enum.PartType.Cylinder))
	add(m, "Lip", Vector3.new(0.3, 1.7, 1.7), CFrame.new(1.65, 0.3, 0), O.Metal, Enum.PartType.Cylinder)
	for _, x in { -0.8, 0.8 } do
		add(m, "Wheel", Vector3.new(0.35, 1.2, 1.2), CFrame.new(x, -0.7, 1.7) * FACE_CAMERA, F.Wood, Enum.PartType.Cylinder)
	end
end

builders.bomb = function(m)
	add(m, "Ball", Vector3.new(1.6, 1.6, 1.6), CFrame.identity, O.Rubber, Enum.PartType.Ball)
	add(m, "Fuse", Vector3.new(0.2, 0.6, 0.2), CFrame.new(0.3, 0.9, 0) * CFrame.Angles(0, 0, math.rad(-25)), F.WoodDark)
	local r = Config.Objects.BombRadius * 2
	local ring = add(m, "Radius", Vector3.new(0.1, r, r), FACE_CAMERA, O.Danger, Enum.PartType.Cylinder)
	ring.Transparency = 0.8
	ring.CastShadow = false
end

function Objects.build(id: string): Model
	local m = Instance.new("Model")
	m.Name = id
	builders[id](m)
	m.WorldPivot = CFrame.identity
	m:SetAttribute("Id", id)
	return m
end

return Objects
]]></ProtectedString></Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX81143F5C64774E1D936F9C6995992C3A">
        <Properties><string name="Name">Style</string><ProtectedString name="Source"><![CDATA[--!strict
-- One palette for UI and world. Flat colors, no gradients, no neon.

local Style = {}

Style.UI = {
	Ink = Color3.fromRGB(34, 31, 43),
	InkSoft = Color3.fromRGB(58, 54, 70),
	Paper = Color3.fromRGB(250, 246, 238),
	PaperShade = Color3.fromRGB(232, 225, 212),
	Muted = Color3.fromRGB(128, 120, 132),
	Accent = Color3.fromRGB(238, 108, 77),
	Good = Color3.fromRGB(82, 170, 110),
	Bad = Color3.fromRGB(214, 76, 76),
	Gold = Color3.fromRGB(240, 184, 72),
}

Style.Font = {
	Title = Font.fromEnum(Enum.Font.FredokaOne),
	Body = Font.fromEnum(Enum.Font.BuilderSansMedium),
	Bold = Font.fromEnum(Enum.Font.BuilderSansBold),
}

Style.Forest = {
	Grass = Color3.fromRGB(118, 176, 86),
	GrassDark = Color3.fromRGB(92, 150, 72),
	Dirt = Color3.fromRGB(141, 101, 70),
	DirtDark = Color3.fromRGB(112, 80, 58),
	Wood = Color3.fromRGB(196, 146, 96),
	WoodDark = Color3.fromRGB(150, 106, 68),
	Bark = Color3.fromRGB(112, 82, 60),
	Leaf = { Color3.fromRGB(86, 146, 78), Color3.fromRGB(70, 126, 74), Color3.fromRGB(108, 162, 88) },
	Stone = Color3.fromRGB(150, 150, 140),
	Water = Color3.fromRGB(96, 168, 196),
	Hill = Color3.fromRGB(128, 168, 132),
	HillFar = Color3.fromRGB(160, 190, 176),
	Cloud = Color3.fromRGB(252, 250, 246),
}

-- Shared materials for placed objects so they read as one family
Style.Object = {
	Metal = Color3.fromRGB(96, 100, 112),
	MetalLight = Color3.fromRGB(176, 180, 190),
	Danger = Color3.fromRGB(214, 76, 76),
	Spring = Color3.fromRGB(238, 108, 77),
	Honey = Color3.fromRGB(232, 162, 48),
	Ice = Color3.fromRGB(186, 226, 238),
	Rubber = Color3.fromRGB(52, 50, 60),
	Stripe = Color3.fromRGB(240, 184, 72),
	Crumble = Color3.fromRGB(206, 178, 132),
}

return Style
]]></ProtectedString></Properties>
      </Item>
